# ============= Repository hygiene (ROUND2 3.txt §C) =============

# Compressed packages / generated binaries / test output
*.zip
*.bak
*.trx

# Build output at any depth
**/bin/
**/obj/

# Visual Studio / IDE state
.vs/

# Test output dirs
TestResults/
App_Data/

# Release / artifact subdirectories
artifacts/publish/
artifacts/production-publish/
artifacts/backups/
artifacts/logs/
artifacts/release/
artifacts/pdf-samples-round2/
artifacts/demo-screenshots/
artifacts/backup-abs-j10/
artifacts/pdf-samples/
artifacts/pdf-samples-live/
artifacts/live-screenshots-2a/

# E2E Playwright outputs + local browser install
artifacts/e2e/results/
artifacts/e2e/screenshots/
artifacts/e2e/traces/
artifacts/e2e/videos/
artifacts/e2e/.playwright-browsers/
artifacts/playwright-browsers/

# Fonts: Genuine font TTFs and the OFL.txt license are explicitly tracked
# in src/LivestockManager.Infrastructure/Resources/Fonts/. All other *.ttf
# files elsewhere remain ignored by the lack of a matching negation.
!src/LivestockManager.Infrastructure/Resources/Fonts/*.ttf
!src/LivestockManager.Infrastructure/Resources/Fonts/OFL.txt

# Secrets / sensitive / credential files
*.pfx
*.snk
appsettings.Production.json
