@model SupplierListViewModel
@using LivestockManager.Application.DTOs.Suppliers
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Suppliers";
    ViewData["PageIcon"] = "🏭";
    ViewData["PageSubtitle"] = "Manage your supplier database";
    ViewData["DockKey"] = "suppliers";
    ViewData["ActionLabel"] = "New";
    ViewData["ActionIcon"] = "＋";
    ViewData["ActionUrl"] = Url.Action("Create", "Suppliers");
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
    var list = Model.Items?.ToList() ?? new List<SupplierSummaryDto>();
}

<div class="mob-card">
    <div class="mob-card-title">🔎 Search & Filters</div>
    <form method="get" asp-action="MobileIndex">
        <div class="mob-field">
            <input type="text" name="search" value="@Model.SearchTerm" placeholder="Name, code, tax#, email…" />
        </div>
        <label class="mob-check" style="margin-bottom:0.9rem;">
            <input type="checkbox" name="onlyActive" value="true" @(Model.OnlyActive == true ? "checked" : "") />
            <span>Only active suppliers</span>
        </label>
        <div class="d-flex gap-2">
            <button type="submit" class="mob-btn primary" style="flex:1;justify-content:center;">🔍 Search</button>
            <a asp-action="MobileIndex" class="mob-btn" style="flex:1;justify-content:center;background:#f3f4f6;color:#374151;">✕ Clear</a>
        </div>
    </form>
</div>

<div class="mob-kpi-row">
    <div class="mob-kpi" style="--kpi-color:#2d6a4f;">
        <div class="k-label">Suppliers</div>
        <div class="k-value">@list.Count</div>
        <div class="k-caption">All records</div>
    </div>
    <div class="mob-kpi" style="--kpi-color:#00a896;">
        <div class="k-label">Active</div>
        <div class="k-value">@list.Count(x => x.IsActive)</div>
        <div class="k-caption">In good standing</div>
    </div>
</div>

<div class="mob-list-cards">
    @if (!list.Any())
    {
        <div class="mob-empty">No suppliers found. Tap ＋ New to add your first supplier.</div>
    }
    else
    {
        @foreach (var s in list)
        {
            <div class="mob-list-card">
                <div class="row-top">
                    <div>
                        <code>@s.Code</code>
                        <div class="pill-stack">
                            @if (s.IsActive)
                            { <span class="pill ok">Active</span> }
                            else
                            { <span class="pill idle">Archived</span> }
                        </div>
                    </div>
                </div>
                <div class="body-copy" style="font-weight:700;color:var(--ink-900);">@s.Name</div>
                <div class="rows">
                    <div class="cell">
                        <div class="label">Phone</div>
                        <div class="val">@(string.IsNullOrWhiteSpace(s.Phone) ? "—" : s.Phone)</div>
                    </div>
                    <div class="cell">
                        <div class="label">Terms</div>
                        <div class="val">@(s.PaymentTermsDays.HasValue ? s.PaymentTermsDays.Value + "d" : "—")</div>
                    </div>
                    <div class="cell">
                        <div class="label">Tax #</div>
                        <div class="val">@(string.IsNullOrWhiteSpace(s.TaxNumber) ? "—" : s.TaxNumber)</div>
                    </div>
                    <div class="cell">
                        <div class="label">Email</div>
                        <div class="val">@(string.IsNullOrWhiteSpace(s.Email) ? "—" : s.Email)</div>
                    </div>
                </div>
                <div class="row-actions">
                    <a asp-action="Details" asp-route-id="@s.Id" class="mob-btn">👁 View</a>
                    @if (canEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@s.Id" class="mob-btn primary">✏️ Edit</a>
                    }
                </div>
            </div>
        }
    }
</div>
