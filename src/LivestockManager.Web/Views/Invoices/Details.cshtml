@model LivestockManager.Application.DTOs.Invoices.InvoiceDetailDto
@{
    ViewData["Title"] = "Invoice Details";
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
    var payments = ViewData["Payments"] as System.Collections.IEnumerable;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">
            @switch (Model.Status)
            {
                case InvoiceStatus.Draft:
                    <span class="badge bg-light text-dark border me-2">Draft</span>
                    break;
                case InvoiceStatus.Confirmed:
                    <span class="badge bg-info me-2">Confirmed</span>
                    break;
                case InvoiceStatus.Unpaid:
                    <span class="badge bg-warning text-dark me-2">Unpaid</span>
                    break;
                case InvoiceStatus.PartiallyPaid:
                    <span class="badge bg-primary me-2">Partially Paid</span>
                    break;
                case InvoiceStatus.Paid:
                    <span class="badge bg-success me-2">Paid</span>
                    break;
                case InvoiceStatus.Overdue:
                    <span class="badge bg-danger me-2">Overdue</span>
                    break;
                case InvoiceStatus.Voided:
                    <span class="badge bg-secondary me-2">Voided</span>
                    break;
                default:
                    <span class="badge bg-secondary me-2">@Model.Status</span>
                    break;
            }
            Invoice @Model.InvoiceNumber
        </h1>
        <div class="text-muted small">
            Issued @Model.InvoiceDate.ToString("yyyy-MM-dd") · Due @Model.DueDate.ToString("yyyy-MM-dd")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">← List</a>
        @if (canEdit && Model.Status == InvoiceStatus.Draft)
        {
            <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success" onclick="return confirm('Confirm this invoice?');">✅ Confirm</button>
            </form>
        }
        @if (canEdit && Model.Status != InvoiceStatus.Cancelled && Model.Status != InvoiceStatus.Voided)
        {
            <a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-outline-primary" target="_blank">📄 Download PDF</a>
        }
        @if (canEdit && Model.Status != InvoiceStatus.Cancelled && Model.Status != InvoiceStatus.Voided && Model.Status != InvoiceStatus.Paid)
        {
            <a asp-controller="Payments" asp-action="Create" asp-route-invoiceId="@Model.Id" class="btn btn-primary">💵 Record Payment</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom"><h6 class="mb-0 fw-bold">👥 Bill To</h6></div>
            <div class="card-body">
                <div class="fw-semibold mb-1">@Model.CustomerName</div>
                <div class="text-muted small">Customer ID: @Model.CustomerId</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom"><h6 class="mb-0 fw-bold">📅 Dates</h6></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted fw-semibold">Issued</dt>
                    <dd class="col-sm-7">@Model.InvoiceDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-5 text-muted fw-semibold">Due</dt>
                    <dd class="col-sm-7">@Model.DueDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-5 text-muted fw-semibold">Currency</dt>
                    <dd class="col-sm-7">@Model.Currency</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom"><h6 class="mb-0 fw-bold">💰 Amounts</h6></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-6 text-muted fw-semibold">Grand Total</dt>
                    <dd class="col-sm-6 text-end fw-semibold">$@Model.GrandTotal.ToString("F2")</dd>
                    <dt class="col-sm-6 text-muted fw-semibold">Paid</dt>
                    <dd class="col-sm-6 text-end text-success fw-semibold">$@Model.PaidAmount.ToString("F2")</dd>
                    <hr class="my-1" />
                    <dt class="col-sm-6 fw-bold">Outstanding</dt>
                    <dd class="col-sm-6 text-end fw-bold @(Model.OutstandingAmount > 0 ? "text-warning" : "text-success")">$@Model.OutstandingAmount.ToString("F2")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-transparent border-bottom"><h6 class="mb-0 fw-bold">📋 Line Items (@Model.Items.Count)</h6></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Description</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Discount</th>
                        <th class="text-end">Tax</th>
                        <th class="text-end">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (it, idx) in Model.Items.Select((x, i) => (x, i)))
                    {
                        <tr>
                            <td>@(idx + 1)</td>
                            <td>@it.Description</td>
                            <td class="text-end">@it.Quantity</td>
                            <td class="text-end">$@it.UnitPrice.ToString("F2")</td>
                            <td class="text-end">$@it.DiscountAmount.ToString("F2")</td>
                            <td class="text-end">$@it.TaxAmount.ToString("F2")</td>
                            <td class="text-end fw-semibold">$@it.LineTotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="6" class="text-end fw-semibold">Subtotal</td>
                        <td class="text-end">$@Model.Subtotal.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td colspan="6" class="text-end fw-semibold">Discount</td>
                        <td class="text-end">- $@Model.DiscountTotal.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td colspan="6" class="text-end fw-semibold">Tax</td>
                        <td class="text-end">+ $@Model.TaxTotal.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td colspan="6" class="text-end fw-bold fs-5">Grand Total</td>
                        <td class="text-end fw-bold fs-5">$@Model.GrandTotal.ToString("F2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">💵 Payments Received</h6>
        @if (canEdit && Model.Status != InvoiceStatus.Cancelled && Model.Status != InvoiceStatus.Voided && Model.Status != InvoiceStatus.Paid)
        {
            <a asp-controller="Payments" asp-action="Create" asp-route-invoiceId="@Model.Id" class="btn btn-sm btn-primary">+ Record Payment</a>
        }
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Method</th>
                        <th>Reference</th>
                        <th class="text-end">Amount</th>
                        <th>Notes</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (payments != null)
                    {
                        @foreach (var p in (IEnumerable<dynamic>)payments)
                        {
                            <tr>
                                <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td>@p.Method</td>
                                <td><code>@p.Reference</code></td>
                                <td class="text-end fw-semibold text-success">$@p.Amount.ToString("F2")</td>
                                <td class="small">@p.Notes</td>
                                <td class="text-end"><a asp-controller="Payments" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted small">No payments recorded yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
