@model IEnumerable<LivestockManager.Application.DTOs.Invoices.InvoiceSummaryDto>
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Invoices";
    ViewData["PageIcon"] = "📄";
    ViewData["PageSubtitle"] = "Billing and receivables";
    ViewData["DockKey"] = "invoices";
    ViewData["ActionLabel"] = "From Sale";
    ViewData["ActionIcon"] = "＋";
    ViewData["ActionUrl"] = Url.Action("MobileCreate", "Sales");
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
    var customers = ViewData["Customers"] as System.Collections.IEnumerable;
    var selCustomerId = ViewData["CustomerId"] as Guid?;
    var selStatus = ViewData["Status"] as InvoiceStatus?;
    var fromStr = ViewData["From"] as string;
    var toStr = ViewData["To"] as string;
    var list = Model?.ToList() ?? new List<LivestockManager.Application.DTOs.Invoices.InvoiceSummaryDto>();
    var total = list.Sum(x => x.GrandTotal);
    var outstanding = list.Sum(x => x.OutstandingAmount);
}

<div class="mob-totals-card @(outstanding > 0 ? "" : "")">
    <div class="label">Invoices</div>
    <div class="total">$@total.ToString("N2")</div>
    <div class="breakdown">
        <div><div class="k">Records</div><div class="v">@list.Count</div></div>
        <div><div class="k">Outstanding</div><div class="v">$@outstanding.ToString("N2")</div></div>
    </div>
</div>

<div class="mob-card" style="margin-bottom:0.75rem;">
    <div class="mob-card-title">🔎 Filters</div>
    <form asp-action="MobileIndex" method="get">
        <div class="f-row">
            <div class="g ps">
                <div class="mob-field">
                    <label>From</label>
                    <input type="date" name="from" value="@fromStr" />
                </div>
            </div>
            <div class="g pe">
                <div class="mob-field">
                    <label>To</label>
                    <input type="date" name="to" value="@toStr" />
                </div>
            </div>
        </div>
        <div class="f-row">
            <div class="g ps">
                <div class="mob-field">
                    <label>Customer</label>
                    <select name="customerId">
                        <option value="">All</option>
                        @if (customers != null)
                        {
                            @foreach (var c in (IEnumerable<dynamic>)customers)
                            {
                                Guid cid = c.Id;
                                if (selCustomerId == cid)
                                { <option value="@c.Id" selected>@c.Name</option> }
                                else
                                { <option value="@c.Id">@c.Name</option> }
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="g pe">
                <div class="mob-field">
                    <label>Status</label>
                    <select name="status">
                        <option value="">Any</option>
                        @foreach (var s in Enum.GetValues<InvoiceStatus>())
                        {
                            if (selStatus == s)
                            { <option value="@((int)s)" selected>@s</option> }
                            else
                            { <option value="@((int)s)">@s</option> }
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="mob-btn primary" style="flex:1;justify-content:center;">🔍 Apply</button>
            <a asp-action="MobileIndex" class="mob-btn" style="flex:1;justify-content:center;background:#f3f4f6;color:#374151;">✕ Clear</a>
        </div>
    </form>
</div>

<div class="mob-list-cards">
    @if (!list.Any())
    {
        <div class="mob-empty">No invoices found for these filters.</div>
    }
    else
    {
        @foreach (var i in list)
        {
            var statusPill = i.Status switch
            {
                InvoiceStatus.Draft => ("Draft", "idle"),
                InvoiceStatus.Confirmed => ("Confirmed", "info"),
                InvoiceStatus.Unpaid => ("Unpaid", "warn"),
                InvoiceStatus.PartiallyPaid => ("Partial", "info"),
                InvoiceStatus.Paid => ("Paid", "ok"),
                InvoiceStatus.Overdue => ("Overdue", "bad"),
                InvoiceStatus.Voided => ("Voided", "bad"),
                _ => (i.Status.ToString(), "idle")
            };
            <div class="mob-list-card">
                <div class="row-top">
                    <div>
                        <code>@i.InvoiceNumber</code>
                        <div class="pill-stack">
                            <span class="pill @statusPill.Item2">@statusPill.Item1</span>
                        </div>
                    </div>
                    <div class="val-right">
                        <div class="amt">$@i.GrandTotal.ToString("F2")</div>
                        <div class="sub">@i.InvoiceDate.ToString("yyyy-MM-dd")</div>
                    </div>
                </div>
                <div class="body-copy" style="font-weight:700;color:var(--ink-900);">@i.CustomerName</div>
                <div class="rows rows-3col">
                    <div class="cell">
                        <div class="label">Due</div>
                        <div class="val">@i.DueDate.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="cell">
                        <div class="label">Paid</div>
                        <div class="val" style="color:#007d73;">$@i.PaidAmount.ToString("F2")</div>
                    </div>
                    <div class="cell">
                        <div class="label">Outstanding</div>
                        <div class="val" style="color:#b45309;">$@i.OutstandingAmount.ToString("F2")</div>
                    </div>
                </div>
                <div class="row-actions">
                    <a asp-action="Details" asp-route-id="@i.Id" class="mob-btn">👁 View</a>
                    @if (canEdit && i.Status != InvoiceStatus.Cancelled && i.Status != InvoiceStatus.Voided)
                    {
                        <a asp-action="DownloadPdf" asp-route-id="@i.Id" target="_blank" class="mob-btn">⬇ PDF</a>
                    }
                </div>
            </div>
        }
    }
</div>
