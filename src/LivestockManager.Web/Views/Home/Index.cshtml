@model LivestockManager.Application.DTOs.Dashboard.DashboardKpisDto
@using LivestockManager.Application.DTOs.Livestock
@using LivestockManager.Application.DTOs.Invoices
@using LivestockManager.Domain.Enums
@using LivestockManager.Domain.Helpers
@{
    ViewData["Title"] = "Dashboard";
    var recentLivestock = ViewData["RecentLivestock"] as IEnumerable<LivestockSummaryDto>;
    var recentInvoices = ViewData["RecentInvoices"] as IEnumerable<InvoiceSummaryDto>;
}

<div class="page-title-row">
    <div>
        <h1 class="page-title">📊 Dashboard</h1>
        <div class="text-muted small">@Model.CompanyName · Today is @Model.TodayUtc.LocalDateTime.ToString("dddd, MMMM d, yyyy")</div>
    </div>
</div>

<h5 class="mb-2 text-muted small text-uppercase fw-bold border-bottom pb-1">Operational</h5>
<div class="row g-3 mb-4 kpi-row-wrap">
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #2d6a4f;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(45,106,79,0.1);">
                        <span class="fs-4" style="color: #2d6a4f;">🐑</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Active</h6>
                        <h3 class="mb-0 fw-bold text-dark">@Model.ActiveLivestockCount.ToString("N0")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Live inventory headcount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #40916c;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(64,145,108,0.1);">
                        <span class="fs-4" style="color: #40916c;">📝</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">New Reg</h6>
                        <h3 class="mb-0 fw-bold text-dark">@Model.NewRegistrationsThisMonth.ToString("N0")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Registrations this month</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #e76f51;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(231,111,81,0.1);">
                        <span class="fs-4" style="color: #e76f51;">🚚</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Dis-Tdy</h6>
                        <h3 class="mb-0 fw-bold text-dark">@Model.DischargesToday.ToString("N0")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Discharges today (UTC)</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #e9c46a;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(233,196,106,0.1);">
                        <span class="fs-4" style="color: #e9c46a;">⚖️</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">ADG-Kg</h6>
                        <h3 class="mb-0 fw-bold text-dark">@(Model.AverageDailyWeightGainKgCurrentMonth.HasValue ? Model.AverageDailyWeightGainKgCurrentMonth.Value.ToString("F3") : "—")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Avg daily gain current mo</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #d00000;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(208,0,0,0.1);">
                        <span class="fs-4" style="color: #d00000;">💀</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Mort-30</h6>
                        <h3 class="mb-0 fw-bold text-dark">@(Model.LivestockMortalityRate30dPct.HasValue ? Model.LivestockMortalityRate30dPct.Value.ToString("F1") + "%" : "—")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Mortality rate last 30d</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #457b9d;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(69,123,157,0.1);">
                        <span class="fs-4" style="color: #457b9d;">📋</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Pending</h6>
                        <h3 class="mb-0 fw-bold text-dark">@Model.PendingWeighingsCount.ToString("N0")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Weighings due &gt;7d old</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #1d3557;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(29,53,87,0.1);">
                        <span class="fs-4" style="color: #1d3557;">🏭</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Active</h6>
                        <h3 class="mb-0 fw-bold text-dark">@Model.FarmsActive.ToString("N0")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Operating farms</div>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-2 text-muted small text-uppercase fw-bold border-bottom pb-1">Commercial</h5>
<div class="row g-3 mb-4 kpi-row-wrap">
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #2a9d8f;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(42,157,143,0.1);">
                        <span class="fs-4" style="color: #2a9d8f;">💰</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Rev MTD</h6>
                        <h3 class="mb-0 fw-bold text-dark">$@Model.RevenueMonthToDate.ToString("N2")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Invoices month to date</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #52b788;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(82,183,136,0.1);">
                        <span class="fs-4" style="color: #52b788;">💵</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Paid MTD</h6>
                        <h3 class="mb-0 fw-bold text-dark">$@Model.PaidReceiptsMonthToDate.ToString("N2")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Receipts collected MTD</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #9b5de5;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(155,93,229,0.1);">
                        <span class="fs-4" style="color: #9b5de5;">📑</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Out AR</h6>
                        <h3 class="mb-0 fw-bold text-dark">$@Model.OutstandingInvoicesAmountTotal.ToString("N2")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Total AR outstanding</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #f15bb5;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(241,91,181,0.1);">
                        <span class="fs-4" style="color: #f15bb5;">⏰</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Overdue</h6>
                        <h3 class="mb-0 fw-bold text-dark">$@Model.OverdueInvoicesAmountTotal.ToString("N2")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Past due invoices</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #00bbf9;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(0,187,249,0.1);">
                        <span class="fs-4" style="color: #00bbf9;">📥</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Purch MTD</h6>
                        <h3 class="mb-0 fw-bold text-dark">$@Model.PurchasesMonthToDateAmount.ToString("N2")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Posted purchases MTD</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #f77f00;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(247,127,0,0.1);">
                        <span class="fs-4" style="color: #f77f00;">📤</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Exp MTD</h6>
                        <h3 class="mb-0 fw-bold text-dark">$@Model.ExpensesMonthToDateAmount.ToString("N2")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Expenses month to date</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card kpi-card kpi-mobile-card h-100 border-0" style="border-left-color: #00f5d4;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background-color: rgba(0,245,212,0.1);">
                        <span class="fs-4" style="color: #00f5d4;">🧮</span>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Net OR</h6>
                        <h3 class="mb-0 fw-bold @(Model.NetOperatingResultMonthToDate >= 0 ? "text-dark" : "text-danger")">@(Model.NetOperatingResultMonthToDate >= 0 ? "$" : "-$")@Math.Abs(Model.NetOperatingResultMonthToDate).ToString("N2")</h3>
                    </div>
                </div>
                <div class="mt-2 small text-muted">Net operating result MTD</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">🐑 Recent Livestock</h6>
                <a asp-controller="Livestock" asp-action="Index" class="small">View all →</a>
            </div>
            <div class="card-body p-0">
                @* Desktop Table View *@
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Weight</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentLivestock != null && recentLivestock.Any())
                            {
                                @foreach (var l in recentLivestock)
                                {
                                    <tr>
                                        <td><code>@l.LivestockId</code></td>
                                        <td>@LivestockTypeDisplay.GetDisplayName(l.LivestockTypeId)</td>
                                        <td>
                                            @if (l.Status == LivestockStatus.Active)
                                            { <span class="badge bg-success">Active</span> }
                                            else
                                            { <span class="badge bg-secondary">@l.Status</span> }
                                        </td>
                                        <td>
                                            @if (l.CurrentWeight.HasValue)
                                            { @l.CurrentWeight.Value.ToString("F2") @l.WeightUnit }
                                            else
                                            { <span class="text-muted small">—</span> }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-3 text-muted small">No recent livestock.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @* Mobile Card List View *@
                <div class="d-md-none mobile-list-cards">
                    @if (recentLivestock != null && recentLivestock.Any())
                    {
                        @foreach (var l in recentLivestock)
                        {
                            <div class="mobile-list-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="text-muted small text-uppercase fw-semibold">Livestock ID</div>
                                        <code class="fs-6 fw-bold">@l.LivestockId</code>
                                    </div>
                                    @if (l.Status == LivestockStatus.Active)
                                    { <span class="badge bg-success">Active</span> }
                                    else
                                    { <span class="badge bg-secondary">@l.Status</span> }
                                </div>
                                <div class="d-flex justify-content-between align-items-center small">
                                    <div>
                                        <div class="text-muted">Type</div>
                                        <div class="fw-semibold">@LivestockTypeDisplay.GetDisplayName(l.LivestockTypeId)</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted">Weight</div>
                                        <div class="fw-semibold">
                                            @if (l.CurrentWeight.HasValue)
                                            { @l.CurrentWeight.Value.ToString("F2") @l.WeightUnit }
                                            else
                                            { <span class="text-muted">—</span> }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">No recent livestock.</div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">📄 Recent Invoices</h6>
                <a asp-controller="Invoices" asp-action="Index" class="small">View all →</a>
            </div>
            <div class="card-body p-0">
                @* Desktop Table View *@
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th class="text-end">Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentInvoices != null && recentInvoices.Any())
                            {
                                @foreach (var i in recentInvoices)
                                {
                                    <tr>
                                        <td><code>@i.InvoiceNumber</code></td>
                                        <td>@i.InvoiceDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end fw-semibold">$@i.GrandTotal.ToString("F2")</td>
                                        <td>
                                            @if (i.Status == InvoiceStatus.Paid)
                                            { <span class="badge bg-success">Paid</span> }
                                            else if (i.Status == InvoiceStatus.PartiallyPaid)
                                            { <span class="badge bg-primary">Partial</span> }
                                            else if (i.Status == InvoiceStatus.Draft)
                                            { <span class="badge bg-light text-dark border">Draft</span> }
                                            else if (i.Status == InvoiceStatus.Overdue)
                                            { <span class="badge bg-danger">Overdue</span> }
                                            else if (i.Status == InvoiceStatus.Confirmed)
                                            { <span class="badge bg-info">Confirmed</span> }
                                            else
                                            { <span class="badge bg-secondary">@i.Status</span> }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-3 text-muted small">No recent invoices.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @* Mobile Card List View *@
                <div class="d-md-none mobile-list-cards">
                    @if (recentInvoices != null && recentInvoices.Any())
                    {
                        @foreach (var i in recentInvoices)
                        {
                            var statusBadge = i.Status switch
                            {
                                InvoiceStatus.Paid => ("Paid", "bg-success"),
                                InvoiceStatus.PartiallyPaid => ("Partial", "bg-primary"),
                                InvoiceStatus.Draft => ("Draft", "bg-light text-dark border"),
                                InvoiceStatus.Overdue => ("Overdue", "bg-danger"),
                                InvoiceStatus.Confirmed => ("Confirmed", "bg-info"),
                                _ => (i.Status.ToString(), "bg-secondary")
                            };
                            <div class="mobile-list-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="text-muted small text-uppercase fw-semibold">Invoice #</div>
                                        <code class="fs-6 fw-bold">@i.InvoiceNumber</code>
                                    </div>
                                    <span class="badge @statusBadge.Item2">@statusBadge.Item1</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center small">
                                    <div>
                                        <div class="text-muted">Date</div>
                                        <div class="fw-semibold">@i.InvoiceDate.ToString("yyyy-MM-dd")</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted">Total</div>
                                        <div class="fw-bold fs-5 text-dark">$@i.GrandTotal.ToString("F2")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">No recent invoices.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
