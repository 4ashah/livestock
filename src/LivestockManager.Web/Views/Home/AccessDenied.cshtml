@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center min-vh-60 py-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body p-5">
                <div class="display-1 mb-4 text-warning">🚫</div>
                <h1 class="display-5 fw-bold mb-3" style="color: var(--primary);">Access Denied</h1>
                <p class="lead text-muted mb-4">
                    Sorry, you do not have permission to access this resource.
                </p>
                <p class="text-muted mb-4">
                    If you believe this is an error, please contact your system administrator to request the appropriate role or permissions.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house me-2"></i>Return to Dashboard
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
                        Sign in as Different User
                    </a>
                </div>
            </div>
            <div class="card-footer bg-white border-0 text-center pb-4">
                <small class="text-muted">
                    Need help? Contact your farm administrator.
                </small>
            </div>
        </div>
    </div>
</div>
