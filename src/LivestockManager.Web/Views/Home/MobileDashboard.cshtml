@model LivestockManager.Application.DTOs.Dashboard.DashboardKpisDto
@using LivestockManager.Application.DTOs.Livestock
@using LivestockManager.Application.DTOs.Invoices
@using LivestockManager.Domain.Enums
@using LivestockManager.Domain.Helpers
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["PageIcon"] = "📊";
    ViewData["PageSubtitle"] = Model.CompanyName + " · " + Model.TodayUtc.LocalDateTime.ToString("ddd, MMM d");
    ViewData["DockKey"] = "dashboard";
    var recentLivestock = ViewData["RecentLivestock"] as IEnumerable<LivestockSummaryDto>;
    var recentInvoices = ViewData["RecentInvoices"] as IEnumerable<InvoiceSummaryDto>;
}

<div style="margin-bottom:0.5rem;">
    <div class="mob-card-title">⚡ Quick Nav</div>
    <div class="quick-nav">
        <a asp-action="MobileRegister" asp-controller="Livestock" class="qbtn p">
            <span class="icn">🐑</span>
            <span>Register</span>
        </a>
        <a asp-action="MobileCreate" asp-controller="LivestockLosses" class="qbtn d">
            <span class="icn">💀</span>
            <span>Record Loss</span>
        </a>
        <a asp-action="MobileCreate" asp-controller="Expenses" class="qbtn w">
            <span class="icn">💰</span>
            <span>Expense</span>
        </a>
        <a asp-action="MobileCreate" asp-controller="Purchases" class="qbtn b">
            <span class="icn">🛒</span>
            <span>Purchase</span>
        </a>
    </div>
</div>

<div class="mob-kpi-row">
    <div class="mob-kpi" style="--kpi-color:#2d6a4f;">
        <div class="k-label">Active Herd</div>
        <div class="k-value">@Model.ActiveLivestockCount.ToString("N0")</div>
        <div class="k-caption">Live headcount</div>
    </div>
    <div class="mob-kpi" style="--kpi-color:#40916c;">
        <div class="k-label">New Reg MTD</div>
        <div class="k-value">@Model.NewRegistrationsThisMonth.ToString("N0")</div>
        <div class="k-caption">Registrations this month</div>
    </div>
</div>
<div class="mob-kpi-row">
    <div class="mob-kpi" style="--kpi-color:#c81d25;">
        <div class="k-label">Mort-30d</div>
        <div class="k-value">@(Model.LivestockMortalityRate30dPct.HasValue ? Model.LivestockMortalityRate30dPct.Value.ToString("F1") + "%" : "—")</div>
        <div class="k-caption">Mortality last 30d</div>
    </div>
    <div class="mob-kpi" style="--kpi-color:#3a6ea5;">
        <div class="k-label">Weigh Due</div>
        <div class="k-value">@Model.PendingWeighingsCount.ToString("N0")</div>
        <div class="k-caption">Weighings overdue</div>
    </div>
</div>

<div class="mob-kpi-row">
    <div class="mob-kpi" style="--kpi-color:#2a9d8f;">
        <div class="k-label">Revenue MTD</div>
        <div class="k-value">$@Model.RevenueMonthToDate.ToString("N0")</div>
        <div class="k-caption">Invoices MTD</div>
    </div>
    <div class="mob-kpi" style="--kpi-color:#00a896;">
        <div class="k-label">Paid MTD</div>
        <div class="k-value">$@Model.PaidReceiptsMonthToDate.ToString("N0")</div>
        <div class="k-caption">Receipts MTD</div>
    </div>
</div>
<div class="mob-kpi-row">
    <div class="mob-kpi" style="--kpi-color:#8e44ad;">
        <div class="k-label">Out AR</div>
        <div class="k-value">$@Model.OutstandingInvoicesAmountTotal.ToString("N0")</div>
        <div class="k-caption">Outstanding receivables</div>
    </div>
    <div class="mob-kpi" style="--kpi-color:#d97706;">
        <div class="k-label">Net OR MTD</div>
        <div class="k-value">@(Model.NetOperatingResultMonthToDate >= 0 ? "+" : "-")$@Math.Abs(Model.NetOperatingResultMonthToDate).ToString("N0")</div>
        <div class="k-caption">Operating result</div>
    </div>
</div>

<div class="mob-totals-card @(Model.NetOperatingResultMonthToDate < 0 ? " warn" : "")">
    <div class="label">Net Operating Result · MTD</div>
    <div class="total">@(Model.NetOperatingResultMonthToDate >= 0 ? "+" : "")$@Model.NetOperatingResultMonthToDate.ToString("N2")</div>
    <div class="breakdown">
        <div><div class="k">Rev MTD</div><div class="v">$@Model.RevenueMonthToDate.ToString("N0")</div></div>
        <div><div class="k">Paid MTD</div><div class="v">$@Model.PaidReceiptsMonthToDate.ToString("N0")</div></div>
        <div><div class="k">Out AR</div><div class="v">$@Model.OutstandingInvoicesAmountTotal.ToString("N0")</div></div>
        <div><div class="k">Active</div><div class="v">@Model.ActiveLivestockCount</div></div>
    </div>
</div>

<div class="mob-card">
    <div class="mob-card-title">
        <span>🕒 Recent Activity</span>
        <span id="recStockBadge" class="pill ok" style="cursor:pointer;" onclick="switchRecent('stock')">🐑 Livestock</span>
        <span id="recInvBadge" class="pill idle" style="cursor:pointer;" onclick="switchRecent('inv')">📄 Invoices</span>
    </div>

    <div id="recStock">
        @if (recentLivestock != null && recentLivestock.Any())
        {
            <div class="mob-list-cards">
                @foreach (var l in recentLivestock.Take(4))
                {
                    var pillClass = l.Status == LivestockStatus.Active ? "ok" : "idle";
                    var pillLabel = l.Status == LivestockStatus.Active ? "Active" : l.Status.ToString();
                    <div class="mob-list-card">
                        <div class="row-top">
                            <div>
                                <code>@l.LivestockId</code>
                                <div class="meta-caption">@LivestockTypeDisplay.GetDisplayName(l.LivestockTypeId) · @l.AcquisitionDate.ToString("MMM d")</div>
                            </div>
                            <span class="pill @pillClass">@pillLabel</span>
                        </div>
                        <div class="rows">
                            <div class="cell">
                                <div class="label">Weight</div>
                                <div class="val">
                                    @if (l.CurrentWeight.HasValue) { @l.CurrentWeight.Value.ToString("F1") @l.WeightUnit }
                                    else { <span class="code-muted">—</span> }
                                </div>
                            </div>
                            <div class="cell">
                                <div class="label">Purchased</div>
                                <div class="val">$@l.PurchaseAmount.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="row-actions">
                            <a asp-action="Details" asp-controller="Livestock" asp-route-id="@l.Id" class="mob-btn">👁 View</a>
                            @if (l.Status == LivestockStatus.Active)
                            {
                                <a asp-action="AddWeight" asp-controller="Livestock" asp-route-id="@l.Id" class="mob-btn primary">⚖ Weight</a>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="text-center">
                <a asp-action="MobileIndex" asp-controller="Livestock" class="mob-btn ghost">View all livestock →</a>
            </div>
        }
        else
        {
            <div class="mob-empty">No recent livestock.</div>
        }
    </div>

    <div id="recInv" style="display:none;">
        @if (recentInvoices != null && recentInvoices.Any())
        {
            <div class="mob-list-cards">
                @foreach (var i in recentInvoices.Take(4))
                {
                    var pill = i.Status switch
                    {
                        InvoiceStatus.Paid => ("Paid", "ok"),
                        InvoiceStatus.PartiallyPaid => ("Partial", "info"),
                        InvoiceStatus.Draft => ("Draft", "idle"),
                        InvoiceStatus.Overdue => ("Overdue", "bad"),
                        InvoiceStatus.Confirmed => ("Confirmed", "warn"),
                        _ => (i.Status.ToString(), "idle")
                    };
                    <div class="mob-list-card">
                        <div class="row-top">
                            <div>
                                <code>@i.InvoiceNumber</code>
                                <div class="meta-caption">@i.InvoiceDate.ToString("yyyy-MM-dd")</div>
                            </div>
                            <span class="pill @pill.Item2">@pill.Item1</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(i.CustomerName))
                        {
                            <div class="body-copy">👤 @i.CustomerName</div>
                        }
                        <div class="rows">
                            <div class="cell">
                                <div class="label">Total</div>
                                <div class="val big">$@i.GrandTotal.ToString("F2")</div>
                            </div>
                            <div class="cell">
                                <div class="label">Owed</div>
                                <div class="val">
                                    @(i.OutstandingAmount > 0 ? "$" + i.OutstandingAmount.ToString("F0") : "✓ Paid")
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center">
                <a asp-action="Index" asp-controller="Invoices" class="mob-btn ghost">View all invoices →</a>
            </div>
        }
        else
        {
            <div class="mob-empty">No recent invoices.</div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function switchRecent(tab) {
            var stock = document.getElementById('recStock');
            var inv = document.getElementById('recInv');
            var sb = document.getElementById('recStockBadge');
            var ib = document.getElementById('recInvBadge');
            if (tab === 'stock') {
                stock.style.display = 'block';
                inv.style.display = 'none';
                sb.className = 'pill ok';
                ib.className = 'pill idle';
            } else {
                stock.style.display = 'none';
                inv.style.display = 'block';
                ib.className = 'pill info';
                sb.className = 'pill idle';
            }
        }
    </script>
}
