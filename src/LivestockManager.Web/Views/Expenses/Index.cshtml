@model IEnumerable<LivestockManager.Application.DTOs.Expenses.ExpenseSummaryDto>
@using LivestockManager.Domain.Enums
@{
    ViewData["Title"] = "Expenses";
    var canEdit = ViewData["CanEdit"] is true;
    var fromStr = ViewData["From"] as string ?? string.Empty;
    var toStr = ViewData["To"] as string ?? string.Empty;
    var farmIdObj = ViewData["FarmId"];
    var supplierIdObj = ViewData["SupplierId"];
    var livestockIdObj = ViewData["LivestockId"];
    var categoryObj = ViewData["Category"];
    var farms = ViewData["Farms"] as IEnumerable<LivestockManager.Application.DTOs.Farms.FarmSummaryDto> ?? Enumerable.Empty<LivestockManager.Application.DTOs.Farms.FarmSummaryDto>();
    var suppliers = ViewData["Suppliers"] as IEnumerable<LivestockManager.Application.DTOs.Suppliers.SupplierSummaryDto> ?? Enumerable.Empty<LivestockManager.Application.DTOs.Suppliers.SupplierSummaryDto>();
    var categorySummary = ViewData["CategorySummary"] as IEnumerable<LivestockManager.Application.DTOs.Expenses.ExpenseCategorySummaryDto> ?? Enumerable.Empty<LivestockManager.Application.DTOs.Expenses.ExpenseCategorySummaryDto>();

    var list = Model.ToList();
    var totalAmount = list.Sum(x => x.Amount);
    var totalTax = list.Sum(x => x.TaxAmount);
    var grandTotal = list.Sum(x => x.Total);

    ExpenseCategory? catSel = null;
    if (categoryObj is ExpenseCategory cE) catSel = cE;
    int? categoryRoute = catSel.HasValue ? (int)catSel.Value : null;

    bool ModelHasErrors() => ViewContext.ModelState.ErrorCount > 0;
}

<div class="page-title-row">
    <div>
        <h1 class="page-title">🧾 Expenses</h1>
        <div class="text-muted small">Operating expenditure tracking</div>
    </div>
    <div class="actions">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-format="csv" asp-route-from="@fromStr" asp-route-to="@toStr" asp-route-farmId="@farmIdObj" asp-route-supplierId="@supplierIdObj" asp-route-livestockId="@livestockIdObj" asp-route-category="@categoryRoute">
            📥 Export CSV
        </a>
        @if (canEdit)
        {
            <a class="btn btn-danger" asp-action="Create">＋ New Expense</a>
        }
    </div>
</div>

@if (categorySummary.Any())
{
    <div class="row g-3 mb-4 kpi-row-wrap">
        @foreach (var grp in categorySummary)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <div class="card kpi-card h-100 border-0" style="border-left-color:#e76f51;">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small text-uppercase mb-1">@grp.Category</div>
                        <div class="fw-bold">$@grp.TotalWithTax.ToString("F2")</div>
                        <div class="text-muted small">@grp.ExpenseCount items</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small">From</label>
                <input type="date" class="form-control form-control-sm" name="from" value="@fromStr" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small">To</label>
                <input type="date" class="form-control form-control-sm" name="to" value="@toStr" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small">Farm</label>
                <select class="form-select form-select-sm" name="farmId">
                    <option value="">All farms</option>
                    @foreach (var f in farms)
                    {
                        if (farmIdObj != null && farmIdObj.ToString() == f.Id.ToString())
                        {
                            <option value="@f.Id" selected>@f.Name</option>
                        }
                        else
                        {
                            <option value="@f.Id">@f.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small">Category</label>
                <select class="form-select form-select-sm" name="category">
                    <option value="">All categories</option>
                    @foreach (ExpenseCategory ec in Enum.GetValues(typeof(ExpenseCategory)))
                    {
                        if (catSel == ec)
                        {
                            <option value="@((int)ec)" selected>@ec</option>
                        }
                        else
                        {
                            <option value="@((int)ec)">@ec</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small">Supplier</label>
                <select class="form-select form-select-sm" name="supplierId">
                    <option value="">All suppliers</option>
                    @foreach (var s in suppliers)
                    {
                        if (supplierIdObj != null && supplierIdObj.ToString() == s.Id.ToString())
                        {
                            <option value="@s.Id" selected>@s.Name</option>
                        }
                        else
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">🔍 Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (ModelHasErrors())
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>⚠ Errors:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var err in ViewContext.ModelState.SelectMany(m => m.Value!.Errors.Select(e => e.ErrorMessage)).Where(e => !string.IsNullOrWhiteSpace(e)).Cast<string>())
            {
                <li>@err</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Farm</th>
                    <th>Supplier</th>
                    <th>Livestock</th>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Tax</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Method</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!list.Any())
                {
                    <tr>
                        <td colspan="11" class="text-center py-5 text-muted">
                            <div class="fs-4 mb-2">📭</div>
                            <div>No expenses match your filters.</div>
                            @if (canEdit)
                            {
                                <a class="btn btn-sm btn-danger mt-3" asp-action="Create">＋ Record your first expense</a>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var x in list)
                    {
                        <tr>
                            <td>@x.ExpenseDate.LocalDateTime.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge rounded-pill text-bg-secondary">@x.Category</span>
                            </td>
                            <td>@x.FarmName</td>
                            <td>@x.SupplierName</td>
                            <td>@x.LivestockCode</td>
                            <td class="small">@x.Description</td>
                            <td class="text-end">$@x.Amount.ToString("F2")</td>
                            <td class="text-end">$@x.TaxAmount.ToString("F2")</td>
                            <td class="text-end fw-semibold">$@x.Total.ToString("F2")</td>
                            <td class="text-end small">@x.PaymentMethod</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">View</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            @if (list.Any())
            {
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td colspan="6" class="text-end text-uppercase small">TOTAL (@list.Count items)</td>
                        <td class="text-end">$@totalAmount.ToString("F2")</td>
                        <td class="text-end">$@totalTax.ToString("F2")</td>
                        <td class="text-end text-danger">$@grandTotal.ToString("F2")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
