@using LivestockManager.Domain.Enums
@model LivestockManager.Application.DTOs.LivestockLosses.LivestockLossCreateDto
@{
    ViewData["Title"] = "Record Livestock Loss";
    var farms = ViewData["Farms"] as System.Collections.IEnumerable;
    var activeLivestock = ViewData["ActiveLivestock"] as System.Collections.IEnumerable;
    var lsList = new List<dynamic>();
    if (activeLivestock != null) { foreach (var x in activeLivestock) lsList.Add(x); }
    var defaultDate = Model.LossDate == default ? DateTime.Today.ToString("yyyy-MM-dd") : Model.LossDate.ToString("yyyy-MM-dd");
    var defaultTime = Model.LossDate == default ? DateTime.Now.ToString("HH:mm") : Model.LossDate.ToString("HH:mm");
}

<div class="page-title-row">
    <div>
        <h1 class="page-title">&#128128; Record Livestock Loss</h1>
        <div class="text-muted small">Records the loss and automatically discharges the livestock.</div>
    </div>
    <div class="actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div>

<form asp-action="Create" method="post" class="row g-4 two-col-form" id="lossForm">
    <input asp-for="CompanyId" type="hidden" />
    <input type="hidden" name="LossDate" id="LossDate" value="" />

    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0 fw-semibold">Loss Details</h6>
            </div>
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Loss Date *</label>
                        <input type="date" class="form-control" id="LossDateInput" value="@defaultDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Time</label>
                        <input type="time" class="form-control" id="LossTimeInput" value="@defaultTime" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold mb-1">Loss Type *</label>
                        <select asp-for="LossType" class="form-select" required>
                            <option value="@((int)DischargeCondition.Deceased)" selected="@(Model.LossType == DischargeCondition.Deceased)">Deceased</option>
                            <option value="@((int)DischargeCondition.Lost)" selected="@(Model.LossType == DischargeCondition.Lost)">Lost (Missing)</option>
                            <option value="@((int)DischargeCondition.Stolen)" selected="@(Model.LossType == DischargeCondition.Stolen)">Stolen</option>
                            <option value="@((int)DischargeCondition.Other)" selected="@(Model.LossType == DischargeCondition.Other)">Other</option>
                        </select>
                        <span asp-validation-for="LossType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold mb-1">Livestock *</label>
                        <select asp-for="LivestockId" id="LivestockSelect" class="form-select" required>
                            <option value="">-- Select active livestock --</option>
                            @foreach (dynamic ls in lsList)
                            {
                                Guid lid = ls.Id;
                                var sel = Model.LivestockId == lid ? "selected" : "";
                                if (!string.IsNullOrEmpty(sel))
                                {
                                    <option value="@ls.Id" selected data-purchase="@ls.PurchaseAmount" data-farm="@ls.FarmId">@ls.LivestockId · @ls.LivestockTypeId @(ls.FarmName != null ? " · " + ls.FarmName : "")</option>
                                }
                                else
                                {
                                    <option value="@ls.Id" data-purchase="@ls.PurchaseAmount" data-farm="@ls.FarmId">@ls.LivestockId · @ls.LivestockTypeId @(ls.FarmName != null ? " · " + ls.FarmName : "")</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="LivestockId" class="text-danger small"></span>
                        @if (lsList.Count == 0)
                        { <div class="small text-warning mt-1">No active livestock available to record loss.</div> }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold mb-1">Farm</label>
                        <select asp-for="FarmId" class="form-select" id="FarmSelect">
                            <option value="">(inherit from livestock)</option>
                            @if (farms != null)
                            {
                                foreach (dynamic f in farms)
                                {
                                    Guid fid = f.Id;
                                    var sel = Model.FarmId == fid ? "selected" : "";
                                    if (!string.IsNullOrEmpty(sel))
                                    {
                                        <option value="@f.Id" selected>@f.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@f.Id">@f.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Book Value ($) *</label>
                        <input asp-for="BookValue" type="number" step="0.01" min="0" class="form-control" id="BookValueInput" placeholder="e.g. original purchase cost" />
                        <span asp-validation-for="BookValue" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Salvage Value ($)</label>
                        <input asp-for="SalvageValue" type="number" step="0.01" min="0" class="form-control" id="SalvageInput" placeholder="e.g. 0 or disposal proceeds" />
                        <span asp-validation-for="SalvageValue" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Estimated Loss</label>
                        <div class="form-control bg-light fw-bold text-danger" id="LossPreview">$0.00</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold mb-1">Reason</label>
                        <input asp-for="Reason" type="text" class="form-control" maxlength="2000" placeholder="Brief explanation (e.g. disease outbreak, predation, wandered off)" />
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold mb-1">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000" placeholder="Additional details (optional)"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="sticky-preview-card" style="top: calc(56px + 1rem);">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0 fw-semibold">Loss Impact Preview</h6>
                </div>
                <div class="card-body">
                    <div class="small text-muted mb-1">Book Value</div>
                    <div class="fw-semibold mb-2" id="PreviewBook">$0.00</div>

                    <div class="small text-muted mb-1">Less Salvage</div>
                    <div class="fw-semibold mb-2" id="PreviewSalvage">$0.00</div>

                    <hr class="my-2" />

                    <div class="small text-muted mb-1">Total Estimated Loss</div>
                    <div class="fw-bold fs-4 text-danger mb-3" id="PreviewLoss">$0.00</div>

                    <div class="d-grid gap-2 d-none d-md-block hide-when-mobile-sticky">
                        <button type="submit" class="btn btn-danger w-100 mb-2">Record Loss &amp; Discharge</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Cancel</a>
                    </div>

                    <div class="mt-3 small text-muted">
                        On submit, the selected livestock will be <strong>discharged</strong> with the selected loss type. This is reversible via the loss detail page's Reverse action.
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="mobile-sticky-actions">
    <button type="submit" class="btn btn-danger btn-lg" form="lossForm">Record Loss &amp; Discharge</button>
</div>

@section Scripts {
<script>
(function(){
    var dtInp = document.getElementById('LossDateInput');
    var tmInp = document.getElementById('LossTimeInput');
    var lossDt = document.getElementById('LossDate');
    var lsSel = document.getElementById('LivestockSelect');
    var farmSel = document.getElementById('FarmSelect');
    var bookInp = document.getElementById('BookValueInput');
    var salvInp = document.getElementById('SalvageInput');
    var prevBook = document.getElementById('PreviewBook');
    var prevSalv = document.getElementById('PreviewSalvage');
    var prevLoss = document.getElementById('PreviewLoss');
    var lossPreview = document.getElementById('LossPreview');

    function fmt(n){ return '$' + Number(n || 0).toFixed(2); }
    function combineDateTime(){
        var d = dtInp.value || new Date().toISOString().slice(0,10);
        var t = tmInp.value || '00:00';
        lossDt.value = d + 'T' + t + ':00.000Z';
    }
    function recalc(){
        combineDateTime();
        var b = parseFloat(bookInp.value || '0');
        var s = parseFloat(salvInp.value || '0');
        if (isNaN(b)) b = 0; if (isNaN(s)) s = 0;
        var l = Math.max(0, b - s);
        prevBook.textContent = fmt(b);
        prevSalv.textContent = fmt(s);
        prevLoss.textContent = fmt(l);
        lossPreview.textContent = fmt(l);
    }
    if (lsSel){
        lsSel.addEventListener('change', function(){
            var opt = lsSel.selectedOptions[0];
            if (opt){
                var pur = opt.getAttribute('data-purchase');
                var farm = opt.getAttribute('data-farm');
                if (!bookInp.value && pur){ bookInp.value = pur; }
                if (farm && !farmSel.value){ farmSel.value = farm; }
            }
            recalc();
        });
    }
    dtInp && dtInp.addEventListener('change', recalc);
    tmInp && tmInp.addEventListener('change', recalc);
    bookInp && bookInp.addEventListener('input', recalc);
    salvInp && salvInp.addEventListener('input', recalc);
    recalc();
})();
</script>
}
