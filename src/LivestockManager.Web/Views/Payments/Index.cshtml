@model IEnumerable<LivestockManager.Application.DTOs.Payments.PaymentSummaryDto>
@{
    ViewData["Title"] = "Payments";
    var customers = ViewData["Customers"] as System.Collections.IEnumerable;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">💵 Payments</h1>
        <div class="text-muted small">Record payments against invoices</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><span class="me-1">+</span> Record Payment</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">From</label>
                <input type="date" name="from" class="form-control" value="@ViewData["From"]" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">To</label>
                <input type="date" name="to" class="form-control" value="@ViewData["To"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Customer</label>
                <select name="customerId" class="form-select">
                    <option value="">All</option>
                    @if (customers != null)
                    {
                        @foreach (var c in (IEnumerable<dynamic>)customers)
                        {
                            <option value="@c.Id" selected="@((Guid?)ViewData["CustomerId"] == c.Id)">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Method</label>
                <select name="method" class="form-select">
                    <option value="">Any</option>
                    @foreach (var m in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@((int)m)" selected="@((PaymentMethod?)ViewData["Method"] == m)">@m</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary w-100" type="submit">🔍 Filter</button>
                    <a asp-action="Index" class="btn btn-outline-danger">✕</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Method</th>
                        <th>Reference</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                            <td>@p.CustomerName</td>
                            <td>
                                <span class="badge bg-light text-dark border">@p.Method</span>
                            </td>
                            <td><code>@p.Reference</code></td>
                            <td class="text-end fw-semibold @(p.IsReversed ? "text-decoration-line-through text-muted" : "text-success")">$@p.Amount.ToString("F2")</td>
                            <td>
                                @if (p.IsReversed)
                                { <span class="badge bg-secondary">Reversed</span> }
                                else
                                { <span class="badge bg-success">Posted</span> }
                            </td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted small">No payments found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
