@model LivestockManager.Application.DTOs.Payments.PaymentDetailDto
@{
    ViewData["Title"] = "Payment Details";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">
            @if (Model.IsReversed)
            { <span class="badge bg-secondary me-2">Reversed</span> }
            else
            { <span class="badge bg-success me-2">Posted</span> }
            Payment
        </h1>
        <div class="text-muted small">@Model.PaymentDate.ToString("yyyy-MM-dd") · @Model.Method</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">← Payments List</a>
        @if (Model.InvoiceId.HasValue && Model.InvoiceId != Guid.Empty)
        {
            <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-primary">📄 View Invoice</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom"><h6 class="mb-0 fw-bold">📋 Payment Info</h6></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small fw-semibold">Date</dt>
                    <dd class="col-sm-7">@Model.PaymentDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-5 text-muted small fw-semibold">Method</dt>
                    <dd class="col-sm-7">@Model.Method</dd>
                    <dt class="col-sm-5 text-muted small fw-semibold">Amount</dt>
                    <dd class="col-sm-7 fs-4 fw-bold text-success">$@Model.Amount.ToString("F2")</dd>
                    <dt class="col-sm-5 text-muted small fw-semibold">Reference</dt>
                    <dd class="col-sm-7"><code>@Model.Reference</code></dd>
                    <dt class="col-sm-5 text-muted small fw-semibold">Notes</dt>
                    <dd class="col-sm-7">@Model.Notes</dd>
                    @if (Model.IsReversed)
                    {
                        <dt class="col-sm-5 text-muted small fw-semibold">Reversal Reason</dt>
                        <dd class="col-sm-7 text-danger">@Model.ReversalReason</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom"><h6 class="mb-0 fw-bold">👥 Customer</h6></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small fw-semibold">Customer</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.CustomerName</dd>
                    <dt class="col-sm-5 text-muted small fw-semibold">Customer ID</dt>
                    <dd class="col-sm-7"><code>@Model.CustomerId</code></dd>
                    <dt class="col-sm-5 text-muted small fw-semibold">Posted At</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom">
        <h6 class="mb-0 fw-bold">📄 Allocations (@Model.Allocations.Count)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Invoice #</th>
                        <th>Allocated At</th>
                        <th class="text-end">Amount</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Allocations)
                    {
                        <tr>
                            <td><code>@a.InvoiceNumber</code></td>
                            <td>@a.AllocatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end fw-semibold text-success">$@a.Amount.ToString("F2")</td>
                            <td class="text-end">
                                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@a.InvoiceId" class="btn btn-sm btn-outline-primary">Open Invoice</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Allocations.Any())
                    {
                        <tr><td colspan="4" class="text-center py-4 text-muted small">No allocations recorded for this payment.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
