@using LivestockManager.Domain.Enums
@using LivestockManager.Domain.Helpers
@using LivestockManager.Domain.Common
@using Microsoft.AspNetCore.Authorization
@using LivestockManager.Web.Models.LivestockViewModels
@model LivestockIndexViewModel
@inject IAuthorizationService Authorization
@{
    ViewData["Title"] = "Livestock";
    var getStatusBadge = (Func<LivestockStatus, string>)ViewData["GetStatusBadgeClass"]!;
    var getStatusDesc = (Func<LivestockStatus, string>)ViewData["GetStatusDescription"]!;
    var authed = User.Identity?.IsAuthenticated == true;

    var caps = new PageCapabilities
    {
        CanCreate = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Livestock.Register)).Succeeded,
        CanExport = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Livestock.Export)).Succeeded,
        CanExportCsv = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Livestock.ExportCsv)).Succeeded,
        CanAddWeight = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Livestock.AddWeight)).Succeeded,
        CanEdit = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Livestock.Edit)).Succeeded,
        CanDischarge = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Livestock.Discharge)).Succeeded
    };
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-4 border-bottom">
    <h1 class="h2 mb-2 mb-md-0">🐑 Livestock</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        @if (caps.CanCreate)
        {
            <a asp-action="Register" class="btn btn-primary">
                <span class="me-1">+</span> Register Livestock
            </a>
        }
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3 col-sm-6">
                <label asp-for="FarmId" class="form-label small fw-semibold">Farm</label>
                <select asp-for="FarmId" asp-items="Model.FarmOptions" class="form-select">
                    <option value="">All Farms</option>
                </select>
                <span asp-validation-for="FarmId" class="text-danger small"></span>
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="form-label small fw-semibold">Type</label>
                <select asp-for="LivestockTypeId" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var kv in LivestockTypeDisplay.AllDisplayNames)
                    {
                        <option value="@kv.Key">@kv.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="form-label small fw-semibold">Status</label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LivestockStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-6">
                <label asp-for="SourceFilter" class="form-label small fw-semibold">Source</label>
                <select asp-for="SourceFilter" class="form-select" asp-items="Html.GetEnumSelectList<StockSource>()">
                    <option value="">All Sources</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-6">
                <label asp-for="SearchString" class="form-label small fw-semibold">Search</label>
                <input asp-for="SearchString" class="form-control" placeholder="Livestock ID or comment..." />
            </div>
            <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                <button type="submit" class="btn btn-outline-primary">Apply Filters</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                @if (caps.CanExport)
                {
                    <a asp-action="Export" asp-route-farmId="@ViewData["FarmId"]"
                       asp-route-livestockTypeId="@ViewData["LivestockTypeId"]"
                       asp-route-status="@ViewData["Status"]"
                       asp-route-sourceFilter="@ViewData["SourceFilter"]"
                       asp-route-searchString="@ViewData["SearchString"]"
                       class="btn btn-outline-success ms-md-auto">
                        📤 Export
                    </a>
                }
                @if (caps.CanExportCsv)
                {
                    <a asp-action="ExportCsv" asp-route-farmId="@ViewData["FarmId"]"
                       asp-route-livestockTypeId="@ViewData["LivestockTypeId"]"
                       asp-route-status="@ViewData["Status"]"
                       asp-route-sourceFilter="@ViewData["SourceFilter"]"
                       asp-route-searchString="@ViewData["SearchString"]"
                       class="btn btn-outline-success @(caps.CanExport ? "" : "ms-md-auto")">
                        📥 Export CSV
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive w-100">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Livestock ID</th>
                        <th>Type</th>
                        <th>Farm</th>
                        <th class="d-none d-lg-table-cell">Acquired</th>
                        <th>Source</th>
                        <th class="d-none d-lg-table-cell">DOB</th>
                        <th class="d-none d-md-table-cell">Initial</th>
                        <th>Current</th>
                        <th class="d-none d-lg-table-cell">Days</th>
                        <th>Status</th>
                        <th class="d-none d-md-table-cell">P&amp;L</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-center py-5 text-muted">
                                <div class="display-6 mb-2">🐑</div>
                                <div class="h6 mb-1">No livestock found</div>
                                <div class="small">Try adjusting your filters or register new livestock.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-primary text-nowrap">@item.LivestockId</td>
                                <td>
                                    <span class="small" title="@LivestockTypeDisplay.GetDisplayName(item.LivestockType)">
                                        @LivestockTypeDisplay.GetDisplayName(item.LivestockType)
                                    </span>
                                </td>
                                <td class="small">@item.FarmName</td>
                                <td class="small d-none d-lg-table-cell">@item.AcquisitionDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (item.StockSource == StockSource.Newborn)
                                    {
                                        <span class="badge bg-success">NEWBORN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">PURCHASED</span>
                                    }
                                </td>
                                <td class="small d-none d-lg-table-cell">
                                    @if (item.StockSource == StockSource.Newborn && item.DateOfBirth.HasValue)
                                    {
                                        @item.DateOfBirth.Value.ToString("yyyy-MM-dd")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small text-muted d-none d-md-table-cell">@item.InitialWeight</td>
                                <td class="small fw-semibold">
                                    @if (item.CurrentWeight.HasValue)
                                    {
                                        @:@item.CurrentWeight.Value
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small d-none d-lg-table-cell">@item.DaysInHerd</td>
                                <td>
                                    <span class="badge @getStatusBadge(item.Status)">
                                        @getStatusDesc(item.Status)
                                    </span>
                                </td>
                                <td class="small d-none d-md-table-cell">
                                    @if (item.BasicProfitLoss.HasValue)
                                    {
                                        var pnlClass = item.BasicProfitLoss.Value >= 0 ? "text-success" : "text-danger";
                                        <span class="@pnlClass fw-semibold">
                                            @item.BasicProfitLoss.Value.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">Details</a>
                                        @if (caps.CanEdit && item.Status == LivestockStatus.Active)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">Edit</a>
                                        }
                                        @if (caps.CanAddWeight && item.Status == LivestockStatus.Active)
                                        {
                                            <a asp-action="AddWeight" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-success">Weight</a>
                                        }
                                        @if (caps.CanDischarge && item.Status == LivestockStatus.Active)
                                        {
                                            <a asp-action="Discharge" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning">Discharge</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
