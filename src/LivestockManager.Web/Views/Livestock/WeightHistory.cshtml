@using LivestockManager.Web.Models.LivestockViewModels
@model IEnumerable<LivestockWeightHistoryItem>
@{
    ViewData["Title"] = "Weight History";
    var livestockId = (string)ViewData["LivestockId"]!;
    var livestockGuid = (Guid)ViewData["LivestockGuid"]!;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <a asp-action="Details" asp-route-id="@livestockGuid" class="text-muted small text-decoration-none">&larr; Back to Details</a>
        <h1 class="h2 mt-1 mb-0">Weight History - @livestockId</h1>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Weighed At</th>
                        <th>Weight</th>
                        <th>Unit</th>
                        <th>Change</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var items = Model.ToList();
                        if (items.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <div class="display-6 mb-2">&#9878;</div>
                                    <div class="h6 mb-1">No weight records</div>
                                    <div class="small">No weight measurements have been recorded yet.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            decimal? prev = null;
                            for (int i = 0; i < items.Count; i++)
                            {
                                var w = items[i];
                                var change = prev.HasValue ? w.Weight - prev.Value : (decimal?)null;
                                <tr>
                                    <td class="small">@w.WeighedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="fw-semibold">@w.Weight</td>
                                    <td class="small">@w.Unit</td>
                                    <td class="small">
                                        @if (change.HasValue)
                                        {
                                            var cls = change.Value > 0 ? "text-success" : change.Value < 0 ? "text-danger" : "text-muted";
                                            var prefix = change.Value > 0 ? "+" : "";
                                            <span class="@cls fw-semibold">@prefix@change.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @if (!string.IsNullOrWhiteSpace(w.Notes))
                                        {
                                            @w.Notes
                                        }
                                        else
                                        {
                                            <span class="fst-italic">—</span>
                                        }
                                    </td>
                                </tr>
                                prev = w.Weight;
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
