@model LivestockManager.Web.Models.LivestockViewModels.LivestockRegisterViewModel
@using LivestockManager.Domain.Enums
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Register Livestock";
    ViewData["PageIcon"] = "🐑";
    ViewData["PageSubtitle"] = "Add new animal to the herd registry";
    ViewData["DockKey"] = "stock";

    bool ModelHasErrors() => ViewContext.ModelState.ErrorCount > 0;
}

@if (ModelHasErrors())
{
    <div class="mob-val">
        ⚠ Please correct these before saving:
        <ul>
            @foreach (var err in ViewContext.ModelState
                .SelectMany(m => m.Value?.Errors.Select(e => e.ErrorMessage) ?? Enumerable.Empty<string>())
                .Where(e => !string.IsNullOrWhiteSpace(e)))
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<form asp-action="MobileRegister" method="post" id="regForm">
    <div class="mob-card">
        <div class="mob-card-title">📍 Farm & Acquisition</div>
        <div class="mob-field">
            <label>Farm <span class="text-danger">*</span></label>
            <select asp-for="FarmId" asp-items="Model.FarmOptions" required>
                <option value="">Select a farm...</option>
            </select>
            <span asp-validation-for="FarmId" class="field-validation-error"></span>
        </div>
        <div class="mob-field">
            <label>Acquisition Date <span class="text-danger">*</span></label>
            <input type="date" asp-for="AcquisitionDate"
                   value="@Model.AcquisitionDate.LocalDateTime.ToString("yyyy-MM-dd")"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            <span asp-validation-for="AcquisitionDate" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">🏷 Livestock Type <span class="text-danger">*</span></div>
        <div class="type-grid">
            @{
                var types = new[]
                {
                    new { Key = LivestockType.Ad, Label = "Ad", Desc = "Bred ram (castrated)", Color = "#3a6ea5" },
                    new { Key = LivestockType.Sd, Label = "Sd", Desc = "Bred ewe", Color = "#1d3557" },
                    new { Key = LivestockType.Ah, Label = "Ah", Desc = "Purchased ram (castrated)", Color = "#2d6a4f" },
                    new { Key = LivestockType.Su, Label = "Su", Desc = "Uncastrated ram", Color = "#40916c" },
                    new { Key = LivestockType.Sa, Label = "Sa", Desc = "Purchased ewe", Color = "#00a896" }
                };
            }
            @foreach (var t in types)
            {
                <div class="type-cell">
                    <input type="radio" asp-for="LivestockTypeId" value="@t.Key" id="t@(t.Key)" />
                    <label class="type-card" for="t@(t.Key)" style="--tc: @t.Color;">
                        <div class="type-top">
                            <div class="type-code">@t.Label</div>
                            <div class="type-dot"></div>
                        </div>
                        <div class="type-desc">@t.Desc</div>
                    </label>
                </div>
            }
        </div>
        <span asp-validation-for="LivestockTypeId" class="field-validation-error"></span>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">⚖ Weight & Value</div>
        <div class="f-row">
            <div class="g ps">
                <div class="mob-field">
                    <label>Initial Weight <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0.01" asp-for="InitialWeight" id="initialWeight" required
                           placeholder="e.g. 45.5" />
                    <span asp-validation-for="InitialWeight" class="field-validation-error"></span>
                </div>
            </div>
            <div class="g pe">
                <div class="mob-field">
                    <label>Unit <span class="text-danger">*</span></label>
                    <select asp-for="WeightUnit" required>
                        @foreach (var w in Enum.GetValues(typeof(WeightUnit)).OfType<WeightUnit>())
                        {
                            <option value="@w" selected="@(Model.WeightUnit == w)">@w</option>
                        }
                    </select>
                    <span asp-validation-for="WeightUnit" class="field-validation-error"></span>
                </div>
            </div>
        </div>
        <div class="mob-field">
            <label>Purchase Amount ($) <span class="text-danger">*</span></label>
            <input type="number" step="0.01" min="0" asp-for="PurchaseAmount" id="purchaseAmount"
                   placeholder="e.g. 250.00" required />
            <div id="purchaseHint" class="input-hint"></div>
            <span asp-validation-for="PurchaseAmount" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">📝 Notes (Optional)</div>
        <div class="mob-field" style="margin-bottom:0;">
            <label>Comments</label>
            <textarea asp-for="Comments" rows="3" placeholder="Tag numbers, breed details, health notes..."></textarea>
            <span asp-validation-for="Comments" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mob-submit-row">
        <div class="sub-row">
            <a asp-action="MobileIndex" class="mob-submit-btn small-sub">Cancel</a>
            <button type="submit" class="mob-submit-btn small-sub primary">💾 Register</button>
        </div>
        <button type="submit" class="mob-submit-btn">🐑 Register Livestock</button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var hintEl = document.getElementById('purchaseHint');
            var input = document.getElementById('purchaseAmount');

            function updateHint() {
                var val = document.querySelector('input[name="LivestockTypeId"]:checked');
                if (!val) { if (hintEl) hintEl.textContent = ''; return; }
                var v = val.value;
                if (v === 'Ad' || v === 'Sd') {
                    if (hintEl) hintEl.textContent = 'Tip: Bred types (Ad/Sd) - purchase amount should be 0.';
                    if (input && (!input.value || parseFloat(input.value) === 0)) {
                        input.value = '0';
                    }
                } else if (v === 'Ah' || v === 'Su' || v === 'Sa') {
                    if (hintEl) hintEl.textContent = 'Tip: Purchased types - enter the cost paid per head.';
                } else {
                    if (hintEl) hintEl.textContent = '';
                }
            }

            document.querySelectorAll('input[name="LivestockTypeId"]').forEach(function (r) {
                r.addEventListener('change', updateHint);
            });
            updateHint();
        })();
    </script>
}
