@model IEnumerable<LivestockManager.Web.Models.LivestockViewModels.LivestockListItemDto>
@using LivestockManager.Domain.Enums
@using LivestockManager.Domain.Helpers
@using LivestockManager.Domain.Common
@using LivestockManager.Application.DTOs.Livestock
@using LivestockManager.Application.DTOs.Farms
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Livestock";
    ViewData["PageIcon"] = "🐑";
    ViewData["PageSubtitle"] = "Herd registry, status and weights";
    ViewData["DockKey"] = "stock";
    ViewData["ActionLabel"] = "Register";
    ViewData["ActionIcon"] = "＋";
    ViewData["ActionUrl"] = Url.Action("MobileRegister", "Livestock");

    var farmId = ViewData["FarmId"] as Guid?;
    var typeId = ViewData["LivestockTypeId"] as LivestockType?;
    var status = ViewData["Status"] as LivestockStatus?;
    var sourceFilter = ViewData["SourceFilter"] as StockSource?;
    var search = ViewData["SearchString"] as string;
    var farmOptions = ViewData["FarmOptions"] as SelectList;
    var canEdit = User.IsInRole(RoleNames.CompanyAdministrator) || User.IsInRole(RoleNames.SystemAdministrator) || User.IsInRole(RoleNames.FarmManager);
    var canDataEntry = canEdit || User.IsInRole(RoleNames.DataEntry);

    var list = Model?.ToList() ?? new List<LivestockListItemDto>();
    var activeCount = list.Count(x => x.Status == LivestockStatus.Active);
    var avgWeight = list.Where(x => x.Status == LivestockStatus.Active && x.CurrentWeight.HasValue)
                        .Select(x => x.CurrentWeight!.Value)
                        .DefaultIfEmpty(0)
                        .Average();
    var totalPnl = list.Sum(x => x.BasicProfitLoss ?? 0);

    var qsPreserve = new Dictionary<string, string?>();
    if (farmId.HasValue) qsPreserve["farmId"] = farmId.Value.ToString();
    if (typeId.HasValue) qsPreserve["livestockTypeId"] = typeId.Value.ToString();
    if (status.HasValue) qsPreserve["status"] = status.Value.ToString();
    if (!string.IsNullOrWhiteSpace(search)) qsPreserve["searchString"] = search;
}

<div class="mob-card">
    <div class="mob-card-title">🔍 Search</div>
    <form method="get" asp-action="MobileIndex">
        <div class="mob-field">
            <label>Search</label>
            <input type="text" name="searchString" value="@search" placeholder="Livestock ID or comment..." />
        </div>
        <details class="mob-adv-filters" style="margin-top:0.5rem;">
            <summary style="list-style:none; cursor:pointer; font-weight:600; color:#3a6ea5; padding:0.5rem 0; user-select:none;">
                ⚙ Advanced Filters <small style="opacity:0.75;">(tap to open)</small>
            </summary>
            <div style="padding-top:0.5rem;">
                <div class="mob-field">
                    <label>Farm</label>
                    <select name="farmId" style="width:100%;">
                        <option value="">All farms</option>
                        @if (farmOptions != null)
                        {
                            @foreach (var f in farmOptions)
                            {
                                <option value="@f.Value" selected="@(farmId.HasValue && farmId.Value.ToString() == f.Value ? "selected" : null)">@f.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="mob-field">
                    <label>Type</label>
                    <select name="livestockTypeId" style="width:100%;">
                        <option value="">All types</option>
                        @foreach (var kv in LivestockTypeDisplay.AllDisplayNames)
                        {
                            <option value="@kv.Key" selected="@(typeId == kv.Key ? "selected" : null)">@kv.Value</option>
                        }
                    </select>
                </div>
                <div class="mob-field">
                    <label>Status</label>
                    <select name="status" style="width:100%;">
                        <option value="">All statuses</option>
                        @foreach (var s in Enum.GetValues(typeof(LivestockStatus)).OfType<LivestockStatus>())
                        {
                            <option value="@s" selected="@(status == s ? "selected" : null)">@s</option>
                        }
                    </select>
                </div>
                <div class="f-row" style="gap:0.5rem;">
                    <a asp-action="MobileIndex" class="mob-btn ghost" style="flex:1;">Reset</a>
                    <button type="submit" class="mob-btn primary" style="flex:1;">🔍 Apply</button>
                </div>
            </div>
        </details>
    </form>
</div>

<div class="mob-totals-card">
    <div class="label">Active Herd</div>
    <div class="total">@activeCount</div>
    <div class="breakdown">
        <div><div class="k">Avg Weight</div><div class="v">@avgWeight.ToString("F1") kg</div></div>
        <div><div class="k">P&amp;L</div><div class="v">@(totalPnl >= 0 ? "+" : "-")$@Math.Abs(totalPnl).ToString("N0")</div></div>
    </div>
</div>

<div class="mob-kpi-row">
    <div class="mob-kpi" style="--kpi-color:#2d6a4f;">
        <div class="k-label">Active</div>
        <div class="k-value">@activeCount</div>
        <div class="k-caption">In herd</div>
    </div>
    <div class="mob-kpi" style="--kpi-color:#3a6ea5;">
        <div class="k-label">Discharged</div>
        <div class="k-value">@(list.Count - activeCount)</div>
        <div class="k-caption">Sold / Lost / Etc</div>
    </div>
</div>

<div class="mob-card">
    <div class="mob-card-title">Source Filter</div>
    <div class="chip-tabs" style="grid-template-columns: repeat(3, 1fr);">
        @{
            var allActive = !sourceFilter.HasValue ? "active" : null;
            var purActive = sourceFilter == StockSource.Purchased ? "active" : null;
            var newbActive = sourceFilter == StockSource.Newborn ? "active" : null;
            var allQs = new Dictionary<string, string?>(qsPreserve);
            allQs["sourceFilter"] = null;
            var purQs = new Dictionary<string, string?>(qsPreserve);
            purQs["sourceFilter"] = "Purchased";
            var newbQs = new Dictionary<string, string?>(qsPreserve);
            newbQs["sourceFilter"] = "Newborn";
        }
        <a asp-action="MobileIndex" asp-all-route-data="allQs" class="chip-tab @allActive">ALL</a>
        <a asp-action="MobileIndex" asp-all-route-data="purQs" class="chip-tab @purActive">PURCHASED</a>
        <a asp-action="MobileIndex" asp-all-route-data="newbQs" class="chip-tab @newbActive">NEWBORN</a>
    </div>
</div>

<div class="mob-list-cards">
    @if (!list.Any())
    {
        <div class="mob-empty">
            🐑<br />
            No livestock found.
            <br /><br />
            Tap ＋ Register to add the first animal.
        </div>
    }
    else
    {
        @foreach (var l in list)
        {
            var statusPill = l.Status switch
            {
                LivestockStatus.Active => ("Active", "ok"),
                LivestockStatus.DischargedSold => ("Sold", "good"),
                LivestockStatus.DischargedDeceased => ("Deceased", "bad"),
                LivestockStatus.DischargedLost => ("Lost", "warn"),
                LivestockStatus.DischargedStolen => ("Stolen", "bad"),
                _ => (l.Status.ToString(), "idle")
            };
            var pnlVal = l.BasicProfitLoss ?? 0;
            <div class="mob-list-card">
                <div class="row-top">
                    <div style="min-width:0; flex:1 1 auto;">
                        <code style="word-break:break-all;">@l.LivestockId</code>
                        <div class="pill-stack">
                            <span class="pill @statusPill.Item2">@statusPill.Item1</span>
                            @{
                                var srcPillClass = l.StockSource == StockSource.Newborn ? "good" : "info";
                                var srcPillLabel = l.StockSource == StockSource.Newborn ? "NEWBORN" : "PURCHASED";
                            }
                            <span class="pill @srcPillClass">@srcPillLabel</span>
                            @if (!string.IsNullOrWhiteSpace(l.FarmName))
                            { <span class="pill info">@l.FarmName</span> }
                        </div>
                        <div style="font-size:0.75rem; color:#3a6ea5; word-break:break-word; margin-top:0.25rem;">
                            @LivestockTypeDisplay.GetDisplayName(l.LivestockType)
                        </div>
                    </div>
                    <div class="val-right" style="flex:0 0 auto; padding-left:0.5rem;">
                        <div class="amt" style="white-space:nowrap;">
                            @if (l.CurrentWeight.HasValue)
                            {
                                <text>@(l.CurrentWeight.Value.ToString("F1")) kg</text>
                            }
                            else
                            { <span class="code-muted">— kg</span> }
                        </div>
                        @if (l.Status != LivestockStatus.Active)
                        {
                            <div class="sub" style="white-space:nowrap; margin-top:0.15rem;">
                                @(pnlVal >= 0 ? "+" : "")$@(pnlVal.ToString("F0"))
                            </div>
                        }
                    </div>
                </div>
                <div class="rows rows-3col">
                    <div class="cell">
                        <div class="label">Acquired</div>
                        <div class="val">@l.AcquisitionDate.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="cell">
                        <div class="label">Days</div>
                        <div class="val">@l.DaysInHerd</div>
                    </div>
                    <div class="cell">
                        <div class="label">P&amp;L</div>
                        <div class="val">
                            @if (l.Status != LivestockStatus.Active)
                            {
                                var sign = pnlVal >= 0 ? "+" : "";
                                <text>@sign$@(pnlVal.ToString("F0"))</text>
                            }
                            else
                            { <span class="code-muted">—</span> }
                        </div>
                    </div>
                </div>
                <div class="row-actions">
                    <a asp-action="Details" asp-route-id="@l.Id" class="mob-btn" style="min-height:44px;">👁 View</a>
                    @if (canDataEntry && l.Status == LivestockStatus.Active)
                    {
                        <a asp-action="AddWeight" asp-route-id="@l.Id" class="mob-btn primary" style="min-height:44px;">⚖ Weight</a>
                    }
                    @if (canEdit && l.Status == LivestockStatus.Active)
                    {
                        <a asp-controller="LivestockLosses" asp-action="MobileCreate" asp-route-livestockId="@l.Id" class="mob-btn danger" style="min-height:44px;">💀 Loss</a>
                    }
                </div>
            </div>
        }
    }
</div>
