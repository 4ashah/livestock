@model LivestockManager.Web.Models.StockAdditionViewModels.StockAdditionPurchaseViewModel
@using LivestockManager.Domain.Enums
@using LivestockManager.Domain.Helpers
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "New Purchase";
    ViewData["PageIcon"] = "🛒";
    ViewData["PageSubtitle"] = "Record supplier livestock purchase";
    ViewData["DockKey"] = "stock";

    bool ModelHasErrors() => ViewContext.ModelState.ErrorCount > 0;
}

@if (ModelHasErrors())
{
    <div class="mob-val">
        ⚠ Please correct these before saving:
        <ul>
            @foreach (var err in ViewContext.ModelState
                .SelectMany(m => m.Value?.Errors.Select(e => e.ErrorMessage) ?? Enumerable.Empty<string>())
                .Where(e => !string.IsNullOrWhiteSpace(e)))
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<form asp-action="MobilePurchase" method="post" id="purchaseForm">
    <input type="hidden" asp-for="IdempotencyKey" />
    <input type="hidden" asp-for="CostAllocationMethod" value="@((int)CostAllocationMethod.Equal)" />

    <div class="mob-card">
        <div class="mob-card-title">📍 Supplier & Farm</div>
        <div class="mob-field">
            <label>Supplier <span class="text-danger">*</span></label>
            <select asp-for="SupplierId" asp-items="Model.SupplierOptions" required>
                <option value="">Select a supplier...</option>
            </select>
            <span asp-validation-for="SupplierId" class="field-validation-error"></span>
        </div>
        <div class="mob-field">
            <label>Farm <span class="text-danger">*</span></label>
            <select asp-for="FarmId" asp-items="Model.FarmOptions" required>
                <option value="">Select a farm...</option>
            </select>
            <span asp-validation-for="FarmId" class="field-validation-error"></span>
        </div>
        <div class="mob-field">
            <label>Purchase Date <span class="text-danger">*</span></label>
            <input type="date" asp-for="PurchaseDate"
                   value="@Model.PurchaseDate.LocalDateTime.ToString("yyyy-MM-dd")"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            <span asp-validation-for="PurchaseDate" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">🏷 Livestock Type <span class="text-danger">*</span></div>
        <div class="type-grid">
            @{
                var types = new[]
                {
                    new { Key = LivestockType.Ah, Label = "Ah", Desc = LivestockTypeDisplay.GetDisplayName(LivestockType.Ah), Color = "#2d6a4f" },
                    new { Key = LivestockType.Su, Label = "Su", Desc = LivestockTypeDisplay.GetDisplayName(LivestockType.Su), Color = "#40916c" },
                    new { Key = LivestockType.Sa, Label = "Sa", Desc = LivestockTypeDisplay.GetDisplayName(LivestockType.Sa), Color = "#00a896" }
                };
            }
            @foreach (var t in types)
            {
                <div class="type-cell">
                    <input type="radio" asp-for="LivestockTypeId" value="@t.Key" id="t@(t.Key)" />
                    <label class="type-card" for="t@(t.Key)" style="--tc: @t.Color;">
                        <div class="type-top">
                            <div class="type-code">@t.Label</div>
                            <div class="type-dot"></div>
                        </div>
                        <div class="type-desc">@t.Desc</div>
                    </label>
                </div>
            }
        </div>
        <span asp-validation-for="LivestockTypeId" class="field-validation-error"></span>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">⚖ Weight</div>
        <div class="f-row">
            <div class="g ps">
                <div class="mob-field">
                    <label>Purchase Weight <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0.01" asp-for="PurchaseWeight" id="purchaseWeight" required
                           inputmode="decimal" placeholder="e.g. 45.5" />
                    <span asp-validation-for="PurchaseWeight" class="field-validation-error"></span>
                </div>
            </div>
            <div class="g pe">
                <div class="mob-field">
                    <label>Unit <span class="text-danger">*</span></label>
                    <select asp-for="WeightUnit" required>
                        @foreach (var w in Enum.GetValues(typeof(WeightUnit)).OfType<WeightUnit>())
                        {
                            <option value="@w" selected="@(Model.WeightUnit == w)">@w</option>
                        }
                    </select>
                    <span asp-validation-for="WeightUnit" class="field-validation-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">💰 Purchase Costs</div>

        <div class="mob-field">
            <label>Purchase Cost <span class="text-danger">*</span></label>
            <input type="number" step="0.01" min="0" asp-for="PurchaseCost" id="cost-purchase"
                   inputmode="decimal" placeholder="e.g. 1000.00" required />
            <span asp-validation-for="PurchaseCost" class="field-validation-error"></span>
        </div>

        <div class="mob-field">
            <label>Commission</label>
            <input type="number" step="0.01" min="0" asp-for="CommissionAmount" id="cost-commission"
                   inputmode="decimal" placeholder="0.00" />
            <span asp-validation-for="CommissionAmount" class="field-validation-error"></span>
        </div>

        <div class="mob-field">
            <label>Taxes</label>
            <input type="number" step="0.01" min="0" asp-for="TaxAmount" id="cost-tax"
                   inputmode="decimal" placeholder="0.00" />
            <span asp-validation-for="TaxAmount" class="field-validation-error"></span>
        </div>

        <div class="mob-field">
            <label>Transportation</label>
            <input type="number" step="0.01" min="0" asp-for="TransportationAmount" id="cost-transport"
                   inputmode="decimal" placeholder="0.00" />
            <span asp-validation-for="TransportationAmount" class="field-validation-error"></span>
        </div>

        <div class="mob-field">
            <label>Other Costs</label>
            <input type="number" step="0.01" min="0" asp-for="OtherCostAmount" id="cost-other"
                   inputmode="decimal" placeholder="0.00" />
            <span asp-validation-for="OtherCostAmount" class="field-validation-error"></span>
        </div>

        <div class="mob-field" id="otherDescWrap" style="display:none;">
            <label>Other Cost Description <span class="text-danger">*</span></label>
            <input type="text" asp-for="OtherCostDescription" id="cost-other-desc" maxlength="500"
                   placeholder="What do Other Costs cover?" />
            <span asp-validation-for="OtherCostDescription" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mob-card mob-totals-card" style="background:linear-gradient(135deg,#eafaf1 0%, #f8fff9 100%); border:1px solid #b7e4c7;">
        <div class="mob-card-title" style="color:#1b4332;">🔎 Acquisition Summary <small class="text-muted fw-normal">(preview only · finalized on server)</small></div>
        <div class="breakdown-row">
            <div class="k">Purchase Cost</div>
            <div class="v" id="sum-purchase">$0.00</div>
        </div>
        <div class="breakdown-row">
            <div class="k">Additional Costs</div>
            <div class="v" id="sum-additional">$0.00</div>
        </div>
        <div class="breakdown-row total-row">
            <div class="k">Total Acquisition Cost</div>
            <div class="v" id="sum-total">$0.00</div>
        </div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">📝 Reference & Notes</div>
        <div class="mob-field">
            <label>Supplier Reference</label>
            <input type="text" asp-for="SupplierReference" placeholder="Invoice # or supplier reference (optional)" />
            <span asp-validation-for="SupplierReference" class="field-validation-error"></span>
        </div>
        <div class="mob-field" style="margin-bottom:0;">
            <label>Comments</label>
            <textarea asp-for="Comments" rows="3" placeholder="Breed details, health notes, tag numbers..."></textarea>
            <span asp-validation-for="Comments" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mob-submit-row">
        <div class="sub-row">
            <a asp-action="MobileIndex" class="mob-submit-btn small-sub">Cancel</a>
            <button type="submit" class="mob-submit-btn small-sub primary" id="saveBtnSmall">💾 Save</button>
        </div>
        <button type="submit" class="mob-submit-btn" id="saveBtn">🛒 Save Purchase</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });
            var inputs = {
                purchase: document.getElementById('cost-purchase'),
                commission: document.getElementById('cost-commission'),
                tax: document.getElementById('cost-tax'),
                transport: document.getElementById('cost-transport'),
                other: document.getElementById('cost-other')
            };
            var sums = {
                purchase: document.getElementById('sum-purchase'),
                additional: document.getElementById('sum-additional'),
                total: document.getElementById('sum-total')
            };
            var otherDescWrap = document.getElementById('otherDescWrap');
            var otherDesc = document.getElementById('cost-other-desc');

            function nz(v) {
                var n = parseFloat(v);
                if (!isFinite(n) || n < 0) return 0;
                return Math.round(n * 100) / 100;
            }

            function update() {
                var purchase = nz(inputs.purchase.value);
                var comm = nz(inputs.commission.value);
                var tax = nz(inputs.tax.value);
                var trans = nz(inputs.transport.value);
                var other = nz(inputs.other.value);
                var additional = comm + tax + trans + other;
                var total = purchase + additional;

                sums.purchase.textContent = money.format(purchase);
                sums.additional.textContent = money.format(additional);
                sums.total.textContent = money.format(total);

                if (other > 0) {
                    otherDescWrap.style.display = '';
                    otherDesc.setAttribute('required', 'required');
                    if (!otherDesc.value.trim()) {
                        otherDesc.classList.add('border-danger');
                    } else {
                        otherDesc.classList.remove('border-danger');
                    }
                } else {
                    otherDescWrap.style.display = 'none';
                    otherDesc.removeAttribute('required');
                    otherDesc.classList.remove('border-danger');
                }
            }

            Object.keys(inputs).forEach(function (k) {
                inputs[k].addEventListener('input', update);
                inputs[k].addEventListener('change', update);
            });
            if (otherDesc) {
                otherDesc.addEventListener('input', function () {
                    if (nz(inputs.other.value) > 0 && otherDesc.value.trim()) {
                        otherDesc.classList.remove('border-danger');
                    }
                });
            }

            update();

            var form = document.getElementById('purchaseForm');
            var submitted = false;
            function lock() {
                if (submitted) return false;
                submitted = true;
                var btns = form.querySelectorAll('button[type=submit]');
                Array.prototype.forEach.call(btns, function (b) {
                    b.disabled = true;
                    b.classList.add('opacity-75');
                });
                return true;
            }
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (!lock()) {
                        e.preventDefault();
                        return;
                    }
                    if (form.reportValidity && !form.reportValidity()) {
                        submitted = false;
                        var btns = form.querySelectorAll('button[type=submit]');
                        Array.prototype.forEach.call(btns, function (b) {
                            b.disabled = false;
                            b.classList.remove('opacity-75');
                        });
                    }
                });
            }
        })();
    </script>
}
