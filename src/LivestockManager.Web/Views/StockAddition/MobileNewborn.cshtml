@model LivestockManager.Web.Models.StockAdditionViewModels.StockAdditionNewbornViewModel
@using LivestockManager.Domain.Enums
@using LivestockManager.Application.DTOs.StockAddition
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Newborn";
    ViewData["PageIcon"] = "🐣";
    ViewData["PageSubtitle"] = "Record on-farm newborn lamb";
    ViewData["DockKey"] = "stock";

    bool ModelHasErrors() => ViewContext.ModelState.ErrorCount > 0;
    var eweOptions = ViewData["EweOptions"] as IList<ParentSearchItemDto> ?? new List<ParentSearchItemDto>();
    var ramOptions = ViewData["RamOptions"] as IList<ParentSearchItemDto> ?? new List<ParentSearchItemDto>();
}

@if (ModelHasErrors())
{
    <div class="mob-val">
        ⚠ Please correct these before saving:
        <ul>
            @foreach (var err in ViewContext.ModelState
                .SelectMany(m => m.Value?.Errors.Select(e => e.ErrorMessage) ?? Enumerable.Empty<string>())
                .Where(e => !string.IsNullOrWhiteSpace(e)))
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<form asp-action="MobileNewborn" method="post" id="newbornForm">
    <input type="hidden" asp-for="IdempotencyKey" />

    <div class="mob-card">
        <div class="mob-card-title">📍 Birth Details</div>
        <div class="mob-field">
            <label>Date of Birth <span class="text-danger">*</span></label>
            <input type="date" asp-for="DateOfBirth"
                   value="@Model.DateOfBirth.LocalDateTime.ToString("yyyy-MM-dd")"
                   max="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
            <span asp-validation-for="DateOfBirth" class="field-validation-error"></span>
        </div>
        <div class="mob-field">
            <label>Farm <span class="text-danger">*</span></label>
            <select asp-for="FarmId" asp-items="Model.FarmOptions" required>
                <option value="">Select a farm...</option>
            </select>
            <span asp-validation-for="FarmId" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">🏷 Livestock Type <span class="text-danger">*</span></div>
        <div class="type-grid">
            @{
                var types = new[]
                {
                    new { Key = LivestockType.Ad, Label = "Ad", Desc = "Bred ram (castrated)", Color = "#3a6ea5" },
                    new { Key = LivestockType.Sd, Label = "Sd", Desc = "Bred ewe", Color = "#1d3557" }
                };
            }
            @foreach (var t in types)
            {
                <div class="type-cell">
                    <input type="radio" asp-for="LivestockTypeId" value="@t.Key" id="t@(t.Key)" />
                    <label class="type-card" for="t@(t.Key)" style="--tc: @t.Color;">
                        <div class="type-top">
                            <div class="type-code">@t.Label</div>
                            <div class="type-dot"></div>
                        </div>
                        <div class="type-desc">@t.Desc</div>
                    </label>
                </div>
            }
        </div>
        <span asp-validation-for="LivestockTypeId" class="field-validation-error"></span>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">⚖ Birth Weight</div>
        <div class="f-row">
            <div class="g ps">
                <div class="mob-field">
                    <label>Birth Weight <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0.01" asp-for="BirthWeight" id="birthWeight" required
                           placeholder="e.g. 4.5" />
                    <span asp-validation-for="BirthWeight" class="field-validation-error"></span>
                </div>
            </div>
            <div class="g pe">
                <div class="mob-field">
                    <label>Unit <span class="text-danger">*</span></label>
                    <select asp-for="WeightUnit" required>
                        @foreach (var w in Enum.GetValues(typeof(WeightUnit)).OfType<WeightUnit>())
                        {
                            <option value="@w" selected="@(Model.WeightUnit == w)">@w</option>
                        }
                    </select>
                    <span asp-validation-for="WeightUnit" class="field-validation-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">👩‍👦 Mother (Ewe) <span class="text-danger">*</span></div>
        <div class="mob-field">
            <input type="text" id="eweSearch" placeholder="Search ewes by ID or comments..." />
        </div>
        <div class="mob-field">
            <select asp-for="MotherLivestockId" id="motherSelect" required size="5"
                    style="min-height:120px;">
                <option value="">Select mother ewe...</option>
                @foreach (var ewe in eweOptions)
                {
                    <option value="@ewe.Id">@ewe.LivestockId - @ewe.TypeDescription@(!string.IsNullOrEmpty(ewe.FarmName) ? " (" + ewe.FarmName + ")" : "")</option>
                }
            </select>
            <span asp-validation-for="MotherLivestockId" class="field-validation-error"></span>
        </div>
        <div class="small text-muted">Showing first @eweOptions.Count active ewes. Use search to filter.</div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">👨‍👦 Father (Ram) <span class="text-danger">*</span></div>
        <div class="mob-field">
            <input type="text" id="ramSearch" placeholder="Search rams by ID or comments..." />
        </div>
        <div class="mob-field">
            <select asp-for="FatherLivestockId" id="fatherSelect" required size="5"
                    style="min-height:120px;">
                <option value="">Select father ram...</option>
                @foreach (var ram in ramOptions)
                {
                    <option value="@ram.Id">@ram.LivestockId - @ram.TypeDescription@(!string.IsNullOrEmpty(ram.FarmName) ? " (" + ram.FarmName + ")" : "")</option>
                }
            </select>
            <span asp-validation-for="FatherLivestockId" class="field-validation-error"></span>
        </div>
        <div class="small text-muted">Showing first @ramOptions.Count active rams. Use search to filter.</div>
    </div>

    <div class="mob-card">
        <div class="mob-card-title">📝 Notes (Optional)</div>
        <div class="mob-field" style="margin-bottom:0;">
            <label>Birth Comments</label>
            <textarea asp-for="BirthComments" rows="3" placeholder="Birth conditions, litter size, health observations..."></textarea>
            <span asp-validation-for="BirthComments" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mob-submit-row">
        <div class="sub-row">
            <a asp-action="MobileIndex" class="mob-submit-btn small-sub">Cancel</a>
            <button type="submit" class="mob-submit-btn small-sub primary" style="--btn-bg:#2d6a4f;">💾 Save</button>
        </div>
        <button type="submit" class="mob-submit-btn" style="--btn-bg:#2d6a4f;">🐣 Save Newborn</button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var eweSearch = document.getElementById('eweSearch');
            var motherSelect = document.getElementById('motherSelect');
            var ramSearch = document.getElementById('ramSearch');
            var fatherSelect = document.getElementById('fatherSelect');
            var eweTimeout;
            var ramTimeout;

            function searchEwes(keyword) {
                fetch('@Url.Action("SearchEligibleEwes")?keyword=' + encodeURIComponent(keyword || ''))
                    .then(function (r) { return r.json(); })
                    .then(function (results) {
                        var currentVal = motherSelect.value;
                        motherSelect.innerHTML = '<option value="">Select mother ewe...</option>';
                        (results || []).forEach(function (item) {
                            var opt = document.createElement('option');
                            opt.value = item.id;
                            opt.textContent = item.livestockId + ' - ' + item.typeDescription + (item.farmName ? ' (' + item.farmName + ')' : '');
                            if (item.id === currentVal) opt.selected = true;
                            motherSelect.appendChild(opt);
                        });
                    });
            }

            function searchRams(keyword) {
                fetch('@Url.Action("SearchEligibleRams")?keyword=' + encodeURIComponent(keyword || ''))
                    .then(function (r) { return r.json(); })
                    .then(function (results) {
                        var currentVal = fatherSelect.value;
                        fatherSelect.innerHTML = '<option value="">Select father ram...</option>';
                        (results || []).forEach(function (item) {
                            var opt = document.createElement('option');
                            opt.value = item.id;
                            opt.textContent = item.livestockId + ' - ' + item.typeDescription + (item.farmName ? ' (' + item.farmName + ')' : '');
                            if (item.id === currentVal) opt.selected = true;
                            fatherSelect.appendChild(opt);
                        });
                    });
            }

            eweSearch.addEventListener('input', function () {
                clearTimeout(eweTimeout);
                eweTimeout = setTimeout(function () { searchEwes(eweSearch.value); }, 250);
            });

            ramSearch.addEventListener('input', function () {
                clearTimeout(ramTimeout);
                ramTimeout = setTimeout(function () { searchRams(ramSearch.value); }, 250);
            });
        })();
    </script>
}
