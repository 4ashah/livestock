@using LivestockManager.Domain.Enums
@using LivestockManager.Domain.Helpers
@using LivestockManager.Application.DTOs.StockAddition
@model LivestockManager.Web.Models.StockAdditionViewModels.StockAdditionNewbornViewModel
@{
    ViewData["Title"] = "Newborn";
    ViewData["DockKey"] = "stock";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <h1 class="h2">🐣 Newborn</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Stock Addition</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Newborn" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdempotencyKey" />

            @if (ViewContext.ModelState != null && ViewContext.ModelState.Any(x => x.Value != null && x.Value.Errors != null && x.Value.Errors.Count > 0))
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
            }

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}"
                           max="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FarmId" class="form-label fw-semibold"></label>
                    <select asp-for="FarmId" asp-items="Model.FarmOptions" class="form-select">
                        <option value="">Select a farm...</option>
                    </select>
                    <span asp-validation-for="FarmId" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="LivestockTypeId" class="form-label fw-semibold"></label>
                    <div class="row g-2">
                        <div class="col-md-4 col-sm-6">
                            <div class="form-check card p-2 border h-100">
                                <input type="radio" asp-for="LivestockTypeId" value="@LivestockType.Ad" class="form-check-input" id="tAd" checked />
                                <label class="form-check-label fw-semibold" for="tAd">Ad</label>
                                <div class="small mt-1">@LivestockTypeDisplay.GetDisplayName(LivestockType.Ad)</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="form-check card p-2 border h-100">
                                <input type="radio" asp-for="LivestockTypeId" value="@LivestockType.Sd" class="form-check-input" id="tSd" />
                                <label class="form-check-label fw-semibold" for="tSd">Sd</label>
                                <div class="small mt-1">@LivestockTypeDisplay.GetDisplayName(LivestockType.Sd)</div>
                            </div>
                        </div>
                    </div>
                    <span asp-validation-for="LivestockTypeId" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="BirthWeight" class="form-label fw-semibold"></label>
                    <input asp-for="BirthWeight" type="number" step="0.01" min="0.01" class="form-control"
                           placeholder="e.g. 4.5" />
                    <span asp-validation-for="BirthWeight" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="WeightUnit" class="form-label fw-semibold"></label>
                    <select asp-for="WeightUnit" class="form-select" asp-items="Html.GetEnumSelectList<WeightUnit>()"></select>
                    <span asp-validation-for="WeightUnit" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MotherLivestockId" class="form-label fw-semibold"></label>
                    <div class="mb-2">
                        <input type="text" id="motherSearch" class="form-control mb-2" placeholder="Search ewes by ID or comments..." />
                    </div>
                    <select asp-for="MotherLivestockId" id="motherSelect" class="form-select">
                        <option value="">Select or search a mother ewe...</option>
                    </select>
                    <span asp-validation-for="MotherLivestockId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FatherLivestockId" class="form-label fw-semibold"></label>
                    <div class="mb-2">
                        <input type="text" id="fatherSearch" class="form-control mb-2" placeholder="Search rams by ID or comments..." />
                    </div>
                    <select asp-for="FatherLivestockId" id="fatherSelect" class="form-select">
                        <option value="">Select or search a father ram...</option>
                    </select>
                    <span asp-validation-for="FatherLivestockId" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="BirthComments" class="form-label fw-semibold"></label>
                    <textarea asp-for="BirthComments" rows="3" class="form-control"
                              placeholder="Optional notes: birth conditions, litter size, health observations..."></textarea>
                    <span asp-validation-for="BirthComments" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mt-5">
                <div class="col-12 text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">🐣 Save Newborn</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var motherSearch = document.getElementById('motherSearch');
            var motherSelect = document.getElementById('motherSelect');
            var fatherSearch = document.getElementById('fatherSearch');
            var fatherSelect = document.getElementById('fatherSelect');

            var motherTimeout;
            var fatherTimeout;

            function searchEwes(keyword) {
                fetch('@Url.Action("SearchEligibleEwes")?keyword=' + encodeURIComponent(keyword || ''))
                    .then(function (r) { return r.json(); })
                    .then(function (results) {
                        var currentVal = motherSelect.value;
                        motherSelect.innerHTML = '<option value="">Select or search a mother ewe...</option>';
                        (results || []).forEach(function (item) {
                            var opt = document.createElement('option');
                            opt.value = item.id;
                            opt.textContent = item.livestockId + ' - ' + item.typeDescription + (item.farmName ? ' (' + item.farmName + ')' : '');
                            if (item.id === currentVal) opt.selected = true;
                            motherSelect.appendChild(opt);
                        });
                    });
            }

            function searchRams(keyword) {
                fetch('@Url.Action("SearchEligibleRams")?keyword=' + encodeURIComponent(keyword || ''))
                    .then(function (r) { return r.json(); })
                    .then(function (results) {
                        var currentVal = fatherSelect.value;
                        fatherSelect.innerHTML = '<option value="">Select or search a father ram...</option>';
                        (results || []).forEach(function (item) {
                            var opt = document.createElement('option');
                            opt.value = item.id;
                            opt.textContent = item.livestockId + ' - ' + item.typeDescription + (item.farmName ? ' (' + item.farmName + ')' : '');
                            if (item.id === currentVal) opt.selected = true;
                            fatherSelect.appendChild(opt);
                        });
                    });
            }

            motherSearch.addEventListener('input', function () {
                clearTimeout(motherTimeout);
                motherTimeout = setTimeout(function () { searchEwes(motherSearch.value); }, 250);
            });

            fatherSearch.addEventListener('input', function () {
                clearTimeout(fatherTimeout);
                fatherTimeout = setTimeout(function () { searchRams(fatherSearch.value); }, 250);
            });

            searchEwes('');
            searchRams('');
        })();
    </script>
}
