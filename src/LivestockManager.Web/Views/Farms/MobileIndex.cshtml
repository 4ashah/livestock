@using LivestockManager.Domain.Common
@using Microsoft.AspNetCore.Authorization
@model IEnumerable<FarmListViewModel>
@inject IAuthorizationService Authorization
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Farms";
    ViewData["PageIcon"] = "🌾";
    ViewData["PageSubtitle"] = "Farm locations & operations";
    ViewData["DockKey"] = "farms";
    var search = ViewData["Search"] as string;
    var authed = User.Identity?.IsAuthenticated == true;
    var caps = new PageCapabilities
    {
        CanCreate = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Farms.Create)).Succeeded,
        CanEdit = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Farms.Edit)).Succeeded,
        CanArchive = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Farms.Archive)).Succeeded
    };
    if (caps.CanCreate)
    {
        ViewData["ActionLabel"] = "New";
        ViewData["ActionIcon"] = "＋";
        ViewData["ActionUrl"] = Url.Action("Create", "Farms");
    }
    var list = Model?.ToList() ?? new List<FarmListViewModel>();
}

<div class="mob-card">
    <div class="mob-card-title">🔎 Search</div>
    <form method="get" asp-action="MobileIndex">
        <div class="mob-field">
            <input type="text" name="search" value="@search" placeholder="Farm name or code…" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="mob-btn primary" style="flex:1;justify-content:center;">🔍 Search</button>
            <a asp-action="MobileIndex" class="mob-btn" style="flex:1;justify-content:center;background:#f3f4f6;color:#374151;">✕ Clear</a>
        </div>
    </form>
</div>

<div class="mob-list-cards">
    @if (!list.Any())
    {
        <div class="mob-empty">
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <text>No farms match your search.</text>
            }
            else
            {
                <text>No farms yet.</text>
            }
        </div>
    }
    else
    {
        @foreach (var farm in list)
        {
            <div class="mob-list-card">
                <div class="row-top">
                    <div>
                        <code>@farm.Code</code>
                        <div class="pill-stack">
                            @if (farm.IsActive)
                            { <span class="pill ok">Active</span> }
                            else
                            { <span class="pill idle">Inactive</span> }
                            @if (!string.IsNullOrWhiteSpace(farm.City))
                            { <span class="pill info">@farm.City</span> }
                        </div>
                    </div>
                    <div class="val-right">
                        <div class="amt">@farm.Currency</div>
                        <div class="sub">@farm.IsActive.ToString()</div>
                    </div>
                </div>
                <div class="body-copy" style="font-weight:700;color:var(--ink-900);">@farm.Name</div>
                @if (!string.IsNullOrWhiteSpace(farm.ManagerInfo))
                {
                    <div class="meta-caption">👤 Manager: @farm.ManagerInfo</div>
                }
                <div class="row-actions">
                    <a asp-action="Details" asp-route-id="@farm.Id" class="mob-btn">👁 View</a>
                    @if (caps.CanEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@farm.Id" class="mob-btn primary">✏️ Edit</a>
                    }
                    @if (caps.CanArchive)
                    {
                        <form asp-action="Archive" asp-route-id="@farm.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to archive this farm?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="mob-btn danger">🗄️ Archive</button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</div>
