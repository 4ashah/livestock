@using LivestockManager.Web.Models.FarmViewModels
@model FarmCreateEditViewModel
@{
    ViewData["Title"] = "Edit Farm";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <h1 class="h2">✏️ Edit Farm</h1>
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info me-2">View Details</a>
        <a asp-action="Index" class="btn btn-outline-secondary">← Back to List</a>
    </div>
</div>

@if (ViewContext.ModelState != null && ViewContext.ModelState.Any(x => x.Value != null && x.Value.Errors != null && x.Value.Errors.Count > 0))
{
    <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4 p-lg-5">
        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="Id" />

            <div class="row g-4">
                <div class="col-lg-6">
                    <h5 class="mb-3 text-primary border-bottom pb-2">Farm Information</h5>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Green Valley Pastures" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control" placeholder="e.g. FARM01 (alphanumeric only)" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                        <div class="form-text">Unique farm code used across the system (2-50 characters).</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Currency" class="form-label"></label>
                            <select asp-for="Currency" class="form-select" asp-items="Html.GetEnumSelectList<Currency>()"></select>
                            <span asp-validation-for="Currency" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WeightUnit" class="form-label"></label>
                            <select asp-for="WeightUnit" class="form-select" asp-items="Html.GetEnumSelectList<WeightUnit>()"></select>
                            <span asp-validation-for="WeightUnit" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                            <div class="form-text">Inactive farms are hidden from selection lists.</div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <h5 class="mb-3 text-primary border-bottom pb-2">Address</h5>

                    <div class="mb-3">
                        <label asp-for="Street1" class="form-label"></label>
                        <input asp-for="Street1" class="form-control" placeholder="Street address" />
                        <span asp-validation-for="Street1" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Street2" class="form-label"></label>
                        <input asp-for="Street2" class="form-control" placeholder="Apartment, suite, unit, etc. (optional)" />
                        <span asp-validation-for="Street2" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label"></label>
                            <input asp-for="State" class="form-control" placeholder="State / Province" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PostalCode" class="form-label"></label>
                            <input asp-for="PostalCode" class="form-control" placeholder="Postal / Zip code" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label"></label>
                            <input asp-for="Country" class="form-control" placeholder="Country" />
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-5 pt-4 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-primary px-5">💾 Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
