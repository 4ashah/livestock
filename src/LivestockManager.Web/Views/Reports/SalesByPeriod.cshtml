@using LivestockManager.Application.DTOs.Customers
@using LivestockManager.Application.DTOs.Farms
@using LivestockManager.Application.DTOs.Reports
@using LivestockManager.Domain.Enums
@model SalesByPeriodReportDto
@{
    ViewData["Title"] = "Sales by Period";
    var from = ViewData["From"] as string;
    var to = ViewData["To"] as string;
    var farms = ViewData["Farms"] as IList<FarmSummaryDto> ?? new List<FarmSummaryDto>();
    var farmId = ViewData["FarmId"] as Guid?;
    var customers = ViewData["Customers"] as IList<CustomerSummaryDto> ?? new List<CustomerSummaryDto>();
    var customerId = ViewData["CustomerId"] as Guid?;
    var status = ViewData["Status"] as string;
    var showAdditionalCosts = Model.TotalAdditionalSaleCosts > 0;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">💸 Sales by Period</h1>
        <div class="text-muted small">
            <span class="badge bg-info text-dark me-2">Date Basis: Sale Date</span>
            @from → @to ·
            <strong>@Model.TotalNumberSold.ToString("N0")</strong> Number Sold ·
            Gross <strong>$@Model.TotalGrossSalesAmount.ToString("F2")</strong>
        </div>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary">← Reports</a>
        <a asp-action="SalesByPeriod"
           asp-route-format="csv"
           asp-route-from="@from"
           asp-route-to="@to"
           asp-route-farmId="@(farmId.HasValue ? farmId.ToString() : "")"
           asp-route-customerId="@(customerId.HasValue ? customerId.ToString() : "")"
           asp-route-status="@status"
           class="btn btn-outline-success">⬇ Export CSV</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="SalesByPeriod" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold mb-1">From Date</label>
                <input type="date" name="from" class="form-control" value="@from" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold mb-1">To Date</label>
                <input type="date" name="to" class="form-control" value="@to" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold mb-1">Farm</label>
                <select name="farmId" class="form-select">
                    <option value="">All Farms</option>
                    @foreach (var f in farms)
                    {
                        var selected = farmId == f.Id;
                        <option value="@f.Id" selected="@selected">@f.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold mb-1">Customer</label>
                <select name="customerId" class="form-select">
                    <option value="">All Customers</option>
                    @foreach (var c in customers)
                    {
                        var selected = customerId == c.Id;
                        <option value="@c.Id" selected="@selected">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="Confirmed" selected="@(status == "Confirmed")">Confirmed</option>
                    <option value="Completed" selected="@(status == "Completed")">Completed</option>
                </select>
            </div>
            <div class="col-6 col-md-1">
                <button class="btn btn-outline-secondary w-100" type="submit">🔍 Apply</button>
            </div>
            <div class="col-6 col-md-1">
                <a asp-action="SalesByPeriod" class="btn btn-outline-danger w-100">✕ Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold mb-1">Total Number Sold</div>
                <div class="fs-3 fw-bold">@Model.TotalNumberSold.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold mb-1">Total Gross Sales Amount</div>
                <div class="fs-3 fw-bold text-success">$@Model.TotalGrossSalesAmount.ToString("F2")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100 @(showAdditionalCosts ? "" : "opacity-75")">
            <div class="card-body">
                <div class="text-muted small fw-semibold mb-1">
                    Total Additional Sale Costs
                    @if (!showAdditionalCosts)
                    { <span class="badge bg-light text-dark border ms-1">None</span> }
                </div>
                <div class="fs-3 fw-bold text-warning">$@Model.TotalAdditionalSaleCosts.ToString("F2")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold mb-1">Total Net Sale Proceeds</div>
                <div class="fs-3 fw-bold text-primary">$@Model.TotalNetSaleProceeds.ToString("F2")</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-2">
        <h6 class="mb-0 fw-semibold">Farm-Level Summary</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Farm</th>
                        <th class="text-end">Number Sold</th>
                        <th class="text-end">Gross Sales Amount</th>
                        <th class="text-end">Additional Sale Costs</th>
                        <th class="text-end">Net Sale Proceeds</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fs in Model.FarmSummaries)
                    {
                        <tr>
                            <td class="fw-semibold">@fs.FarmName</td>
                            <td class="text-end">@fs.NumberSold.ToString("N0")</td>
                            <td class="text-end fw-semibold text-success">$@fs.GrossSalesAmount.ToString("F2")</td>
                            <td class="text-end text-warning">$@(fs.AdditionalSaleCosts ?? 0).ToString("F2")</td>
                            <td class="text-end fw-bold text-primary">$@(fs.NetSaleProceeds ?? 0).ToString("F2")</td>
                        </tr>
                    }
                    @if (Model.FarmSummaries.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted small">No farm summary data for this period.</td></tr>
                    }
                </tbody>
                @if (Model.FarmSummaries.Count > 0)
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>TOTAL</td>
                            <td class="text-end">@Model.TotalNumberSold.ToString("N0")</td>
                            <td class="text-end text-success">$@Model.TotalGrossSalesAmount.ToString("F2")</td>
                            <td class="text-end text-warning">$@Model.TotalAdditionalSaleCosts.ToString("F2")</td>
                            <td class="text-end text-primary">$@Model.TotalNetSaleProceeds.ToString("F2")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-2">
        <h6 class="mb-0 fw-semibold">Sale Details</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Sale Date</th>
                        <th>Sale Number</th>
                        <th>Sale Farm</th>
                        <th>Customer</th>
                        <th class="text-end">Number Sold</th>
                        <th class="text-end">Gross Sale Amount</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.SaleDetails)
                    {
                        var displaySaleNumber = !string.IsNullOrWhiteSpace(s.SaleNumber)
                            ? s.SaleNumber
                            : $"SALE-{s.SaleId.ToString("N")[..8].ToUpperInvariant()}";
                        if (s.Status == SaleStatus.Reversed)
                        {
                            displaySaleNumber = "↶ REVERSED · " + displaySaleNumber;
                        }
                        <tr>
                            <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>
                            <td><code>@displaySaleNumber</code></td>
                            <td>@s.FarmName</td>
                            <td>@s.CustomerName</td>
                            <td class="text-end">@s.NumberSold.ToString("N0")</td>
                            <td class="text-end fw-semibold">$@s.GrossSaleAmount.ToString("F2")</td>
                            <td>
                                @if (s.Status == SaleStatus.Draft)
                                { <span class="badge bg-light text-dark border">Draft</span> }
                                else if (s.Status == SaleStatus.Confirmed)
                                { <span class="badge bg-success">Confirmed</span> }
                                else if (s.Status == SaleStatus.Completed)
                                { <span class="badge bg-primary">Completed</span> }
                                else if (s.Status == SaleStatus.Cancelled)
                                { <span class="badge bg-secondary">Cancelled</span> }
                                else if (s.Status == SaleStatus.Reversed)
                                { <span class="badge bg-warning text-dark">↶ Reversed</span> }
                                else
                                { <span class="badge bg-secondary">@s.Status</span> }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@s.SaleId" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                    @if (Model.SaleDetails.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted small">No sales data for this period.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
