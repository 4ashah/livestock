@using LivestockManager.Application.DTOs.Farms
@using LivestockManager.Application.DTOs.Reports
@using LivestockManager.Domain.Helpers
@model IList<ActiveLivestockByTypeReportDto>
@{
    ViewData["Title"] = "Active Livestock by Type";
    var farms = ViewData["Farms"] as IList<FarmSummaryDto> ?? new List<FarmSummaryDto>();
    var farmId = ViewData["FarmId"] as Guid?;
    var selFarm = farmId.HasValue && farmId != Guid.Empty;
    var total = Model.Sum(r => r.Count);
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">🐑 Active Livestock by Type</h1>
        <div class="text-muted small">Total active: <strong>@total.ToString("N0")</strong> @(selFarm ? "· filtered by farm" : "")</div>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary">← Reports</a>
        <a asp-action="ActiveLivestock" asp-route-format="csv" asp-route-farmId="@(farmId.HasValue ? farmId.ToString() : "")" class="btn btn-outline-success">⬇ Export CSV</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="ActiveLivestock" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold mb-1">Farm</label>
                <select name="farmId" class="form-select">
                    <option value="">All Farms</option>
                    @foreach (var f in farms)
                    {
                        var selected = farmId == f.Id;
                        <option value="@f.Id" selected="@selected">@f.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button class="btn btn-outline-secondary w-100" type="submit">🔍 Apply</button>
            </div>
            <div class="col-6 col-md-2">
                <a asp-action="ActiveLivestock" class="btn btn-outline-danger w-100">✕ Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Livestock Type</th>
                        <th class="text-end">Number Active</th>
                        <th class="text-end">% of Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@LivestockTypeDisplay.GetDisplayName(r.LivestockType)</td>
                            <td class="text-end fs-5 fw-bold">@r.Count.ToString("N0")</td>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-2">
                                    <div class="progress" style="width: 120px; height: 8px;">
                                        <div class="progress-bar bg-success" style="width: @r.PercentageOfTotal%;"></div>
                                    </div>
                                    <span class="small">@PercentageDisplay.Format(r.PercentageOfTotal / 100m)</span>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center py-5 text-muted small">No active livestock found for these filters.</td></tr>
                    }
                </tbody>
                @if (Model.Count > 0)
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>Total</td>
                            <td class="text-end">@total.ToString("N0")</td>
                            <td class="text-end">100%</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
