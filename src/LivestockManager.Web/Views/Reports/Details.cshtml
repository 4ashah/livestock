@model int
@{ ViewData["Title"] = "Report"; }
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <h1 class="h2">Report #@Model</h1>
    <div><a asp-action="Index" class="btn btn-outline-secondary">← All Reports</a></div>
</div>
<div class="card shadow-sm border-0"><div class="card-body p-5 text-center text-muted">
    <div class="display-6 mb-3">📊</div>
    <div class="h5 mb-2">Report Results Placeholder</div>
    <div class="small">Report chart, table, filters, export as PDF/XLSX/CSV.</div>
</div></div>
