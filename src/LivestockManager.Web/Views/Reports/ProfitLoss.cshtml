@model LivestockManager.Application.DTOs.Reports.ProfitLossReportDto
@{
    ViewData["Title"] = "Profit & Loss";
    var from = ViewData["From"] as string;
    var to = ViewData["To"] as string;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">💰 Profit &amp; Loss</h1>
        <div class="text-muted small">
            @from → @to
            <span class="mx-2">·</span>
            @if (Model.NetProfit >= 0)
            { <span class="fw-bold text-success">Net Profit $@Model.NetProfit.ToString("F2")</span> }
            else
            { <span class="fw-bold text-danger">Net Loss $@Math.Abs(Model.NetProfit).ToString("F2")</span> }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">← Reports</a>
        <a asp-action="ProfitLoss" asp-route-format="csv" asp-route-from="@from" asp-route-to="@to" class="btn btn-outline-success">⬇ Export CSV</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="ProfitLoss" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">From</label>
                <input type="date" name="from" class="form-control" value="@from" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">To</label>
                <input type="date" name="to" class="form-control" value="@to" />
            </div>
            <div class="col-md-2">
                <div class="d-grid gap-2 d-md-flex">
                    <button class="btn btn-outline-secondary w-100" type="submit">🔍 Apply</button>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <span class="badge bg-light text-dark border me-2">MTD</span>
                <a asp-action="ProfitLoss" asp-route-from="@(DateTime.Today.AddMonths(-1).ToString("yyyy-MM-01"))" asp-route-to="@(DateTime.Today.AddMonths(-1).AddDays(1 - DateTime.Today.Day).ToString("yyyy-MM-dd"))" class="badge bg-light text-dark border text-decoration-none me-2" style="cursor:pointer;">Last Mo</a>
                <a asp-action="ProfitLoss" asp-route-from="@(DateTime.Today.AddYears(-1).ToString("yyyy-01-01"))" asp-route-to="@(DateTime.Today.AddYears(-1).ToString("yyyy-12-31"))" class="badge bg-light text-dark border text-decoration-none me-2" style="cursor:pointer;">Last Yr</a>
                <a asp-action="ProfitLoss" asp-route-from="@(DateTime.Today.ToString("yyyy-01-01"))" asp-route-to="@(DateTime.Today.ToString("yyyy-12-31"))" class="badge bg-light text-dark border text-decoration-none" style="cursor:pointer;">YTD</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0 fw-semibold">Revenue</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <div>
                        <div class="fw-semibold">Total Sales</div>
                        <div class="small text-muted">@Model.SalesCount transactions · @Model.SoldHead head sold</div>
                    </div>
                    <div class="text-end">
                        <div class="fs-5 fw-bold text-success">$@Model.TotalSales.ToString("F2")</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between py-2 small text-muted">
                    <div>Sales status: Confirmed / Invoiced only</div>
                    <div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0 fw-semibold">Cost of Goods</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <div>
                        <div class="fw-semibold">Total Purchases (Posted)</div>
                        <div class="small text-muted">@Model.PurchaseCount transactions</div>
                    </div>
                    <div class="text-end">
                        <div class="fs-5 fw-bold text-danger">$@Model.TotalPurchases.ToString("F2")</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between py-2 small">
                    <div class="fw-semibold text-success-emphasis">Gross Profit (Sales − Purchases)</div>
                    <div class="fw-bold @(Model.GrossProfit >= 0 ? "text-success" : "text-danger")">@(Model.GrossProfit >= 0 ? "+" : "-")$@Math.Abs(Model.GrossProfit).ToString("F2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0 fw-semibold">Operating Expenses</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <div>
                        <div class="fw-semibold">Total Expenses</div>
                        <div class="small text-muted">@Model.ExpenseCount records</div>
                    </div>
                    <div class="text-end">
                        <div class="fs-5 fw-bold text-danger">$@Model.TotalExpenses.ToString("F2")</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between py-2 small">
                    <div class="fw-semibold">Operating Profit (Gross − Expenses)</div>
                    <div class="fw-bold @(Model.OperatingProfit >= 0 ? "text-success" : "text-danger")">@(Model.OperatingProfit >= 0 ? "+" : "-")$@Math.Abs(Model.OperatingProfit).ToString("F2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 border-start border-4 @(Model.TotalLosses > 0 ? "border-danger" : "border-success") h-100">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0 fw-semibold">Livestock Losses</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <div>
                        <div class="fw-semibold">Book-value Loss</div>
                        <div class="small text-muted">@Model.LossCount loss records · @Model.LostHead head discharged (Lost/Stolen/Deceased/Other)</div>
                    </div>
                    <div class="text-end">
                        <div class="fs-5 fw-bold text-danger">$@Model.TotalLosses.ToString("F2")</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <div class="fw-semibold text-success-emphasis">Net Profit (Op. − Losses)</div>
                    <div class="fw-bold @(Model.NetProfit >= 0 ? "text-success" : "text-danger") fs-5">@(Model.NetProfit >= 0 ? "+" : "-")$@Math.Abs(Model.NetProfit).ToString("F2")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-2">
        <h6 class="mb-0 fw-semibold">Summary</h6>
    </div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="table-light">
                <tr>
                    <th>Line</th>
                    <th>Notes</th>
                    <th>Count</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold">Revenue: Sales</td>
                    <td class="small text-muted">Confirmed + Invoiced sales, GrandTotal</td>
                    <td>@Model.SalesCount.ToString("N0")</td>
                    <td class="text-end fw-semibold text-success">$@Model.TotalSales.ToString("F2")</td>
                </tr>
                <tr>
                    <td class="fw-semibold text-danger">− Purchases (COGS)</td>
                    <td class="small text-muted">Posted purchases only</td>
                    <td>@Model.PurchaseCount.ToString("N0")</td>
                    <td class="text-end fw-semibold text-danger">−$@Model.TotalPurchases.ToString("F2")</td>
                </tr>
                <tr class="table-light fw-bold">
                    <td colspan="2">Gross Profit</td>
                    <td></td>
                    <td class="text-end @(Model.GrossProfit >= 0 ? "text-success" : "text-danger")">$@Model.GrossProfit.ToString("F2")</td>
                </tr>
                <tr>
                    <td class="fw-semibold text-danger">− Operating Expenses</td>
                    <td class="small text-muted">All non-deleted expense records</td>
                    <td>@Model.ExpenseCount.ToString("N0")</td>
                    <td class="text-end fw-semibold text-danger">−$@Model.TotalExpenses.ToString("F2")</td>
                </tr>
                <tr>
                    <td class="fw-semibold text-danger">− Livestock Losses (book value)</td>
                    <td class="small text-muted">Non-reversed losses, LossAmount</td>
                    <td>@Model.LossCount.ToString("N0")  (@Model.LostHead.ToString("N0") head)</td>
                    <td class="text-end fw-semibold text-danger">−$@Model.TotalLosses.ToString("F2")</td>
                </tr>
                <tr class="table-light fw-bold fs-5">
                    <td colspan="2">Net Profit (Loss)</td>
                    <td></td>
                    <td class="text-end @(Model.NetProfit >= 0 ? "text-success" : "text-danger")">@(Model.NetProfit >= 0 ? "$" : "−$")@Math.Abs(Model.NetProfit).ToString("F2")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
