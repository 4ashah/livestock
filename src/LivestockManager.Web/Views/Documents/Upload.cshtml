@using LivestockManager.Domain.Enums
@using LivestockManager.Web.Models.DocumentViewModels
@model UploadDocumentViewModel
@{
    ViewData["Title"] = "Upload Documents";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <h1 class="h2">📎 Upload Documents</h1>
    <div>
        <a asp-action="List" asp-route-entityType="@Model.EntityTypeStr" asp-route-entityId="@Model.EntityIdStr"
           class="btn btn-outline-secondary">&larr; Back to List</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

            <input type="hidden" asp-for="EntityTypeStr" />
            <input type="hidden" asp-for="EntityIdStr" />

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="DocumentType" class="form-label fw-semibold">Document Type</label>
                    <select asp-for="DocumentType" class="form-select"
                            asp-items="Html.GetEnumSelectList<DocumentType>()"></select>
                    <span asp-validation-for="DocumentType" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Files</label>
                    <div class="border border-2 border-dashed rounded p-5 text-center bg-light">
                        <div class="display-5 mb-2 text-muted">📂</div>
                        <div class="h6 mb-1">Drag and drop files here, or click to browse</div>
                        <div class="small text-muted mb-3">
                            Allowed: .pdf, .jpg, .jpeg, .png, .doc, .docx, .xls, .xlsx, .csv (max 25 MB each)
                        </div>
                        <input asp-for="Files" type="file" multiple class="form-control d-none" id="fileInput" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx,.csv" />
                        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('fileInput').click()">
                            Choose Files
                        </button>
                        <div id="fileList" class="mt-3 text-start small text-muted"></div>
                    </div>
                    <span asp-validation-for="Files" class="text-danger small d-block mt-1"></span>
                </div>
            </div>

            <div class="row mt-5">
                <div class="col-12 text-end">
                    <a asp-action="List" asp-route-entityType="@Model.EntityTypeStr"
                       asp-route-entityId="@Model.EntityIdStr"
                       class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('fileInput').addEventListener('change', function (e) {
        var files = e.target.files;
        var listEl = document.getElementById('fileList');
        if (!files || files.length === 0) {
            listEl.textContent = '';
            return;
        }
        var names = [];
        for (var i = 0; i < files.length; i++) {
            var f = files[i];
            var size = (f.size / 1024 / 1024).toFixed(2);
            names.push(f.name + ' (' + size + ' MB)');
        }
        listEl.textContent = names.length + ' file(s) selected: ' + names.join(', ');
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
