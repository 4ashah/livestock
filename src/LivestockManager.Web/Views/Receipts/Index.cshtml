@model ReceiptListViewModel
@{
    ViewData["Title"] = "Receipts";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">🧾 Receipts</h1>
        <div class="text-muted small">Receipts generated from payments</div>
    </div>
    <a asp-controller="Payments" asp-action="Index" class="btn btn-primary"><span class="me-1">🧾</span> Generate From Payment</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Receipt #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Payment Method</th>
                        <th class="text-end">Amount Received</th>
                        <th class="text-end">Running Balance</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><code>@item.ReceiptNumber</code></td>
                            <td>@item.ReceiptDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.CustomerName</td>
                            <td>
                                <a asp-controller="Payments" asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-sm btn-outline-secondary">(view)</a>
                            </td>
                            <td class="text-end fw-semibold text-success">$@item.AmountReceived.ToString("F2")</td>
                            <td class="text-end">$@item.RunningInvoiceBalance.ToString("F2")</td>
                            <td>
                                @if (item.Status == ReceiptStatus.Issued)
                                {
                                    <span class="badge bg-success">Issued</span>
                                }
                                else if (item.Status == ReceiptStatus.Reversed)
                                {
                                    <span class="badge bg-secondary">Reversed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Receipts" asp-action="DownloadPdf" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Download</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted small">No receipts found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
