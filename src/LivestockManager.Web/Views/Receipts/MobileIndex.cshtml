@model ReceiptListViewModel
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Receipts";
    ViewData["PageIcon"] = "🧾";
    ViewData["PageSubtitle"] = "Receipts generated from payments";
    ViewData["DockKey"] = "receipts";
    ViewData["ActionLabel"] = "Generate";
    ViewData["ActionIcon"] = "🧾";
    ViewData["ActionUrl"] = Url.Action("MobileIndex", "Payments");
    var list = Model.Items?.ToList() ?? new List<LivestockManager.Application.DTOs.Receipts.ReceiptSummaryDto>();
    var total = list.Sum(x => x.AmountReceived);
}

<div class="mob-totals-card">
    <div class="label">Amount Received</div>
    <div class="total">$@total.ToString("N2")</div>
    <div class="breakdown">
        <div><div class="k">Receipts</div><div class="v">@list.Count</div></div>
        <div><div class="k">Issued</div><div class="v">@list.Count(x => x.Status == ReceiptStatus.Issued)</div></div>
    </div>
</div>

<div class="mob-list-cards">
    @if (!list.Any())
    {
        <div class="mob-empty">No receipts found. Tap Generate to create one from a payment.</div>
    }
    else
    {
        @foreach (var item in list)
        {
            var statusPill = item.Status == ReceiptStatus.Issued
                ? ("Issued", "ok")
                : item.Status == ReceiptStatus.Reversed
                    ? ("Reversed", "bad")
                    : (item.Status.ToString(), "idle");
            <div class="mob-list-card">
                <div class="row-top">
                    <div>
                        <code>@item.ReceiptNumber</code>
                        <div class="pill-stack">
                            <span class="pill @statusPill.Item2">@statusPill.Item1</span>
                        </div>
                    </div>
                    <div class="val-right">
                        <div class="amt">$@item.AmountReceived.ToString("F2")</div>
                        <div class="sub">@item.ReceiptDate.ToString("yyyy-MM-dd")</div>
                    </div>
                </div>
                <div class="body-copy" style="font-weight:700;color:var(--ink-900);">@item.CustomerName</div>
                <div class="rows">
                    <div class="cell">
                        <div class="label">Running Balance</div>
                        <div class="val">$@item.RunningInvoiceBalance.ToString("F2")</div>
                    </div>
                    <div class="cell">
                        <div class="label">Payment</div>
                        <div class="val">
                            <a asp-controller="Payments" asp-action="Details" asp-route-id="@item.PaymentId" style="color:var(--brand);">View</a>
                        </div>
                    </div>
                </div>
                <div class="row-actions">
                    <a asp-action="DownloadPdf" asp-route-id="@item.Id" class="mob-btn primary">⬇ Download</a>
                </div>
            </div>
        }
    }
</div>
