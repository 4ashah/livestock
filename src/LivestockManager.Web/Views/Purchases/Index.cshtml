@model IEnumerable<LivestockManager.Application.DTOs.Purchases.PurchaseSummaryDto>
@{
    ViewData["Title"] = "Purchases";
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
    var suppliers = ViewData["Suppliers"] as System.Collections.IEnumerable;
    var selSupplierId = ViewData["SupplierId"] as Guid?;
    var selStatus = ViewData["Status"] as PurchaseStatus?;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">🛒 Purchases</h1>
        <div class="text-muted small">Supplier purchases, livestock buy-ins and payables</div>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn btn-primary"><span class="me-1">+</span> New Purchase</a>
    }
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">From</label>
                <input type="date" name="from" class="form-control" value="@ViewData["From"]" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">To</label>
                <input type="date" name="to" class="form-control" value="@ViewData["To"]" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Supplier</label>
                <select name="supplierId" class="form-select">
                    <option value="">All Suppliers</option>
                    @if (suppliers != null)
                    {
                        @foreach (var s in (IEnumerable<dynamic>)suppliers)
                        {
                            Guid sid = s.Id;
                            if (selSupplierId == sid)
                            {
                                <option value="@s.Id" selected>@s.Name</option>
                            }
                            else
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="status" class="form-select">
                    <option value="">Any</option>
                    @{
                        var allStatuses = Enum.GetValues(typeof(PurchaseStatus)).Cast<PurchaseStatus>().ToList();
                        foreach (var st in allStatuses)
                        {
                            var isSelected = selStatus == st;
                            if (isSelected)
                            {
                                <option value="@((int)st)" selected>@st.ToString()</option>
                            }
                            else
                            {
                                <option value="@((int)st)">@st.ToString()</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary w-100" type="submit">🔍 Filter</button>
                    <a asp-action="Index" class="btn btn-outline-danger">✕</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Purchase #</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th class="text-end">Grand Total</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><code>@p.PurchaseNumber</code></td>
                            <td>@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td>@p.SupplierName</td>
                            <td class="text-end fw-semibold">$@p.GrandTotal.ToString("F2")</td>
                            <td>
                                @if (p.Status == PurchaseStatus.Draft)
                                { <span class="badge bg-light text-dark border">Draft</span> }
                                else if (p.Status == PurchaseStatus.Posted)
                                { <span class="badge bg-success">Posted</span> }
                                else if (p.Status == PurchaseStatus.Voided)
                                { <span class="badge bg-secondary">Voided</span> }
                                else
                                { <span class="badge bg-info text-dark">@p.Status</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(p.PaymentStatus))
                                {
                                    if (p.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase))
                                    { <span class="badge bg-success">Paid</span> }
                                    else if (p.PaymentStatus.Equals("Partial", StringComparison.OrdinalIgnoreCase))
                                    { <span class="badge bg-warning text-dark">Partial</span> }
                                    else
                                    { <span class="badge bg-danger">Unpaid</span> }
                                }
                                else
                                { <span class="badge bg-danger">Unpaid</span> }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted small">No purchases found. Use <strong>+ New Purchase</strong> to record a supplier buy or livestock purchase.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
