@model IEnumerable<LivestockManager.Application.DTOs.Sales.SaleSummaryDto>
@{
    ViewData["Title"] = "Sales";
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
    var customers = ViewData["Customers"] as System.Collections.IEnumerable;
    var selCustomerId = ViewData["CustomerId"] as Guid?;
    var selStatus = ViewData["Status"] as SaleStatus?;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">💼 Sales</h1>
        <div class="text-muted small">Sales orders and invoice generation</div>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn btn-primary"><span class="me-1">+</span> New Sale</a>
    }
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">From</label>
                <input type="date" name="from" class="form-control" value="@ViewData["From"]" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">To</label>
                <input type="date" name="to" class="form-control" value="@ViewData["To"]" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Customer</label>
                <select name="customerId" class="form-select">
                    <option value="">All Customers</option>
                    @if (customers != null)
                    {
                        @foreach (var c in (IEnumerable<dynamic>)customers)
                        {
                            Guid cid = c.Id;
                            if (selCustomerId == cid)
                            {
                                <option value="@c.Id" selected>@c.Name</option>
                            }
                            else
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="status" class="form-select">
                    <option value="">Any</option>
                    @if (selStatus == SaleStatus.Draft)
                    {
                        <option value="@((int)SaleStatus.Draft)" selected>Draft</option>
                    }
                    else
                    {
                        <option value="@((int)SaleStatus.Draft)">Draft</option>
                    }
                    @if (selStatus == SaleStatus.Confirmed)
                    {
                        <option value="@((int)SaleStatus.Confirmed)" selected>Confirmed</option>
                    }
                    else
                    {
                        <option value="@((int)SaleStatus.Confirmed)">Confirmed</option>
                    }
                    @if (selStatus == SaleStatus.Cancelled)
                    {
                        <option value="@((int)SaleStatus.Cancelled)" selected>Cancelled</option>
                    }
                    else
                    {
                        <option value="@((int)SaleStatus.Cancelled)">Cancelled</option>
                    }
                    @if (selStatus == SaleStatus.Reversed)
                    {
                        <option value="@((int)SaleStatus.Reversed)" selected>↶ Reversed</option>
                    }
                    else
                    {
                        <option value="@((int)SaleStatus.Reversed)">↶ Reversed</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary w-100" type="submit">🔍 Filter</button>
                    <a asp-action="Index" class="btn btn-outline-danger">✕</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sale #</th>
                        <th>Date</th>
                        <th>Farm</th>
                        <th>Customer</th>
                        <th class="text-end">Grand Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var displaySaleNumber = !string.IsNullOrWhiteSpace(s.SaleNumber)
                            ? s.SaleNumber
                            : (s.Status == SaleStatus.Draft
                                ? $"DRAFT-{s.Id.ToString("N")[..8].ToUpperInvariant()}"
                                : (s.Status == SaleStatus.Cancelled
                                    ? $"VOID-{s.Id.ToString("N")[..8].ToUpperInvariant()}"
                                    : (s.Status == SaleStatus.Reversed
                                        ? $"REVERSED-{s.Id.ToString("N")[..8].ToUpperInvariant()}"
                                        : $"SALE-{s.Id.ToString("N")[..8].ToUpperInvariant()}")));
                        <tr>
                            <td><code title="@(string.IsNullOrWhiteSpace(s.SaleNumber) ? $"Internal Id: {s.Id}" : null)">@displaySaleNumber</code></td>
                            <td>@s.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (s.FarmId.HasValue)
                                {
                                    if (!string.IsNullOrWhiteSpace(s.FarmName))
                                    { <span title="Farm Id: @s.FarmId.Value">@s.FarmName</span> }
                                    else
                                    { <code title="Farm deleted or not found.">@s.FarmId.Value</code> }
                                }
                                else
                                { <span class="text-muted">—</span> }
                            </td>
                            <td>@s.CustomerName</td>
                            <td class="text-end fw-semibold">$@s.GrandTotal.ToString("F2")</td>
                            <td>
                                @if (s.Status == SaleStatus.Draft)
                                { <span class="badge bg-light text-dark border">Draft</span> }
                                else if (s.Status == SaleStatus.Confirmed)
                                { <span class="badge bg-success">Confirmed</span> }
                                else if (s.Status == SaleStatus.Completed)
                                { <span class="badge bg-primary">Completed</span> }
                                else if (s.Status == SaleStatus.Reversed)
                                { <span class="badge bg-danger">↶ Reversed</span> }
                                else
                                { <span class="badge bg-secondary">Cancelled</span> }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted small">No sales found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
