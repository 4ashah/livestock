@model int
@{ ViewData["Title"] = "Edit Sale"; }
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <h1 class="h2">Edit Sale #@Model</h1>
    <div><a asp-action="Details" asp-route-id="@Model" class="btn btn-outline-primary me-2">Details</a><a asp-action="Index" class="btn btn-outline-secondary">← Back</a></div>
</div>
<div class="card shadow-sm border-0"><div class="card-body p-5 text-center text-muted">
    <div class="display-6 mb-3">✏️</div>
    <div class="h5 mb-2">Edit Sale — Placeholder Form</div>
    <div class="small">Update sale details and line items before confirmation.</div>
</div></div>
