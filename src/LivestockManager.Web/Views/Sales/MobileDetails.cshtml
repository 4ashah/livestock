@model LivestockManager.Application.DTOs.Sales.SaleDetailDto
@using LivestockManager.Domain.Enums
@using LivestockManager.Domain.Helpers
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Sale Details";
    ViewData["PageIcon"] = "🧾";
    ViewData["PageSubtitle"] = "Sale order & invoice totals";
    ViewData["DockKey"] = "sales";
    ViewData["BackUrl"] = Url.Action("MobileIndex", "Sales");
    ViewData["BackLabel"] = "Sales";
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
    var invoiceId = ViewData["InvoiceId"] as Guid?;
    string DisplaySaleNumber()
    {
        if (!string.IsNullOrWhiteSpace(Model.SaleNumber)) return Model.SaleNumber;
        var shortId = Model.Id.ToString("N")[..8].ToUpperInvariant();
        return Model.Status switch
        {
            SaleStatus.Draft => $"DRAFT-{shortId}",
            SaleStatus.Cancelled => $"VOID-{shortId}",
            SaleStatus.Reversed => $"REVERSED-{shortId}",
            _ => $"SALE-{shortId}"
        };
    }
    string StatusBadgeClass()
    {
        return Model.Status switch
        {
            SaleStatus.Draft => "bg-light text-dark border",
            SaleStatus.Confirmed => "bg-success",
            SaleStatus.Cancelled => "bg-secondary",
            SaleStatus.Reversed => "bg-danger",
            _ => "bg-secondary"
        };
    }
    string StatusText()
    {
        return Model.Status switch
        {
            SaleStatus.Draft => "Draft",
            SaleStatus.Confirmed => "Confirmed",
            SaleStatus.Cancelled => "Cancelled",
            SaleStatus.Reversed => "↶ Reversed",
            _ => Model.Status.ToString()
        };
    }
}

<div class="mob-status-card mb-3">
    <div class="row g-3">
        <div class="col-12">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge fs-6 px-3 py-1 @StatusBadgeClass()">@StatusText()</span>
                <h1 class="h5 mb-0 fw-bold flex-grow-1">Sale @DisplaySaleNumber()</h1>
                @if (string.IsNullOrWhiteSpace(Model.SaleNumber))
                {
                    <small class="text-muted w-100 mt-1" title="Internal Id: @Model.Id">(reference only)</small>
                }
            </div>
            <div class="small text-muted mt-2">@Model.Date.ToString("yyyy-MM-dd") · Customer: @Model.CustomerName</div>
        </div>
    </div>
</div>

@if (Model.Status == SaleStatus.Reversed)
{
    <div class="alert alert-warning border-0 shadow-sm mb-3 small">
        <div class="fw-semibold mb-1">This sale has been reversed.</div>
        @if (!string.IsNullOrWhiteSpace(Model.ReversalReason))
        { <div class="text-muted mb-1">Reason: @Model.ReversalReason</div> }
        @if (!string.IsNullOrWhiteSpace(Model.ReversalNotes))
        { <div class="text-muted">Notes: @Model.ReversalNotes</div> }
        @if (Model.ReversedAt.HasValue)
        { <div class="text-muted mt-2">Reversed @Model.ReversedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div> }
    </div>
}

<div class="mob-card mb-3">
    <div class="mob-card-header">
        <div class="mob-card-title">👥 Customer</div>
    </div>
    <div class="mob-card-body">
        <dl class="mob-dl mb-0">
            <div>
                <dt>Customer</dt>
                <dd>@Model.CustomerName</dd>
            </div>
            <div>
                <dt>Farm</dt>
                <dd>
                    @if (Model.FarmId.HasValue)
                    {
                        if (!string.IsNullOrWhiteSpace(Model.FarmName))
                        { <span title="Farm Id: @Model.FarmId.Value">@Model.FarmName</span> }
                        else
                        { <code title="This farm was deleted or not found; showing internal Id.">@Model.FarmId.Value</code> }
                    }
                    else
                    { <span class="text-muted">N/A</span> }
                </dd>
            </div>
            <div>
                <dt>Notes</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "<span class=\"text-muted\">—</span>" : Model.Notes)</dd>
            </div>
        </dl>
    </div>
</div>

<div class="mob-card mb-3">
    <div class="mob-card-header">
        <div class="mob-card-title">💰 Totals &amp; Proceeds</div>
    </div>
    <div class="mob-card-body">
        <dl class="mob-dl mb-0">
            <div>
                <dt>Gross Subtotal</dt>
                <dd class="text-end">$@Model.Subtotal.ToString("F2")</dd>
            </div>
            <div>
                <dt>Customer Discount</dt>
                <dd class="text-end">- $@Model.DiscountTotal.ToString("F2")</dd>
            </div>
            <div>
                <dt>Customer-Charged Tax</dt>
                <dd class="text-end">+ $@Model.TaxTotal.ToString("F2")</dd>
            </div>
            <hr class="my-1" />
            <div class="fw-bold">
                <dt>Customer Invoice Total</dt>
                <dd class="text-end fw-bold">$@Model.GrandTotal.ToString("F2")</dd>
            </div>
            <hr class="my-2" />
            <div>
                <dt>Seller Commission</dt>
                <dd class="text-end">@(Model.CommissionAmount == 0 ? "<span class=\"text-muted\">—</span>" : ("$" + Model.CommissionAmount.ToString("F2")))</dd>
            </div>
            <div>
                <dt>Seller-Paid Tax</dt>
                <dd class="text-end">@(Model.SellerTaxAmount == 0 ? "<span class=\"text-muted\">—</span>" : ("$" + Model.SellerTaxAmount.ToString("F2")))</dd>
            </div>
            <div>
                <dt>Transportation</dt>
                <dd class="text-end">@(Model.TransportationAmount == 0 ? "<span class=\"text-muted\">—</span>" : ("$" + Model.TransportationAmount.ToString("F2")))</dd>
            </div>
            <div>
                <dt>Other Seller Cost</dt>
                <dd class="text-end">@(Model.OtherCostAmount == 0 ? "<span class=\"text-muted\">—</span>" : ("$" + Model.OtherCostAmount.ToString("F2")))</dd>
            </div>
            @if (Model.OtherCostAmount > 0 && !string.IsNullOrWhiteSpace(Model.OtherCostDescription))
            {
                <div>
                    <dt class="ps-3 small text-muted fst-italic">↳ Other Cost Desc</dt>
                    <dd class="small text-muted">@Model.OtherCostDescription</dd>
                </div>
            }
            <hr class="my-1" />
            <div>
                <dt>Total Seller-Side Costs</dt>
                <dd class="text-end fw-semibold">$@Model.TotalAdditionalSaleCosts.ToString("F2")</dd>
            </div>
            <div class="fw-semibold">
                <dt class="fw-semibold">Net Sale Proceeds</dt>
                <dd class="text-end fw-bold fs-5 text-success">$@Model.NetSaleProceeds.ToString("F2")</dd>
            </div>
        </dl>
    </div>
</div>

<div class="mob-card mb-3">
    <div class="mob-card-header d-flex justify-content-between align-items-center">
        <div class="mob-card-title">📋 Items (@Model.Items.Count)</div>
    </div>
    <div class="table-responsive-mobile">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:2.5rem">#</th>
                    <th>Description</th>
                    <th class="text-end" style="width:4rem">Qty</th>
                    <th class="text-end" style="width:5.5rem">Unit</th>
                    <th class="text-end" style="width:6rem">Line</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (it, idx) in Model.Items.Select((x, i) => (x, i)))
                {
                    <tr>
                        <td class="small text-muted">@(idx + 1)</td>
                        <td>
                            @it.Description
                            @if (it.LivestockId.HasValue)
                            { <span class="badge bg-info ms-1">Livestock</span> }
                            <div class="small text-muted">
                                Disc: @PercentageDisplay.Format(it.DiscountPercent)
                                <span class="mx-1">·</span>
                                Tax: @PercentageDisplay.Format(it.TaxPercent)
                            </div>
                        </td>
                        <td class="text-end">@it.Quantity</td>
                        <td class="text-end">$@it.UnitPrice.ToString("F2")</td>
                        <td class="text-end fw-semibold">$@it.LineTotal.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mob-submit-row">
    <div class="w-100 d-grid gap-2">
        @if (canEdit && Model.Status == SaleStatus.Draft)
        {
            <form action="@Url.Action("Confirm", "Sales", new { id = Model.Id })" method="post">
                <button type="submit" class="mob-btn w-100"
                        onclick="return confirm('Confirm this sale? This will create an invoice and discharge livestock.');">
                    ✅ Confirm Sale &amp; Invoice
                </button>
            </form>
            <form action="@Url.Action("Cancel", "Sales", new { id = Model.Id })" method="post">
                <button type="submit" class="mob-btn outline w-100" style="--btn:#c81d25;--btn-bg:transparent;"
                        onclick="return confirm('Cancel this draft sale?');">
                    Cancel Draft
                </button>
            </form>
        }
        @if (Model.Status == SaleStatus.Confirmed)
        {
            <button type="button" class="mob-btn w-100" style="--btn:#c81d25;--btn-bg:#c81d25;"
                    data-bs-toggle="modal" data-bs-target="#reverseModal">
                ↶ Reverse Confirmed Sale
            </button>
        }
        @if (invoiceId.HasValue && invoiceId != Guid.Empty)
        {
            <a class="mob-btn outline w-100" href="@Url.Action("Details", "Invoices", new { id = invoiceId })">
                📄 View Invoice
            </a>
        }
    </div>
</div>

<div class="modal fade" id="reverseModal" tabindex="-1" aria-labelledby="reverseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form action="@Url.Action("Reverse", "Sales")" method="post" id="reverseForm"
                  onsubmit="return confirm('Are you sure you want to reverse this confirmed sale? Livestock will be restored to Active status. This action is audited and cannot be undone via ordinary edit.');">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="reverseModalLabel">↶ Reverse Confirmed Sale</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="ReversalDate" value="@DateTimeOffset.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <div class="alert alert-warning border-0 bg-warning-subtle mb-3 small">
                        <div class="fw-semibold mb-1">⚠️ Important</div>
                        <div class="mb-1">Reversing this sale will:</div>
                        <ul class="mb-0 ps-3">
                            <li>Restore all discharged livestock to <strong>Active</strong> status</li>
                            <li>Void any associated unpaid invoice</li>
                            <li>Block if payments/receipts have been applied (reverse those first)</li>
                            <li>Be recorded in the audit log with your user identity</li>
                        </ul>
                    </div>
                    <div class="mb-3">
                        <label for="ReversalReason" class="form-label fw-semibold small">Reversal Reason <span class="text-danger">*</span></label>
                        <input type="text" id="ReversalReason" name="ReversalReason" class="form-control" maxlength="500" required
                               placeholder="e.g., Duplicate entry, incorrect customer, returned livestock..."
                               aria-describedby="reasonHelp" />
                        <div id="reasonHelp" class="form-text small">Required. 500 characters maximum. Explain why this sale is being reversed.</div>
                        <div class="invalid-feedback">Please provide a non-empty reason for this reversal.</div>
                    </div>
                    <div class="mb-0">
                        <label for="ReversalNotes" class="form-label fw-semibold small">Additional Notes (optional)</label>
                        <textarea id="ReversalNotes" name="ReversalNotes" class="form-control" rows="3" maxlength="2000"
                                  placeholder="Any additional context, reference numbers, or follow-up actions..."></textarea>
                        <div class="form-text small text-end" id="notesCount">0 / 2000</div>
                    </div>
                </div>
                <div class="modal-footer border-top flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="reverseConfirmBtn">
                        ↶ Confirm Reversal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    try {
        var revModal = document.getElementById('reverseModal');
        if (!revModal) return;
        var reason = document.getElementById('ReversalReason');
        var notes = document.getElementById('ReversalNotes');
        var notesCount = document.getElementById('notesCount');
        var confirmBtn = document.getElementById('reverseConfirmBtn');
        function updateState() {
            var r = (reason.value || '').trim();
            if (confirmBtn) confirmBtn.disabled = r.length === 0;
            if (notesCount) notesCount.textContent = ((notes && notes.value) || '').length + ' / 2000';
        }
        if (reason) reason.addEventListener('input', updateState);
        if (notes) notes.addEventListener('input', updateState);
        revModal.addEventListener('shown.bs.modal', function () {
            if (reason) reason.focus();
            updateState();
        });
        var form = document.getElementById('reverseForm');
        if (form) {
            form.addEventListener('submit', function (e) {
                if (confirmBtn && confirmBtn.disabled) { e.preventDefault(); return; }
                if (confirmBtn) { confirmBtn.disabled = true; confirmBtn.textContent = 'Processing...'; }
            });
        }
        updateState();
    } catch (_) { /* no-op */ }
})();
</script>
}
