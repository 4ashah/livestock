@using LivestockManager.Domain.Enums
@model LivestockManager.Application.DTOs.Sales.SaleCreateDto
@{
    ViewData["Title"] = "New Sale";
    var farms = ViewData["Farms"] as System.Collections.IEnumerable;
    var customers = ViewData["Customers"] as System.Collections.IEnumerable;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">🧾 New Sale</h1>
        <div class="text-muted small">Create a draft sale order — find livestock by search, not scrolling</div>
    </div>
</div>

<form asp-action="Create" method="post" class="row g-3" id="saleForm">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">👥 Customer &amp; Farm</h6>
            </div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Farm *</label>
                    <div class="position-relative">
                        <input id="farmSearch" type="text" class="form-control" placeholder="Search farm by name..." autocomplete="off" />
                        <select asp-for="FarmId" id="farmSelect" class="d-none" required>
                            <option value="">—</option>
                            @if (farms != null)
                            {
                                @foreach (var f in (IEnumerable<LivestockManager.Application.DTOs.Farms.FarmSummaryDto>)farms)
                                {
                                    <option value="@f.Id" data-name="@f.Name">@f.Name</option>
                                }
                            }
                        </select>
                        <ul id="farmDrop" class="dropdown-menu shadow w-100" style="max-height:260px;overflow:auto;display:none;"></ul>
                        <small id="farmPicked" class="text-muted d-none"></small>
                    </div>
                    <span asp-validation-for="FarmId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Customer *</label>
                    <div class="position-relative">
                        <input id="custSearch" type="text" class="form-control" placeholder="Type to search customer…" autocomplete="off" />
                        <select asp-for="CustomerId" id="custSelect" class="d-none" required>
                            <option value="">—</option>
                            @if (customers != null)
                            {
                                @foreach (var c in (IEnumerable<LivestockManager.Application.DTOs.Customers.CustomerSummaryDto>)customers)
                                {
                                    <option value="@c.Id" data-name="@c.Name (@c.CustomerCode)">@c.Name (@c.CustomerCode)</option>
                                }
                            }
                        </select>
                        <ul id="custDrop" class="dropdown-menu shadow w-100" style="max-height:260px;overflow:auto;display:none;"></ul>
                        <small id="custPicked" class="text-muted d-none"></small>
                    </div>
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Sale Date</label>
                    <input asp-for="Date" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-12">
                    <label class="form-label small fw-semibold">Notes</label>
                    <textarea asp-for="Notes" rows="2" class="form-control"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h6 class="mb-0 fw-bold">🐑 Livestock Selection</h6>
                <span class="small text-muted"><span id="lsCount">0</span> animal(s) added</span>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Find by ID / comment</label>
                        <div class="input-group">
                            <input id="lsSearch" type="text" class="form-control" placeholder="Start typing Livestock ID…" autocomplete="off" />
                            <button class="btn btn-outline-primary" type="button" id="lsManualResolve" title="Paste an exact livestock ID and press this button to add it directly to the sale (no search required)." aria-label="Add livestock by exact ID">Add Exact ID</button>
                        </div>
                        <ul id="lsDrop" class="dropdown-menu shadow w-100" style="max-height:280px;overflow:auto;display:none;margin-top:2px;"></ul>
                        <small id="lsMsg" class="text-muted d-block mt-1">Type to search 25 closest matches, or paste exact ID and click Add Exact ID to skip search.</small>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Bulk Add - Select eligible animals</label>
                        <div>
                            <button type="button" class="btn btn-outline-primary w-100" id="btnShowBulkModal">📋 Open Bulk Add Modal</button>
                            <span class="small text-muted ms-2">Select multiple eligible active / unsold livestock at once</span>
                        </div>
                        <div class="card border-0 bg-light mt-3 p-3">
                            <label class="form-label small fw-semibold mb-2">Or paste exact IDs (one per line)</label>
                            <textarea id="lsBulkPaste" class="form-control" rows="2" placeholder="e.g.&#10;AH-2026-00123&#10;SA-2026-04567"></textarea>
                            <button type="button" class="btn btn-outline-primary w-100 mt-2" id="lsAddBulk">+ Add Bulk Paste</button>
                        </div>
                    </div>
                </div>

                <div id="lsCart" class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Livestock ID</th>
                                <th>Type</th>
                                <th class="text-end">Cost</th>
                                <th class="text-end" style="width:160px;">
                                    Suggested Price Basis
                                    <div class="small text-muted fw-normal">auto-fills based on cost</div>
                                </th>
                                <th class="text-end" style="width:180px;">Unit Price (Editable)</th>
                                <th class="text-end" style="width:60px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="lsCartBody">
                            <tr id="lsEmpty">
                                <td colspan="6" class="text-center text-muted py-4 small">No livestock added yet. Use search above.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">💲 Suggested &amp; Final Prices</h6>
            </div>
            <div class="card-body">
                <div class="alert alert-light border mb-3" role="alert">
                    <small class="text-muted">Each animal is pre-filled with a suggested sale price based on the current pricing method. You can override any Unit Price above; overridden values are recorded as Manual Override.</small>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center py-2 px-3 border rounded">
                            <span class="text-muted small fw-semibold">Total Suggested</span>
                            <span class="fw-semibold" id="totSuggested">$0.00</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center py-2 px-3 border rounded bg-success bg-opacity-5">
                            <span class="text-muted small fw-semibold">Total Final Unit Prices</span>
                            <span class="fw-bold text-success" id="totFinal">$0.00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">🧾 Customer Charges (Invoice Totals)</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Discount % <span class="small text-muted">(0.00–1.00)</span></label>
                        <input name="discountPct" placeholder="0.15" step="0.0001" min="0" max="1" inputmode="decimal" id="saleDiscountPct" class="form-control" value="0" />
                        <span class="text-danger small field-validation-valid" data-valmsg-for="discountPct" data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Customer Tax % <span class="small text-muted">(0.00–1.00)</span></label>
                        <input id="saleTaxPct" name="taxPct" class="form-control" step="0.0001" min="0" max="1" inputmode="decimal" placeholder="0.15" value="0" />
                        <span class="text-danger small field-validation-valid" data-valmsg-for="taxPct" data-valmsg-replace="true"></span>
                    </div>
                </div>
                <small class="text-muted d-block mt-2">Discount and Tax apply per line item to the invoice paid by the customer. These are seller-side cost categories further below.</small>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">💸 Seller-Side Sale Costs (Reduce Net Proceeds)</h6>
            </div>
            <div class="card-body row g-3">
                <div class="col-md-6 col-12">
                    <label class="form-label small fw-semibold">Commission <span class="small text-muted">(USD)</span></label>
                    <input name="commissionAmount" id="commissionAmount" class="form-control text-end" step="0.01" min="0" inputmode="decimal" value="0.00" />
                </div>
                <div class="col-md-6 col-12">
                    <label class="form-label small fw-semibold">Seller-Paid Tax Amount <span class="small text-muted">(USD, NOT percentage)</span></label>
                    <input name="sellerTaxAmount" id="sellerTaxAmount" class="form-control text-end" step="0.01" min="0" inputmode="decimal" value="0.00" />
                </div>
                <div class="col-md-6 col-12">
                    <label class="form-label small fw-semibold">Transportation <span class="small text-muted">(USD)</span></label>
                    <input name="transportationAmount" id="transportationAmount" class="form-control text-end" step="0.01" min="0" inputmode="decimal" value="0.00" />
                </div>
                <div class="col-md-6 col-12">
                    <label class="form-label small fw-semibold">Other Cost <span class="small text-muted">(USD)</span></label>
                    <input name="otherCostAmount" id="otherCostAmount" class="form-control text-end" step="0.01" min="0" inputmode="decimal" value="0.00" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Other Cost Description <span id="otherCostRequiredStar" class="text-danger d-none">*</span> <span class="small text-muted">(Required when Other Cost &gt; 0; max 500 characters)</span></label>
                    <textarea name="otherCostDescription" id="otherCostDescription" class="form-control" rows="2" maxlength="500" placeholder="e.g. Loading/unloading charges, Animal inspection fee, Documentation charge"></textarea>
                    <small id="otherCostDescError" class="text-danger d-none mt-1">Other Cost Description is required when Other Cost is greater than 0.</small>
                    <small class="text-muted d-block mt-1">These seller costs are deducted from the gross revenue to calculate Net Sale Proceeds. Do not enter customer-charged tax here.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">🧮 Totals</h6>
            </div>
            <div class="card-body">
                <div class="mob-list-two-col" style="display:grid; grid-template-columns: 1fr 1fr; gap:0.5rem 1rem;">
                    <div><div class="k text-muted small fw-semibold">Gross Livestock Sale Revenue</div><div class="v text-end fw-semibold" id="totGross">$0.00</div></div>
                    <div><div class="k text-muted small fw-semibold">Customer Invoice Total (incl. tax)</div><div class="v text-end fw-semibold" id="totInvoice">$0.00</div></div>
                    <div><div class="k text-muted small fw-semibold">Seller Commission</div><div class="v text-end" id="totComm">$0.00</div></div>
                    <div><div class="k text-muted small fw-semibold">Seller-Paid Tax</div><div class="v text-end" id="totSellerTax">$0.00</div></div>
                    <div><div class="k text-muted small fw-semibold">Transportation</div><div class="v text-end" id="totTransport">$0.00</div></div>
                    <div><div class="k text-muted small fw-semibold">Other Seller Costs</div><div class="v text-end" id="totOther">$0.00</div></div>
                    <div style="grid-column: 1 / -1;"><hr class="my-1"/></div>
                    <div><div class="k text-muted small fw-semibold">Total Seller-Side Costs</div><div class="v text-end fw-semibold" id="totSaleCosts">$0.00</div></div>
                    <div><div class="k fw-bold fs-5 text-success">Net Sale Proceeds</div><div class="v text-end fw-bold fs-5 text-success" id="totNet">$0.00</div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent border-bottom d-none d-md-block">
                <h6 class="mb-0 fw-bold">📦 Additional Line Items</h6>
            </div>
            <div class="card-header bg-transparent border-bottom d-md-none">
                <h6 class="mb-0 fw-bold">📦 Additional Line Items</h6>
            </div>
            <div class="card-header bg-transparent border-0 d-flex justify-content-end">
                <button type="button" class="btn btn-sm btn-outline-primary" id="addLineBtn">+ Add Row</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle" id="linesTable">
                        <thead class="table-light">
                            <tr>
                                <th>Description</th>
                                <th style="width:120px;" class="text-end">Qty</th>
                                <th style="width:160px;" class="text-end">Unit Price</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="line-row">
                                <td><input type="text" name="lineDesc" class="form-control form-control-sm" placeholder="e.g. Delivery fee" /></td>
                                <td><input type="number" name="lineQty" value="1" step="0.01" class="form-control form-control-sm text-end line-qty" /></td>
                                <td><input type="number" name="linePrice" value="0" step="0.01" class="form-control form-control-sm text-end line-price" /></td>
                                <td><button type="button" class="btn btn-sm btn-outline-danger remove-line" tabindex="-1" aria-label="Remove this additional item line" title="Remove this additional item line">✕</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-5">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">✅ Review &amp; Confirm</h6>
            </div>
            <div class="card-body d-flex justify-content-end flex-wrap gap-2">
                <button type="button" onclick="history.back()" class="btn btn-outline-secondary me-2">Cancel</button>
                <button type="submit" class="btn btn-primary px-5">💾 Create Sale</button>
            </div>
        </div>
    </div>
</form>

<div class="modal fade" id="bulkAddModal" tabindex="-1" aria-labelledby="bulkAddModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">📋 Bulk Add Livestock</h5> <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-5"><input id="bulkKeyword" class="form-control" placeholder="Search by ID / type / farm…"/></div>
                    <div class="col-md-4"><select id="bulkFarm" class="form-select"><option value="">All farms</option></select></div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="button" id="bulkSearch" class="btn btn-primary w-100">Search</button>
                        <button type="button" id="bulkSelectAll" class="btn btn-outline-secondary w-100">Select Page</button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:52px;"><input type="checkbox" id="chkPageAll" class="form-check-input"/></th>
                                <th>Livestock ID</th>
                                <th>Type</th>
                                <th>Farm</th>
                                <th class="text-end">Weight</th>
                                <th class="text-end">Suggested</th>
                                <th class="text-end">Basis</th>
                            </tr>
                        </thead>
                        <tbody id="bulkTbody"><tr><td colspan="7" class="text-center text-muted py-4">Click Search to load eligible livestock.</td></tr></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="me-auto small text-muted" id="bulkCount">0 selected</div>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="bulkAddConfirm" class="btn btn-success" disabled>Add Selected to Sale</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const esc = s => (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
            const fmt = n => '$' + (Number(n) || 0).toFixed(2);
            const LS = { url: '@Url.Action("SearchLivestock")', resolve: '@Url.Action("ResolveLivestock")', bulkUrl: '@Url.Action("ListEligibleLivestockBulkAdd")' };
            const CU = { url: '@Url.Action("SearchCustomers")' };
            const __CSRFTOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            let lsCart = [];
            let farmFilter = null;

            const bulkSelected = new Set();
            let bulkPageItems = [];

            function showDrop(ul) { ul.style.display = 'block'; }
            function hideDrop(ul) { ul.style.display = 'none'; }

            function bindCombo({ input, select, drop, onPick, fetch, placeholderText, buildLabel }) {
                let selectedId = null;
                function render(list) {
                    drop.innerHTML = '';
                    if (!list.length) {
                        const li = document.createElement('li');
                        li.className = 'dropdown-item disabled text-muted small px-3 py-2';
                        li.textContent = placeholderText;
                        drop.appendChild(li);
                        showDrop(drop);
                        return;
                    }
                    list.forEach(it => {
                        const li = document.createElement('li');
                        const a = document.createElement('button');
                        a.type = 'button';
                        a.className = 'dropdown-item d-flex justify-content-between align-items-start';
                        a.innerHTML = `<span>${esc(buildLabel(it))}</span>${it.Sub ? `<small class="text-muted ms-2">${esc(it.Sub)}</small>` : ''}`;
                        a.addEventListener('click', () => {
                            selectedId = it.Id;
                            input.value = it.Text;
                            pickLabel.textContent = buildLabel(it);
                            pickLabel.classList.remove('d-none');
                            hideDrop(drop);
                            onPick(it);
                        });
                        li.appendChild(a);
                        drop.appendChild(li);
                    });
                    showDrop(drop);
                }
                const pickLabel = input.parentElement.parentElement.querySelector('small[id$="Picked"]');
                input.addEventListener('focus', async () => { if (fetch) render(await fetch('')); });
                document.addEventListener('click', e => { if (!input.parentElement.contains(e.target)) hideDrop(drop); });
                let t;
                input.addEventListener('input', () => {
                    clearTimeout(t);
                    const q = input.value.trim();
                    t = setTimeout(async () => { if (fetch) render(await fetch(q)); }, 220);
                });
            }

            bindCombo({
                input: document.getElementById('farmSearch'),
                select: document.getElementById('farmSelect'),
                drop: document.getElementById('farmDrop'),
                placeholderText: 'No farms',
                buildLabel: it => it.Text + (it.Sub ? ' — ' + it.Sub : ''),
                fetch: async (q) => {
                    return Array.from(document.querySelectorAll('#farmSelect option')).slice(1)
                        .map(o => ({ Id: o.value, Text: o.textContent, Sub: '' }))
                        .filter(x => !q || x.Text.toLowerCase().includes(q.toLowerCase()));
                },
                onPick: (it) => {
                    document.getElementById('farmSelect').value = it.Id;
                    farmFilter = it.Id ? it.Id : null;
                    if (document.getElementById('lsSearch').value.trim() !== '') {
                        const e = new Event('input');
                        document.getElementById('lsSearch').dispatchEvent(e);
                    }
                }
            });
            (function prefillFarmFromSelect() {
                const s = document.getElementById('farmSelect').value;
                if (s) {
                    const opt = document.querySelector('#farmSelect option[value="' + s + '"]');
                    if (opt) {
                        document.getElementById('farmSearch').value = opt.textContent;
                        document.getElementById('farmPicked').textContent = opt.textContent;
                        document.getElementById('farmPicked').classList.remove('d-none');
                        farmFilter = s;
                    }
                }
            })();

            bindCombo({
                input: document.getElementById('custSearch'),
                select: document.getElementById('custSelect'),
                drop: document.getElementById('custDrop'),
                placeholderText: 'No customers found',
                buildLabel: it => it.Text + (it.Sub ? ' — ' + it.Sub : ''),
                fetch: async (q) => {
                    const url = CU.url + (q ? '?keyword=' + encodeURIComponent(q) : '');
                    const r = await fetch(url);
                    const data = await r.json();
                    return data.map(c => ({
                        Id: c.id || c.Id,
                        Text: (c.name || c.Name) + ' (' + (c.customerCode || c.CustomerCode) + ')',
                        Sub: (c.email || c.Email) || (c.phone || c.Phone) || ''
                    }));
                },
                onPick: (it) => { document.getElementById('custSelect').value = it.Id; }
            });
            (function prefillCust() {
                const s = document.getElementById('custSelect').value;
                if (s) {
                    const opt = document.querySelector('#custSelect option[value="' + s + '"]');
                    if (opt) {
                        document.getElementById('custSearch').value = opt.textContent;
                        document.getElementById('custPicked').textContent = opt.textContent;
                        document.getElementById('custPicked').classList.remove('d-none');
                    }
                }
            })();

            async function livestockList(q) {
                let url = LS.url + '?keyword=' + encodeURIComponent(q || '');
                if (farmFilter) url += '&farmId=' + encodeURIComponent(farmFilter);
                const r = await fetch(url);
                const j = await r.json();
                return j.map(l => ({
                    Id: l.id || l.Id,
                    Text: l.livestockId || l.LivestockId,
                    Sub: (l.typeLabel || l.TypeLabel || '') + ' · Cost ' + fmt(l.purchaseAmount || l.PurchaseAmount || 0)
                }));
            }

            let lsSearchT;
            const lsSearch = document.getElementById('lsSearch');
            const lsDrop = document.getElementById('lsDrop');
            const lsMsg = document.getElementById('lsMsg');
            lsSearch.addEventListener('focus', async () => {
                const list = await livestockList(lsSearch.value);
                renderLsDrop(list, lsSearch.value);
            });
            document.addEventListener('click', e => { if (!lsSearch.parentElement.parentElement.contains(e.target)) hideDrop(lsDrop); });
            lsSearch.addEventListener('input', () => {
                clearTimeout(lsSearchT);
                const q = lsSearch.value;
                lsSearchT = setTimeout(async () => { renderLsDrop(await livestockList(q), q); }, 260);
            });
            function renderLsDrop(list, q) {
                lsDrop.innerHTML = '';
                if (!list.length) {
                    const li = document.createElement('li');
                    li.className = 'dropdown-item disabled text-muted small px-3 py-2';
                    li.textContent = q ? 'No active livestock matches "' + q + '". Try Manual Resolve (paste exact ID).' : 'Start typing a Livestock ID…';
                    lsDrop.appendChild(li);
                    showDrop(lsDrop); return;
                }
                list.forEach(it => {
                    if (lsCart.find(x => x.Id === it.Id)) return;
                    const li = document.createElement('li');
                    const a = document.createElement('button');
                    a.type = 'button';
                    a.className = 'dropdown-item d-flex justify-content-between align-items-center';
                    a.innerHTML = `<span><code>${esc(it.Text)}</code> <small class="text-muted ms-2">${esc(it.Sub)}</small></span><span class="text-success fw-semibold ms-2">+ Add</span>`;
                    a.addEventListener('click', async () => { await addLivestockById(it.Id); lsSearch.value = ''; hideDrop(lsDrop); });
                    li.appendChild(a);
                    lsDrop.appendChild(li);
                });
                if (!lsDrop.children.length) {
                    const li = document.createElement('li');
                    li.className = 'dropdown-item disabled text-muted small px-3 py-2';
                    li.textContent = 'All matching livestock already added.';
                    lsDrop.appendChild(li);
                }
                showDrop(lsDrop);
            }

            document.getElementById('lsManualResolve').addEventListener('click', async () => {
                const val = lsSearch.value.trim();
                if (!val) { lsMsg.textContent = 'Paste exact Livestock ID first.'; lsMsg.className = 'text-danger small d-block mt-1'; return; }
                const r = await fetch(LS.resolve + '?id=' + encodeURIComponent(val));
                const j = await r.json();
                if (!j.ok) { lsMsg.textContent = j.msg || 'Not found'; lsMsg.className = 'text-danger small d-block mt-1'; return; }
                lsMsg.textContent = 'Found, adding…'; lsMsg.className = 'text-success small d-block mt-1';
                await addLivestockById(j.item.id || j.item.Id);
                lsSearch.value = '';
            });

            document.getElementById('lsAddBulk').addEventListener('click', async () => {
                const ta = document.getElementById('lsBulkPaste');
                const lines = (ta.value || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);
                if (!lines.length) return;
                ta.value = '';
                let failed = 0, added = 0;
                for (const id of lines) {
                    const r = await fetch(LS.resolve + '?id=' + encodeURIComponent(id));
                    const j = await r.json();
                    if (!j.ok) { failed++; continue; }
                    const uid = j.item.id || j.item.Id;
                    if (lsCart.find(x => x.Id === uid)) continue;
                    await addLivestockById(uid);
                    added++;
                }
                lsMsg.textContent = `Bulk: added ${added}${failed ? ' · failed ' + failed : ''}`;
                lsMsg.className = (failed ? 'text-warning' : 'text-success') + ' small d-block mt-1';
            });

            async function addLivestockById(id) {
                if (lsCart.find(x => x.Id === id)) return;
                const url = LS.url + '?keyword=';
                const r = await fetch(url);
                const all = await r.json();
                let item = all.find(x => (x.id || x.Id) === id);
                if (!item) {
                    const dr3 = await fetch(LS.resolve + '?id=' + encodeURIComponent(id));
                    const dj3 = await dr3.json();
                    if (dj3 && dj3.ok) item = dj3.item;
                }
                if (!item) return;
                const suggestedPrice = item.suggestedPrice || item.SuggestedPrice;
                const suggestedWeight = item.suggestedWeight || item.SuggestedWeight;
                const suggestedRate = item.suggestedRate || item.SuggestedRate;
                const suggestedMethod = item.suggestedMethod || item.SuggestedMethod;
                const row = {
                    Id: item.id || item.Id,
                    LivestockId: item.livestockId || item.LivestockId,
                    Type: item.typeLabel || item.TypeLabel || item.livestockTypeId || item.LivestockTypeId,
                    Cost: item.purchaseAmount || item.PurchaseAmount || 0,
                    SuggestedPrice: suggestedPrice,
                    SuggestedWeight: suggestedWeight,
                    SuggestedRate: suggestedRate,
                    SuggestedMethod: suggestedMethod,
                    Price: suggestedPrice || Math.round(((item.purchaseAmount || item.PurchaseAmount || 0) * 1.3) * 100) / 100
                };
                lsCart.push(row);
                renderCart();
            }

            function getBasisText(method) {
                switch (method) {
                    case 'CostMarkupLegacy': return 'Cost × 1.30 legacy';
                    case 'WeightPerCwt': return 'Weight × Rate/cwt';
                    case 'WeightPerKg': return 'Weight × Rate/kg';
                    case 'HeadPrice': return 'Per-head fixed';
                    default: return method ? method : '';
                }
            }

            function renderCart() {
                const body = document.getElementById('lsCartBody');
                const empty = document.getElementById('lsEmpty');
                if (!lsCart.length) {
                    body.innerHTML = '';
                    if (empty) {
                        empty.classList.remove('d-none');
                        empty.innerHTML = '<td colspan="6" class="text-center text-muted py-4 small">No livestock added yet. Use search above.</td>';
                        body.appendChild(empty);
                    } else {
                        const tr = document.createElement('tr');
                        tr.id = 'lsEmpty';
                        tr.innerHTML = '<td colspan="6" class="text-center text-muted py-4 small">No livestock added yet. Use search above.</td>';
                        body.appendChild(tr);
                    }
                } else {
                    body.innerHTML = '';
                    lsCart.forEach((r, idx) => {
                        const tr = document.createElement('tr');
                        tr.dataset.id = r.Id;
                        let basisHtml = '<span class="text-muted small">—</span>';
                        if (r.SuggestedPrice != null && !isNaN(Number(r.SuggestedPrice))) {
                            basisHtml = `<div class="small"><div class="fw-semibold text-success">${fmt(r.SuggestedPrice)}</div><div class="text-muted">${esc(getBasisText(r.SuggestedMethod))}</div></div>`;
                        }
                        tr.innerHTML =
                            `<td><input type="hidden" name="livestockIds" value="${r.Id}" /><code>${esc(r.LivestockId)}</code></td>` +
                            `<td><span class="badge bg-light text-dark border">${esc(String(r.Type))}</span></td>` +
                            `<td class="text-end text-muted small">${fmt(r.Cost)}</td>` +
                            `<td class="text-end">${basisHtml}</td>` +
                            `<td><input type="number" name="livestockPrices" step="0.01" value="${r.Price.toFixed(2)}" class="form-control form-control-sm text-end ls-price" data-idx="${idx}" /></td>` +
                            `<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger ls-remove" data-idx="${idx}" title="Remove this livestock from the sale" aria-label="Remove livestock ${idx + 1} from sale">✕</button></td>`;
                        body.appendChild(tr);
                    });
                    document.querySelectorAll('#lsCartBody .ls-price').forEach(el => {
                        el.addEventListener('change', () => { lsCart[el.dataset.idx].Price = parseFloat(el.value || '0'); recalc(); });
                        el.addEventListener('input', () => { lsCart[el.dataset.idx].Price = parseFloat(el.value || '0'); recalc(); });
                    });
                    document.querySelectorAll('#lsCartBody .ls-remove').forEach(el => {
                        el.addEventListener('click', () => { lsCart.splice(parseInt(el.dataset.idx, 10), 1); renderCart(); });
                    });
                }
                document.getElementById('lsCount').textContent = lsCart.length;
                recalc();
            }

            function recalc() {
                let lsTotal = 0;
                let lsSuggestedTotal = 0;
                lsCart.forEach(r => {
                    lsTotal += Number(r.Price) || 0;
                    lsSuggestedTotal += (r.SuggestedPrice != null && !isNaN(Number(r.SuggestedPrice))) ? Number(r.SuggestedPrice) : 0;
                });
                var lnTotal = 0;
                document.querySelectorAll('.line-row').forEach(r => {
                    var q = parseFloat(r.querySelector('.line-qty')?.value || '0');
                    var p = parseFloat(r.querySelector('.line-price')?.value || '0');
                    lnTotal += q * p;
                });
                var sub = lsTotal + lnTotal;
                const discPct = parseFloat(document.getElementById('saleDiscountPct')?.value || '0') || 0;
                const taxPct = parseFloat(document.getElementById('saleTaxPct')?.value || '0') || 0;
                const discountAmt = sub * discPct;
                const afterDiscount = sub - discountAmt;
                const taxAmt = afterDiscount * taxPct;
                const invoiceTotal = afterDiscount + taxAmt;

                const commission = parseFloat(document.getElementById('commissionAmount')?.value || '0') || 0;
                const sellerTax = parseFloat(document.getElementById('sellerTaxAmount')?.value || '0') || 0;
                const transport = parseFloat(document.getElementById('transportationAmount')?.value || '0') || 0;
                const otherCost = parseFloat(document.getElementById('otherCostAmount')?.value || '0') || 0;
                const totalSellerCosts = commission + sellerTax + transport + otherCost;
                const netProceeds = invoiceTotal - totalSellerCosts;

                const totS = document.getElementById('totSuggested');
                const totF = document.getElementById('totFinal');
                if (totS) totS.textContent = fmt(lsSuggestedTotal);
                if (totF) totF.textContent = fmt(lsTotal);

                const lsSub = document.getElementById('lsSub');
                const lnSub = document.getElementById('lnSub');
                const subEl = document.getElementById('sub');
                const discEl = document.getElementById('disc');
                const taxEl = document.getElementById('tax');
                const grand = document.getElementById('grand');
                if (lsSub) lsSub.textContent = fmt(lsTotal);
                if (lnSub) lnSub.textContent = fmt(lnTotal);
                if (subEl) subEl.textContent = fmt(sub);
                if (discEl) discEl.textContent = fmt(discountAmt);
                if (taxEl) taxEl.textContent = fmt(taxAmt);
                if (grand) grand.textContent = fmt(invoiceTotal);

                const totG = document.getElementById('totGross');
                const totI = document.getElementById('totInvoice');
                const totC = document.getElementById('totComm');
                const totST = document.getElementById('totSellerTax');
                const totTr = document.getElementById('totTransport');
                const totO = document.getElementById('totOther');
                const totSC = document.getElementById('totSaleCosts');
                const totN = document.getElementById('totNet');
                if (totG) totG.textContent = fmt(lsTotal);
                if (totI) totI.textContent = fmt(invoiceTotal);
                if (totC) totC.textContent = fmt(commission);
                if (totST) totST.textContent = fmt(sellerTax);
                if (totTr) totTr.textContent = fmt(transport);
                if (totO) totO.textContent = fmt(otherCost);
                if (totSC) totSC.textContent = fmt(totalSellerCosts);
                if (totN) totN.textContent = fmt(netProceeds);

                const star = document.getElementById('otherCostRequiredStar');
                const descTa = document.getElementById('otherCostDescription');
                const descErr = document.getElementById('otherCostDescError');
                if (star && descTa) {
                    if (otherCost > 0) {
                        star.classList.remove('d-none');
                        if (descTa.value.trim() === '') {
                            descTa.classList.add('is-invalid');
                            if (descErr) descErr.classList.remove('d-none');
                        } else {
                            descTa.classList.remove('is-invalid');
                            if (descErr) descErr.classList.add('d-none');
                        }
                    } else {
                        star.classList.add('d-none');
                        descTa.classList.remove('is-invalid');
                        if (descErr) descErr.classList.add('d-none');
                    }
                }
            }

            ['commissionAmount','sellerTaxAmount','transportationAmount','otherCostAmount','saleDiscountPct','saleTaxPct'].forEach(id => {
                const el = document.getElementById(id);
                if (el) { el.addEventListener('change', recalc); el.addEventListener('input', recalc); }
            });
            const ocd = document.getElementById('otherCostDescription');
            if (ocd) { ocd.addEventListener('change', recalc); ocd.addEventListener('input', recalc); }

            document.getElementById('addLineBtn')?.addEventListener('click', function () {
                var tbody = document.querySelector('#linesTable tbody');
                var clone = tbody.querySelector('.line-row').cloneNode(true);
                clone.querySelectorAll('input').forEach(function (i) { i.value = i.name === 'lineQty' ? '1' : '0'; });
                clone.querySelector('.line-qty').addEventListener('change', recalc);
                clone.querySelector('.line-qty').addEventListener('input', recalc);
                clone.querySelector('.line-price').addEventListener('change', recalc);
                clone.querySelector('.line-price').addEventListener('input', recalc);
                clone.querySelector('.remove-line').addEventListener('click', function () { clone.remove(); recalc(); });
                tbody.appendChild(clone);
                recalc();
            });
            document.querySelectorAll('.remove-line').forEach(function (b) { b.addEventListener('click', function () { b.closest('.line-row').remove(); recalc(); }); });
            document.querySelectorAll('.line-qty, .line-price').forEach(function (el) { el.addEventListener('change', recalc); el.addEventListener('input', recalc); });

            document.getElementById('saleForm').addEventListener('submit', function (e) {
            });

            const btnShowBulk = document.getElementById('btnShowBulkModal');
            const bulkModal = document.getElementById('bulkAddModal');
            if (btnShowBulk && bulkModal && typeof bootstrap !== 'undefined') {
                const bsModal = new bootstrap.Modal(bulkModal);
                btnShowBulk.addEventListener('click', () => bsModal.show());

                (function initBulkFarm() {
                    const bf = document.getElementById('bulkFarm');
                    if (!bf) return;
                    Array.from(document.querySelectorAll('#farmSelect option')).slice(1).forEach(o => {
                        const opt = document.createElement('option');
                        opt.value = o.value;
                        opt.textContent = o.textContent;
                        bf.appendChild(opt);
                    });
                })();

                const bulkSearch = document.getElementById('bulkSearch');
                const bulkKeyword = document.getElementById('bulkKeyword');
                const bulkFarm = document.getElementById('bulkFarm');
                const bulkTbody = document.getElementById('bulkTbody');
                const bulkCount = document.getElementById('bulkCount');
                const bulkAddConfirm = document.getElementById('bulkAddConfirm');
                const chkPageAll = document.getElementById('chkPageAll');
                const bulkSelectAll = document.getElementById('bulkSelectAll');

                function updateBulkCount() {
                    bulkCount.textContent = bulkSelected.size + ' selected';
                    bulkAddConfirm.disabled = bulkSelected.size === 0;
                }

                async function runBulkSearch() {
                    let url = LS.bulkUrl + '?keyword=' + encodeURIComponent(bulkKeyword.value.trim() || '');
                    if (bulkFarm && bulkFarm.value) url += '&farmId=' + encodeURIComponent(bulkFarm.value);
                    let items = [];
                    try {
                        const r = await fetch(url);
                        if (r.ok) {
                            items = await r.json();
                        } else {
                            throw new Error('bulk endpoint not ready');
                        }
                    } catch (_) {
                        try {
                            const r2 = await fetch(LS.url + '?keyword=' + encodeURIComponent(bulkKeyword.value.trim() || '') + (bulkFarm && bulkFarm.value ? '&farmId=' + encodeURIComponent(bulkFarm.value) : ''));
                            items = await r2.json();
                        } catch (_2) { items = []; }
                    }
                    bulkPageItems = items.map(l => ({
                        Id: l.id || l.Id,
                        LivestockId: l.livestockId || l.LivestockId,
                        Type: l.typeLabel || l.TypeLabel || l.type || l.Type || '',
                        FarmName: l.farmName || l.FarmName || l.farm || l.Farm || '',
                        Weight: l.weight || l.Weight || 0,
                        SuggestedPrice: l.suggestedPrice || l.SuggestedPrice,
                        SuggestedMethod: l.suggestedMethod || l.SuggestedMethod
                    }));
                    renderBulkRows();
                }

                function renderBulkRows() {
                    bulkTbody.innerHTML = '';
                    if (!bulkPageItems.length) {
                        bulkTbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No eligible livestock found.</td></tr>';
                        if (chkPageAll) chkPageAll.checked = false;
                        return;
                    }
                    let pageAllChecked = true;
                    bulkPageItems.forEach(item => {
                        if (lsCart.find(x => x.Id === item.Id)) return;
                        const checked = bulkSelected.has(item.Id);
                        if (!checked) pageAllChecked = false;
                        const tr = document.createElement('tr');
                        let sp = '';
                        if (item.SuggestedPrice != null && !isNaN(Number(item.SuggestedPrice))) sp = fmt(item.SuggestedPrice);
                        tr.innerHTML =
                            `<td><input type="checkbox" class="form-check-input bulk-chk" data-id="${item.Id}" ${checked ? 'checked' : ''}/></td>` +
                            `<td><code>${esc(item.LivestockId)}</code></td>` +
                            `<td><span class="badge bg-light text-dark border">${esc(String(item.Type))}</span></td>` +
                            `<td>${esc(item.FarmName)}</td>` +
                            `<td class="text-end">${Number(item.Weight || 0).toFixed(2)}</td>` +
                            `<td class="text-end fw-semibold text-success">${sp || '—'}</td>` +
                            `<td class="text-end small text-muted">${esc(getBasisText(item.SuggestedMethod)) || '—'}</td>`;
                        bulkTbody.appendChild(tr);
                    });
                    if (!bulkTbody.children.length) {
                        bulkTbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">All results already added to sale.</td></tr>';
                    }
                    if (chkPageAll) chkPageAll.checked = pageAllChecked && bulkTbody.children.length > 0;
                    bulkTbody.querySelectorAll('.bulk-chk').forEach(cb => {
                        cb.addEventListener('change', () => {
                            const id = cb.dataset.id;
                            if (cb.checked) bulkSelected.add(id);
                            else bulkSelected.delete(id);
                            updateBulkCount();
                        });
                    });
                    updateBulkCount();
                }

                if (bulkSearch) bulkSearch.addEventListener('click', runBulkSearch);
                if (bulkKeyword) bulkKeyword.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); runBulkSearch(); } });
                if (chkPageAll) chkPageAll.addEventListener('change', () => {
                    bulkTbody.querySelectorAll('.bulk-chk').forEach(cb => {
                        cb.checked = chkPageAll.checked;
                        const id = cb.dataset.id;
                        if (chkPageAll.checked) bulkSelected.add(id);
                        else bulkSelected.delete(id);
                    });
                    updateBulkCount();
                });
                if (bulkSelectAll) bulkSelectAll.addEventListener('click', () => {
                    bulkTbody.querySelectorAll('.bulk-chk').forEach(cb => {
                        cb.checked = true;
                        bulkSelected.add(cb.dataset.id);
                    });
                    if (chkPageAll) chkPageAll.checked = true;
                    updateBulkCount();
                });
                if (bulkAddConfirm) bulkAddConfirm.addEventListener('click', async () => {
                    const ids = Array.from(bulkSelected);
                    let added = 0;
                    for (const id of ids) {
                        if (lsCart.find(x => x.Id === id)) { bulkSelected.delete(id); continue; }
                        await addLivestockById(id);
                        bulkSelected.delete(id);
                        added++;
                    }
                    updateBulkCount();
                    renderBulkRows();
                    bsModal.hide();
                });
            }

            renderCart();
        })();
    </script>
}
