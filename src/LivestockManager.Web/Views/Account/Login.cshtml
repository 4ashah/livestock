@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
    bool hasErrors = ViewContext.ModelState != null &&
                     ViewContext.ModelState.Any(x => x.Value != null && x.Value.Errors != null && x.Value.Errors.Count > 0);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=5" />
    <meta name="theme-color" content="#0F6B37" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <title>@ViewData["Title"] &mdash; AHK Livestock Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    </environment>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        * { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            margin: 0;
            font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
            color: #1f2a24;
            min-height: 100vh;
            min-width: 320px;
            max-width: 100%;
            -webkit-font-smoothing: antialiased;
            padding-top: env(safe-area-inset-top, 0px);
            padding-bottom: env(safe-area-inset-bottom, 0px);
            padding-left: env(safe-area-inset-left, 0px);
            padding-right: env(safe-area-inset-right, 0px);
            background:
                radial-gradient(1200px 700px at 100% -10%, rgba(205,171,123,0.22), transparent 55%),
                radial-gradient(900px 600px at -10% 110%, rgba(17,122,63,0.10), transparent 58%),
                linear-gradient(180deg, #fbf8f1 0%, #f6efe1 55%, #f1e7cf 100%);
            background-attachment: fixed;
        }

        .l-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(1.1rem, 5vw, 2.2rem) clamp(0.9rem, 4.5vw, 1.4rem);
        }

        .l-card {
            width: 100%;
            max-width: 448px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 22px;
            overflow: hidden;
            box-shadow:
                0 1px 2px rgba(46,35,12,0.04),
                0 22px 70px rgba(15,107,55,0.16),
                0 1px 0 rgba(255,255,255,0.9) inset;
            border: 1px solid rgba(234,226,208,0.9);
        }

        /* ===== GREEN CARD HEADER STRIPE (OPTION D) ===== */
        .card-head {
            position: relative;
            background: linear-gradient(135deg, #145a30 0%, #0F6B37 45%, #117a3f 100%);
            color: #fff;
            padding: clamp(1.5rem, 6vw, 2rem) clamp(1.3rem, 6vw, 2.1rem) clamp(1.6rem, 6.2vw, 2.2rem);
            overflow: hidden;
        }
        .card-head::after {
            content: "";
            position: absolute;
            right: -60px;
            top: -60px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,0.16), transparent 60%);
            pointer-events: none;
        }
        .card-head::before {
            content: "";
            position: absolute;
            left: -40px;
            bottom: -40px;
            width: 170px;
            height: 170px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,0.09), transparent 60%);
            pointer-events: none;
        }
        .card-head > * { position: relative; z-index: 1; }
        .brand { display: flex; align-items: center; gap: 0.75rem; }
        .brand .mark {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255,255,255,0.16);
            border: 1px solid rgba(255,255,255,0.24);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 18px;
            flex-shrink: 0;
            letter-spacing: 0.01em;
        }
        .brand .name { font-size: 14px; font-weight: 700; color: #fff; letter-spacing: -0.01em; }
        .brand .tagline { font-size: 12px; color: rgba(255,255,255,0.72); margin-top: 2px; }
        .card-head h2 {
            margin: clamp(1rem, 4.5vw, 1.4rem) 0 0.35rem;
            font-size: clamp(1.35rem, 5.3vw, 1.65rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            line-height: 1.2;
            color: #fff;
        }
        .card-head p {
            margin: 0;
            font-size: 0.88rem;
            color: rgba(255,255,255,0.84);
            line-height: 1.55;
        }

        /* ===== WHITE FORM BODY ===== */
        .card-body {
            padding: clamp(1.25rem, 5vw, 1.85rem) clamp(1.1rem, 5vw, 2.1rem) clamp(1.2rem, 5vw, 1.7rem);
        }

        .alert-login {
            background: linear-gradient(180deg, #fff5f5, #fdecec);
            border: 1px solid #f5c6c6;
            color: #842029;
            padding: 0.78rem 0.95rem;
            border-radius: 12px;
            font-size: 0.86rem;
            margin-bottom: 1.15rem;
            line-height: 1.5;
        }
        .alert-login strong { color: #711c23; }
        .alert-login ul { margin: 0.42rem 0 0 1.1rem; padding: 0; }
        .alert-login li { margin-bottom: 0.12rem; }

        /* STATIC LABELS ABOVE INPUTS (ZERO alignment bug) */
        .field { margin-bottom: 1.05rem; }
        .field > label.lbl {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #2a3830;
            margin: 0 0 0.45rem 0.1rem;
            letter-spacing: 0.005em;
        }
        .field .inp-wrap { position: relative; }
        .field .inp-wrap .ico {
            position: absolute;
            left: 0.98rem;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: #819189;
            pointer-events: none;
            transition: color 0.18s ease;
        }
        .field input {
            width: 100%;
            display: block;
            padding: 0 54px 0 46px;
            min-height: 54px;
            border: 1px solid #dce4df;
            border-radius: 12px;
            background: #fffdf8;
            color: #1f2a24;
            font-size: 0.97rem;
            font-family: inherit;
            transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
        }
        .field input:hover { border-color: #c9d6ce; background: #ffffff; }
        .field input:focus {
            outline: none;
            border-color: #0F6B37;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(15,107,55,0.10);
        }
        .field input:focus ~ .ico { color: #0F6B37; }
        .field input.input-validation-error,
        .field input.invalid {
            border-color: #e0a8a8;
            box-shadow: 0 0 0 3px rgba(220,53,69,0.08);
        }
        .field input.input-validation-error ~ .ico,
        .field input.invalid ~ .ico { color: #b02a37; }
        .field .toggle {
            position: absolute;
            right: 0.55rem;
            top: 50%;
            transform: translateY(-50%);
            width: 40px;
            height: 40px;
            border: 0;
            background: transparent;
            color: #63756a;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
        }
        .field .toggle:hover { background: #eef3ee; color: #0F6B37; }
        .field .toggle:active { background: #e2ece5; }
        .val {
            display: block;
            color: #b02a37;
            font-size: 0.78rem;
            margin: 0.3rem 0.15rem 0;
            line-height: 1.4;
        }

        .row-opts {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 0.15rem 0 1.3rem;
            gap: 0.8rem;
            flex-wrap: wrap;
        }
        .rmb {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #34403a;
            font-size: 0.85rem;
            font-weight: 500;
            user-select: none;
            cursor: pointer;
        }
        .rmb input {
            width: 17px;
            height: 17px;
            accent-color: #0F6B37;
            margin: 0;
            cursor: pointer;
        }
        .forgot {
            font-size: 0.84rem;
            font-weight: 600;
            color: #0F6B37;
            text-decoration: none;
            padding: 0.3rem 0.6rem;
            border-radius: 999px;
            transition: background 0.15s, color 0.15s;
        }
        .forgot:hover { background: #e9f2ec; color: #0a5a2e; text-decoration: none; }

        .btn-primary {
            position: relative;
            width: 100%;
            min-height: 56px;
            border: 0;
            border-radius: 12px;
            background: linear-gradient(180deg, #117a3f 0%, #0F6B37 50%, #0c5a2e 100%);
            color: #fff;
            font-size: 0.98rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            font-family: inherit;
            cursor: pointer;
            box-shadow:
                0 10px 24px rgba(15,107,55,0.24),
                inset 0 1px 0 rgba(255,255,255,0.16);
            transition: transform 0.12s ease, box-shadow 0.18s ease, filter 0.18s ease;
        }
        .btn-primary::before {
            content: "";
            position: absolute;
            left: 1px;
            right: 1px;
            top: 1px;
            height: 24px;
            border-radius: 12px 12px 0 0;
            background: linear-gradient(180deg, rgba(255,255,255,0.26), rgba(255,255,255,0));
            pointer-events: none;
        }
        .btn-primary:hover { filter: brightness(1.04); transform: translateY(-1px); box-shadow: 0 14px 30px rgba(15,107,55,0.28), inset 0 1px 0 rgba(255,255,255,0.16); }
        .btn-primary:active { transform: translateY(0); filter: brightness(0.98); }
        .btn-primary[data-loading="true"] { opacity: 0.82; pointer-events: none; }
        .btn-primary .arrow {
            display: inline-block;
            margin-left: 0.35rem;
            transition: transform 0.2s ease;
        }
        .btn-primary:hover .arrow { transform: translateX(3px); }

        .card-foot {
            text-align: center;
            color: #748378;
            font-size: 0.76rem;
            margin-top: 1.55rem;
            line-height: 1.6;
        }
        .card-foot a {
            color: #0F6B37;
            font-weight: 600;
            text-decoration: none;
        }
        .card-foot a:hover { color: #0b5a2e; text-decoration: underline; }
        .card-foot .sep {
            display: inline-block;
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: #c9d1ca;
            margin: 0 0.5rem;
            vertical-align: middle;
        }

        .sr-only-focusable:focus {
            position: static !important;
            width: auto !important;
            height: auto !important;
            margin: 0 !important;
            overflow: visible !important;
            clip: auto !important;
            white-space: normal !important;
        }

        @@media (max-width: 520px) {
            .l-wrap { padding: 0.9rem 0.85rem 1.5rem; }
            .l-card { border-radius: 20px; }
        }
    </style>
</head>
<body>
    <a class="sr-only-focusable visually-hidden-focusable" href="#loginForm" style="position:absolute;left:-9999px;">Skip to login form</a>
    <div class="l-wrap">
        <div class="l-card" role="main" aria-labelledby="loginTitle">
            <header class="card-head">
                <div class="brand">
                    <div class="mark" aria-hidden="true">LF</div>
                    <div>
                        <div class="name">AHK Livestock Manager</div>
                        <div class="tagline">Farm operations portal</div>
                    </div>
                </div>
                <h2 id="loginTitle">Welcome &mdash; Sign In</h2>
                <p>Use your credentials to open your company dashboard.</p>
            </header>

            <section class="card-body">
                <form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" id="loginForm" novalidate autocomplete="on">
                    @Html.AntiForgeryToken()

                    @if (hasErrors)
                    {
                        <div class="alert-login" role="alert">
                            <strong>Sign in failed.</strong> Please check your credentials and try again.
                            @if (ViewContext.ModelState != null)
                            {
                                var errors = ViewContext.ModelState
                                    .SelectMany(x => (x.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>()))
                                    .Where(e => !string.IsNullOrWhiteSpace(e.ErrorMessage))
                                    .Select(e => e.ErrorMessage)
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .ToList();
                                if (errors.Any())
                                {
                                    <ul>
                                        @foreach (var e in errors) { <li>@e</li> }
                                    </ul>
                                }
                            }
                        </div>
                    }

                    <div class="field">
                        <label class="lbl" asp-for="UserName" for="UserNameInput"></label>
                        <div class="inp-wrap">
                            <input asp-for="UserName"
                                   class="form-control"
                                   id="UserNameInput"
                                   autocomplete="username"
                                   autocapitalize="none"
                                   spellcheck="false"
                                   autocorrect="off"
                                   inputmode="email" />
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <span asp-validation-for="UserName" class="val"></span>
                    </div>

                    <div class="field">
                        <label class="lbl" asp-for="Password" for="PasswordInput"></label>
                        <div class="inp-wrap">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   id="PasswordInput"
                                   autocomplete="current-password" />
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <button type="button" class="toggle" id="pwdToggle" aria-label="Toggle password visibility" title="Show password">
                                <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="val"></span>
                    </div>

                    <div class="row-opts">
                        <label class="rmb">
                            <input asp-for="RememberMe" />
                            <span>Remember me</span>
                        </label>
                        <a class="forgot" asp-area="" asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-primary" id="submitBtn">
                        <span id="submitLabel">Sign In <span class="arrow">&rarr;</span></span>
                    </button>

                    <p class="card-foot">
                        &copy; @DateTime.Now.Year &mdash; AHK Livestock Manager
                        <br />
                        <a href="#">Privacy</a><span class="sep"></span><a href="#">Terms</a><span class="sep"></span><a href="#">Support</a>
                    </p>
                </form>
            </section>
        </div>
    </div>

    <script>
        (function () {
            var pwd = document.getElementById('PasswordInput');
            var btn = document.getElementById('pwdToggle');
            var eye = document.getElementById('eyeIcon');
            var showTpl = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path><circle cx="12" cy="12" r="3"></circle>';
            var hideTpl = '<path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a19.37 19.37 0 0 1 4.17-5.17"></path><path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a19.5 19.5 0 0 1-2.16 3.19"></path><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            if (pwd && btn && eye) {
                btn.addEventListener('click', function () {
                    if (pwd.type === 'password') {
                        pwd.type = 'text';
                        btn.setAttribute('title', 'Hide password');
                        eye.innerHTML = hideTpl;
                    } else {
                        pwd.type = 'password';
                        btn.setAttribute('title', 'Show password');
                        eye.innerHTML = showTpl;
                    }
                    try { pwd.focus({ preventScroll: true }); } catch (e) { /* ignore */ }
                });
            }
            var form = document.getElementById('loginForm');
            var submitBtn = document.getElementById('submitBtn');
            var submitLabel = document.getElementById('submitLabel');
            if (form && submitBtn && submitLabel) {
                form.addEventListener('submit', function () {
                    if (submitBtn.getAttribute('data-loading') === 'true') return;
                    submitBtn.setAttribute('data-loading', 'true');
                    submitLabel.textContent = 'Signing in\u2026';
                });
            }
            var userInput = document.getElementById('UserNameInput');
            if (userInput && !userInput.value) {
                window.setTimeout(function () {
                    try { userInput.focus({ preventScroll: true }); } catch (e) { /* ignore */ }
                }, 140);
            }
        })();
    </script>
</body>
</html>
