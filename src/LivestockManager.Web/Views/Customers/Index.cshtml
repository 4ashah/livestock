@using LivestockManager.Domain.Common
@using Microsoft.AspNetCore.Authorization
@model IEnumerable<LivestockManager.Application.DTOs.Customers.CustomerSummaryDto>
@inject IAuthorizationService Authorization
@{
    ViewData["Title"] = "Customers";
    var currentFilter = ViewData["CurrentFilter"] as string;
    var authed = User.Identity?.IsAuthenticated == true;

    var caps = new PageCapabilities
    {
        CanCreate = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Customers.Create)).Succeeded,
        CanEdit = authed && (await Authorization.AuthorizeAsync(User, PermissionNames.Customers.Edit)).Succeeded
    };
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">👥 Customers</h1>
        <div class="text-muted small">Manage your customer database</div>
    </div>
    @if (caps.CanCreate)
    {
        <a asp-action="Create" class="btn btn-primary"><span class="me-1">+</span> New Customer</a>
    }
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-8">
                <div class="input-group">
                <input type="text" name="searchString" class="form-control" placeholder="Search by Name, Code, Tax#, Email..." value="@currentFilter" />
                <button class="btn btn-outline-secondary" type="submit">🔍 Search</button>
                @if (!string.IsNullOrWhiteSpace(currentFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-danger">✕ Clear</a>
                }
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><code>@c.CustomerCode</code></td>
                            <td>
                                @c.Name
                                @if (c.IsBusiness) { <span class="badge bg-secondary ms-1">Business</span> }
                            </td>
                            <td>@c.Phone</td>
                            <td>@c.Email</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Archived</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                    @if (caps.CanEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted small">No customers found. @if (caps.CanCreate) { <text>Create your first customer.</text> }</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
