@model IEnumerable<LivestockManager.Application.DTOs.Customers.CustomerSummaryDto>
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Customers";
    ViewData["PageIcon"] = "👥";
    ViewData["PageSubtitle"] = "Manage your customer database";
    ViewData["DockKey"] = "customers";
    ViewData["ActionLabel"] = "New";
    ViewData["ActionIcon"] = "＋";
    ViewData["ActionUrl"] = Url.Action("Create", "Customers");
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
    var currentFilter = ViewData["CurrentFilter"] as string;
    var list = Model?.ToList() ?? new List<LivestockManager.Application.DTOs.Customers.CustomerSummaryDto>();
}

<div class="mob-card">
    <div class="mob-card-title">🔎 Search</div>
    <form method="get" asp-action="MobileIndex">
        <div class="mob-field">
            <input type="text" name="searchString" value="@currentFilter" placeholder="Name, code, tax#, email…" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="mob-btn primary" style="flex:1;justify-content:center;">🔍 Search</button>
            <a asp-action="MobileIndex" class="mob-btn" style="flex:1;justify-content:center;background:#f3f4f6;color:#374151;">✕ Clear</a>
        </div>
    </form>
</div>

<div class="mob-kpi-row">
    <div class="mob-kpi" style="--kpi-color:#2d6a4f;">
        <div class="k-label">Customers</div>
        <div class="k-value">@list.Count</div>
        <div class="k-caption">All records</div>
    </div>
    <div class="mob-kpi" style="--kpi-color:#00a896;">
        <div class="k-label">Active</div>
        <div class="k-value">@list.Count(x => x.IsActive)</div>
        <div class="k-caption">In good standing</div>
    </div>
</div>

<div class="mob-list-cards">
    @if (!list.Any())
    {
        <div class="mob-empty">No customers found. Tap ＋ New to add your first customer.</div>
    }
    else
    {
        @foreach (var c in list)
        {
            <div class="mob-list-card">
                <div class="row-top">
                    <div>
                        <code>@c.CustomerCode</code>
                        <div class="pill-stack">
                            @if (c.IsActive)
                            { <span class="pill ok">Active</span> }
                            else
                            { <span class="pill idle">Archived</span> }
                            @if (c.IsBusiness)
                            { <span class="pill info">Business</span> }
                        </div>
                    </div>
                </div>
                <div class="body-copy" style="font-weight:700;color:var(--ink-900);">@c.Name</div>
                <div class="rows">
                    <div class="cell">
                        <div class="label">Phone</div>
                        <div class="val">@(string.IsNullOrWhiteSpace(c.Phone) ? "—" : c.Phone)</div>
                    </div>
                    <div class="cell">
                        <div class="label">Email</div>
                        <div class="val">@(string.IsNullOrWhiteSpace(c.Email) ? "—" : c.Email)</div>
                    </div>
                </div>
                <div class="row-actions">
                    <a asp-action="Details" asp-route-id="@c.Id" class="mob-btn">👁 View</a>
                    @if (canEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@c.Id" class="mob-btn primary">✏️ Edit</a>
                    }
                </div>
            </div>
        }
    }
</div>
