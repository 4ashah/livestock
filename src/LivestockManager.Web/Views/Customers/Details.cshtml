@model LivestockManager.Application.DTOs.Customers.CustomerDetailDto
@{
    ViewData["Title"] = "Customer Details";
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 mb-1">
            @if (Model.IsActive)
            { <span class="badge bg-success me-2">Active</span> }
            else
            { <span class="badge bg-secondary me-2">Archived</span> }
            @Model.Name
        </h1>
        <div class="text-muted small">
            <code>@Model.CustomerCode</code> · Created @Model.CreatedAt.ToString("yyyy-MM-dd")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">← List</a>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">✏️ Edit</a>
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-warning" : "btn-outline-success")" onclick="return confirm('@(Model.IsActive ? "Archive this customer?" : "Reactivate this customer?")');">
                    @(Model.IsActive ? "📦 Archive" : "♻️ Reactivate")
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">📋 Customer Info</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small fw-semibold">Customer Code</dt>
                    <dd class="col-sm-8"><code>@Model.CustomerCode</code></dd>
                    <dt class="col-sm-4 text-muted small fw-semibold">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                    <dt class="col-sm-4 text-muted small fw-semibold">Tax Number</dt>
                    <dd class="col-sm-8">@Model.TaxNumber</dd>
                    <dt class="col-sm-4 text-muted small fw-semibold">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>
                    <dt class="col-sm-4 text-muted small fw-semibold">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4 text-muted small fw-semibold">Payment Terms</dt>
                    <dd class="col-sm-8">@Model.PaymentTermsDays days</dd>
                    <dt class="col-sm-4 text-muted small fw-semibold">Credit Limit</dt>
                    <dd class="col-sm-8">$@Model.CreditLimit?.ToString("F2")</dd>
                    <dt class="col-sm-4 text-muted small fw-semibold">Notes</dt>
                    <dd class="col-sm-8">@Model.Notes</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">📍 Billing Address</h6>
            </div>
            <div class="card-body">
                @if (Model.BillingAddress != null && (!string.IsNullOrWhiteSpace(Model.BillingAddress.Street1) || !string.IsNullOrWhiteSpace(Model.BillingAddress.City)))
                {
                    <address class="mb-0">
                        @Model.BillingAddress.Street1<br />
                        @if (!string.IsNullOrWhiteSpace(Model.BillingAddress.Street2))
                        { @Model.BillingAddress.Street2<br /> }
                        @Model.BillingAddress.City, @Model.BillingAddress.State @Model.BillingAddress.PostalCode<br />
                        @Model.BillingAddress.Country
                    </address>
                }
                else { <div class="text-muted small">No billing address provided.</div> }
            </div>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="mb-0 fw-bold">🚚 Delivery Address</h6>
            </div>
            <div class="card-body">
                @if (Model.DeliveryAddress != null && (!string.IsNullOrWhiteSpace(Model.DeliveryAddress.Street1) || !string.IsNullOrWhiteSpace(Model.DeliveryAddress.City)))
                {
                    <address class="mb-0">
                        @Model.DeliveryAddress.Street1<br />
                        @if (!string.IsNullOrWhiteSpace(Model.DeliveryAddress.Street2))
                        { @Model.DeliveryAddress.Street2<br /> }
                        @Model.DeliveryAddress.City, @Model.DeliveryAddress.State @Model.DeliveryAddress.PostalCode<br />
                        @Model.DeliveryAddress.Country
                    </address>
                }
                else { <div class="text-muted small">No delivery address provided.</div> }
            </div>
        </div>
    </div>
</div>
