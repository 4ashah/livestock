@{ ViewData["Title"] = "Company Settings"; }
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <h1 class="h2">🏢 Company</h1>
    <a asp-action="Create" class="btn btn-primary"><span class="me-1">+</span> New Company</a>
</div>
<div class="card shadow-sm border-0"><div class="card-body p-0">
    <div class="p-4 text-center text-muted"><div class="display-6 mb-2">🏢</div><div class="h5 mb-2">Company Profile Placeholder</div><div class="small">Company details: name, tax, addresses, currency, invoice/receipt prefixes, financial year.</div></div>
    <div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Reg #</th><th>Tax #</th><th>Currency</th><th>Invoice Prefix</th><th>Status</th><th></th></tr></thead><tbody><tr><td colspan="7" class="text-center py-4 text-muted small">Company profile placeholder row</td></tr></tbody></table></div>
</div></div>
