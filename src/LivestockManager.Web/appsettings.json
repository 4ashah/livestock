{
  "ConnectionStrings": {
    "LivestockManagerDb": "Server=.;Database=LivestockManager;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=15"
  },
  "SeedDemoData": "1",
  "EnableDevSeed": "true",
  "FileStorage": {
    "RootPath": "App_Data/files",
    "MaxUploadBytes": 26214400,
    "AllowedExtensions": ".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx,.csv"
  },
  "ProtectedStorage": {
    "Root": "./App_Data/ProtectedDocuments"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*"
}
